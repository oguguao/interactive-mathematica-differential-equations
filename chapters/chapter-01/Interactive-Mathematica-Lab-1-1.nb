         FullSimplify[$CellContext`lhs$ == $CellContext`rhs$]; Column[{
           Style[
           "Interactive Mathematica Lab 1.1: Is It a Solution?", 18, Bold], 
           Style["Differential equation: y'(x) = 2 x y(x)", 14], 
           Row[{"Proposed solution:   ", 
             
             TraditionalForm[$CellContext`y[$CellContext`x] == \
$CellContext`candidate$]}], 
           Row[{"Left side y'(x):   ", 
             TraditionalForm[$CellContext`lhs$]}], 
           Row[{"Right side 2xy:   ", 
             TraditionalForm[$CellContext`rhs$]}], 
           If[
            TrueQ[$CellContext`check$], 
            Style[
            "YES \[LongDash] the proposed function satisfies the differential \
equation.", 14, Bold], 
            Style[
            "NO \[LongDash] the proposed function does not satisfy the \
differential equation.", 14, Bold]], 
           
           Plot[$CellContext`candidate$, {$CellContext`x, -2, 2}, PlotRange -> 
