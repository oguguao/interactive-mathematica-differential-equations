Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"candidate", ",", "lhs", ",", "rhs", ",", "check"}], "}"}], ",", 
     RowBox[{
      RowBox[{"candidate", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{"choice", ",", "1", ",", 
         RowBox[{"Exp", "[", 
          RowBox[{"x", "^", "2"}], "]"}], ",", "2", ",", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"x", "^", "2"}], "]"}], "+", "1"}], ",", "3", ",", 
         RowBox[{"3", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"x", "^", "2"}], "]"}]}], ",", "4", ",", 
         RowBox[{"x", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lhs", "=", 
       RowBox[{"D", "[", 
        RowBox[{"candidate", ",", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rhs", "=", 
       RowBox[{"2", " ", "x", " ", "candidate"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"check", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"lhs", "==", "rhs"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 1.1: Is It a Solution?\>\"",
            ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Differential equation: y'(x) = 2 x y(x)\>\"", ",", 
           "14"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Proposed solution:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "x", "]"}], "==", "candidate"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Left side y'(x):   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "lhs", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Right side 2xy:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "rhs", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "check", "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<YES \[LongDash] the proposed function satisfies the \
differential equation.\>\"", ",", "14", ",", "Bold"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<NO \[LongDash] the proposed function does not \
satisfy the differential equation.\>\"", ",", "14", ",", "Bold"}], "]"}]}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{"candidate", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<Proposed Solution\>\""}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}], "}"}], 
       "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "choice", ",", "1", ",", "\"\<Choose a proposed solution:\>\""}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "->", "\"\<y = Exp[x^2]\>\""}], ",", 
       RowBox[{"2", "->", "\"\<y = Exp[x^2] + 1\>\""}], ",", 
       RowBox[{"3", "->", "\"\<y = 3 Exp[x^2]\>\""}], ",", 
       RowBox[{"4", "->", "\"\<y = x^2\>\""}]}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.99746884165497*^9, 3.99746884165497*^9}},
