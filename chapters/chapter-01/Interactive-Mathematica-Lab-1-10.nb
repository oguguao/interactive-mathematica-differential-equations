           "Infinitely Many Solutions"; $CellContext`explanation$ = 
           "One arbitrary constant remains free."; $CellContext`graphic$ = 
           Plot[
             Evaluate[
              
              Table[$CellContext`A 
               Sin[$CellContext`x], {$CellContext`A, {-2, -1, 1, 
