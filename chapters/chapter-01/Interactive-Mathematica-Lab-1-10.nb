Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"generalSolution", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"c1", " ", 
      RowBox[{"Cos", "[", "x", "]"}]}], "+", 
     RowBox[{"c2", " ", 
      RowBox[{"Sin", "[", "x", "]"}]}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "conditions", ",", "result", ",", "outcome", ",", "explanation", ",", 
       "graphic"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Switch", "[", 
       RowBox[{"case", ",", "\"\<Unique\>\"", ",", 
        RowBox[{
         RowBox[{"conditions", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"generalSolution", "[", "0", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"generalSolution", "[", 
              RowBox[{"Pi", "/", "2"}], "]"}], "==", "1"}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"result", "=", 
          RowBox[{"Reduce", "[", 
           RowBox[{"conditions", ",", 
            RowBox[{"{", 
             RowBox[{"c1", ",", "c2"}], "}"}], ",", "Reals"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"outcome", "=", "\"\<Exactly One Solution\>\""}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
         "explanation", 
          "=", "\"\<Both constants are uniquely determined.\>\""}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"graphic", "=", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"Sin", "[", "x", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", 
              RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
            RowBox[{"PlotLabel", "->", "\"\<Unique BVP Solution\>\""}], ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
               RowBox[{"Point", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Pi", "/", "2"}], ",", "1"}], "}"}]}], "}"}], 
                "]"}]}], "}"}]}]}], "]"}]}]}], ",", "\"\<Infinite\>\"", ",", 
        RowBox[{
         RowBox[{"conditions", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"generalSolution", "[", "0", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"generalSolution", "[", "Pi", "]"}], "==", "0"}]}], 
           "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"result", "=", 
          RowBox[{"Reduce", "[", 
           RowBox[{"conditions", ",", 
            RowBox[{"{", 
             RowBox[{"c1", ",", "c2"}], "}"}], ",", "Reals"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"outcome", "=", "\"\<Infinitely Many Solutions\>\""}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
         "explanation", "=", "\"\<One arbitrary constant remains free.\>\""}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"graphic", "=", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"Evaluate", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"A", " ", 
                RowBox[{"Sin", "[", "x", "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"A", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "2"}], ",", 
                   RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}]}], "}"}]}],
               "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
            RowBox[{
            "PlotLabel", 
             "->", "\"\<Several Members of the Infinite Solution \
Family\>\""}]}], "]"}]}]}], ",", "\"\<None\>\"", ",", 
        RowBox[{
         RowBox[{"conditions", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"generalSolution", "[", "0", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"generalSolution", "[", "Pi", "]"}], "==", "1"}]}], 
           "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"result", "=", 
          RowBox[{"Reduce", "[", 
           RowBox[{"conditions", ",", 
            RowBox[{"{", 
             RowBox[{"c1", ",", "c2"}], "}"}], ",", "Reals"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"outcome", "=", "\"\<No Solution\>\""}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
         "explanation", 
          "=", "\"\<The two boundary conditions are inconsistent with every \
member of the general solution.\>\""}], ";", "\[IndentingNewLine]", 
         RowBox[{"graphic", "=", 
          RowBox[{"Graphics", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Text", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                
                RowBox[{"\"\<No solution satisfies both boundary \
conditions.\>\"", ",", "16", ",", "Bold"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}]}], "]"}], "}"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
            RowBox[{"Axes", "->", "False"}]}], "]"}]}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 1.10: Boundary-Value \
Problem Explorer\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Differential equation:   \>\"", ",", "Bold"}], 
             "]"}], ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"y", "''"}], "[", "x", "]"}], "+", 
               RowBox[{"y", "[", "x", "]"}]}], "==", "0"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<General solution:   \>\"", ",", "Bold"}], "]"}], ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "x", "]"}], "==", 
              RowBox[{
               RowBox[{"c1", " ", 
                RowBox[{"Cos", "[", "x", "]"}]}], "+", 
               RowBox[{"c2", " ", 
                RowBox[{"Sin", "[", "x", "]"}]}]}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Boundary Conditions\>\"", ",", "14", ",", "Bold"}], 
          "]"}], ",", 
         RowBox[{"TraditionalForm", "[", "conditions", "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Conditions on the constants:   \>\"", ",", "Bold"}],
              "]"}], ",", 
            RowBox[{"TraditionalForm", "[", "result", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"outcome", ",", "16", ",", "Bold"}], "]"}], ",", 
         "explanation", ",", "graphic"}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "case", ",", "\"\<Unique\>\"", 
       ",", "\"\<Choose boundary conditions:\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Unique\>\"", "->", "\"\<One Solution\>\""}], ",", 
       RowBox[{"\"\<Infinite\>\"", "->", "\"\<Infinitely Many\>\""}], ",", 
       RowBox[{"\"\<None\>\"", "->", "\"\<No Solution\>\""}]}], "}"}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}]}], "]"}]}], "Input",
