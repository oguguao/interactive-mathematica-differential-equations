         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Switch[$CellContext`example$$, "ODE", 
        Module[{$CellContext`candidate, $CellContext`lhs, $CellContext`rhs, \
$CellContext`check}, $CellContext`candidate = 
          Exp[2 $CellContext`x]; $CellContext`lhs = 
          D[$CellContext`candidate, $CellContext`x]; $CellContext`rhs = 
          2 $CellContext`candidate; $CellContext`check = 
          FullSimplify[$CellContext`lhs == $CellContext`rhs]; Column[{
            Style["Interactive Mathematica Lab 1.2: ODE or PDE?", 18, Bold], 
            Style["Ordinary Differential Equation", 16, Bold], 
            Row[{"Equation:   ", 
              TraditionalForm[
              Derivative[1][$CellContext`v][$CellContext`x] == 
               2 $CellContext`v[$CellContext`x]]}], 
            Row[{"Candidate solution:   ", 
              
              TraditionalForm[$CellContext`v[$CellContext`x] == \
$CellContext`candidate]}], 
            Row[{"Independent variable:   x"}], 
            Row[{"Number of independent variables:   1"}], 
            Row[{"Derivative type:   Ordinary derivative"}], 
            Style["Classification: ODE", 14, Bold], 
            Row[{"Left side:   ", 
              TraditionalForm[$CellContext`lhs]}], 
            Row[{"Right side:   ", 
              TraditionalForm[$CellContext`rhs]}], 
            If[
             TrueQ[$CellContext`check], 
             Style[
             "YES \[LongDash] the proposed function satisfies the ODE.", 14, 
              Bold], 
             Style[
             "NO \[LongDash] the proposed function does not satisfy the ODE.",
               14, Bold]], 
            
            Plot[$CellContext`candidate, {$CellContext`x, -2, 2}, PlotRange -> 
             All, AxesLabel -> {"x", "v(x)"}, PlotLabel -> "ODE Solution"]}]],
         "PDE", 
        Module[{$CellContext`candidate, $CellContext`timeDerivative, \
$CellContext`spaceDerivative, $CellContext`check}, $CellContext`candidate = 
          Exp[-$CellContext`t] 
           Sin[$CellContext`x]; $CellContext`timeDerivative = 
          D[$CellContext`candidate, $CellContext`t]; \
$CellContext`spaceDerivative = 
          D[$CellContext`candidate, {$CellContext`x, 2}]; $CellContext`check = 
          FullSimplify[$CellContext`timeDerivative == \
$CellContext`spaceDerivative]; Column[{
            Style["Interactive Mathematica Lab 1.2: ODE or PDE?", 18, Bold], 
            Style["Partial Differential Equation", 16, Bold], 
            Row[{"Equation:   ", 
              TraditionalForm[D[
                 $CellContext`u[$CellContext`x, $CellContext`t], \
$CellContext`t] == D[
                 $CellContext`u[$CellContext`x, $CellContext`t], \
{$CellContext`x, 2}]]}], 
            Row[{"Candidate solution:   ", 
              
              TraditionalForm[$CellContext`u[$CellContext`x, $CellContext`t] == \
$CellContext`candidate]}], 
            Row[{"Independent variables:   x and t"}], 
            Row[{"Number of independent variables:   2"}], 
            Row[{"Derivative type:   Partial derivatives"}], 
            Style["Classification: PDE", 14, Bold], 
            Row[{"Time derivative:   ", 
              TraditionalForm[$CellContext`timeDerivative]}], 
            Row[{"Second space derivative:   ", 
              TraditionalForm[$CellContext`spaceDerivative]}], 
            If[
             TrueQ[$CellContext`check], 
             Style[
             "YES \[LongDash] the proposed function satisfies the PDE.", 14, 
              Bold], 
             Style[
             "NO \[LongDash] the proposed function does not satisfy the PDE.",
               14, Bold]], 
            
            Plot3D[$CellContext`candidate, {$CellContext`x, 0, 2 
