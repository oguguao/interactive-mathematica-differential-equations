Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Switch", "[", 
    RowBox[{"example", ",", "\"\<ODE\>\"", ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"candidate", ",", "lhs", ",", "rhs", ",", "check"}], "}"}], ",", 
       RowBox[{
        RowBox[{"candidate", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{"2", " ", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"lhs", "=", 
         RowBox[{"D", "[", 
          RowBox[{"candidate", ",", "x"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rhs", "=", 
         RowBox[{"2", " ", "candidate"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"check", "=", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{"lhs", "==", "rhs"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<Interactive Mathematica Lab 1.2: ODE or PDE?\>\"", ",",
              "18", ",", "Bold"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<Ordinary Differential Equation\>\"", ",", "16", ",", 
             "Bold"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Equation:   \>\"", ",", 
              RowBox[{"TraditionalForm", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"v", "'"}], "[", "x", "]"}], "==", 
                RowBox[{"2", " ", 
                 RowBox[{"v", "[", "x", "]"}]}]}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Candidate solution:   \>\"", ",", 
              RowBox[{"TraditionalForm", "[", 
               RowBox[{
                RowBox[{"v", "[", "x", "]"}], "==", "candidate"}], "]"}]}], 
             "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", "\"\<Independent variable:   x\>\"", "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{
            "{", "\"\<Number of independent variables:   1\>\"", "}"}], "]"}],
            ",", 
           RowBox[{"Row", "[", 
            RowBox[{
            "{", "\"\<Derivative type:   Ordinary derivative\>\"", "}"}], 
            "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Classification: ODE\>\"", ",", "14", ",", "Bold"}], 
            "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Left side:   \>\"", ",", 
              RowBox[{"TraditionalForm", "[", "lhs", "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Right side:   \>\"", ",", 
              RowBox[{"TraditionalForm", "[", "rhs", "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"TrueQ", "[", "check", "]"}], ",", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<YES \[LongDash] the proposed function satisfies \
the ODE.\>\"", ",", "14", ",", "Bold"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<NO \[LongDash] the proposed function does not \
satisfy the ODE.\>\"", ",", "14", ",", "Bold"}], "]"}]}], "]"}], ",", 
           RowBox[{"Plot", "[", 
            RowBox[{"candidate", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
             RowBox[{"PlotRange", "->", "All"}], ",", 
             RowBox[{"AxesLabel", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<x\>\"", ",", "\"\<v(x)\>\""}], "}"}]}], ",", 
             RowBox[{"PlotLabel", "->", "\"\<ODE Solution\>\""}]}], "]"}]}], 
          "}"}], "]"}]}]}], "]"}], ",", "\"\<PDE\>\"", ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "candidate", ",", "timeDerivative", ",", "spaceDerivative", ",", 
         "check"}], "}"}], ",", 
       RowBox[{
        RowBox[{"candidate", "=", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", "t"}], "]"}], " ", 
          RowBox[{"Sin", "[", "x", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"timeDerivative", "=", 
         RowBox[{"D", "[", 
          RowBox[{"candidate", ",", "t"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"spaceDerivative", "=", 
         RowBox[{"D", "[", 
          RowBox[{"candidate", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"check", "=", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{"timeDerivative", "==", "spaceDerivative"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<Interactive Mathematica Lab 1.2: ODE or PDE?\>\"", ",",
              "18", ",", "Bold"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<Partial Differential Equation\>\"", ",", "16", ",", 
             "Bold"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Equation:   \>\"", ",", 
              RowBox[{"TraditionalForm", "[", 
               RowBox[{
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"u", "[", 
                   RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"u", "[", 
                   RowBox[{"x", ",", "t"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "]"}]}], "}"}], 
            "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Candidate solution:   \>\"", ",", 
              RowBox[{"TraditionalForm", "[", 
               RowBox[{
                RowBox[{"u", "[", 
                 RowBox[{"x", ",", "t"}], "]"}], "==", "candidate"}], "]"}]}],
              "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", "\"\<Independent variables:   x and t\>\"", "}"}], 
            "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{
            "{", "\"\<Number of independent variables:   2\>\"", "}"}], "]"}],
            ",", 
           RowBox[{"Row", "[", 
            RowBox[{
            "{", "\"\<Derivative type:   Partial derivatives\>\"", "}"}], 
            "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Classification: PDE\>\"", ",", "14", ",", "Bold"}], 
            "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Time derivative:   \>\"", ",", 
              RowBox[{"TraditionalForm", "[", "timeDerivative", "]"}]}], 
             "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Second space derivative:   \>\"", ",", 
              RowBox[{"TraditionalForm", "[", "spaceDerivative", "]"}]}], 
             "}"}], "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"TrueQ", "[", "check", "]"}], ",", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<YES \[LongDash] the proposed function satisfies \
the PDE.\>\"", ",", "14", ",", "Bold"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<NO \[LongDash] the proposed function does not \
satisfy the PDE.\>\"", ",", "14", ",", "Bold"}], "]"}]}], "]"}], ",", 
           RowBox[{"Plot3D", "[", 
            RowBox[{"candidate", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "3"}], "}"}], ",", 
             RowBox[{"PlotRange", "->", "All"}], ",", 
             RowBox[{"AxesLabel", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<x\>\"", ",", "\"\<t\>\"", ",", "\"\<u(x,t)\>\""}],
                "}"}]}], ",", 
             RowBox[{"PlotLabel", "->", "\"\<PDE Solution Surface\>\""}], ",", 
             RowBox[{"Mesh", "->", "None"}]}], "]"}]}], "}"}], "]"}]}]}], 
      "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "example", ",", "\"\<ODE\>\"", 
       ",", "\"\<Choose an equation type:\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<ODE\>\"", ",", "\"\<PDE\>\""}], "}"}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}]}], "]"}]}], "Input",
