Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"examples", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "x", "]"}], "+", 
          RowBox[{"4", " ", 
           RowBox[{"y", "[", "x", "]"}]}]}], "==", "7"}], ",", "1", ",", "1", 
        ",", "\"\<The highest derivative is y'(x), and it occurs to the first \
power.\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "''"}], "[", "x", "]"}], "-", 
          RowBox[{"3", " ", 
           RowBox[{
            RowBox[{"y", "'"}], "[", "x", "]"}]}], "+", 
          RowBox[{"5", " ", 
           RowBox[{"y", "[", "x", "]"}]}]}], "==", "0"}], ",", "2", ",", "1", 
        ",", "\"\<The highest derivative is y''(x), and it occurs to the \
first power.\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"y", "''"}], "[", "x", "]"}], ")"}], "^", "3"}], "+", 
          RowBox[{"y", "[", "x", "]"}]}], "==", "x"}], ",", "2", ",", "3", 
        ",", "\"\<The highest derivative is y''(x), and it is raised to the \
third power.\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"y", "'''"}], "[", "x", "]"}], ")"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"y", "'"}], "[", "x", "]"}], ")"}], "^", "5"}]}], "==", 
         "x"}], ",", "3", ",", "2", 
        ",", "\"\<The third derivative is the highest derivative. Its \
exponent is 2.\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"y", "''''"}], "[", "x", "]"}], "-", 
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"y", "''"}], "[", "x", "]"}]}], "+", 
          RowBox[{"y", "[", "x", "]"}]}], "==", "x"}], ",", "4", ",", "1", 
        ",", "\"\<The fourth derivative is the highest derivative and occurs \
to the first power.\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"y", "''"}], "[", "x", "]"}], "]"}], "+", 
          RowBox[{"y", "[", "x", "]"}]}], "==", "0"}], ",", "2", 
        ",", "\"\<Not defined\>\"", 
        ",", "\"\<The second derivative occurs inside a sine function, so the \
equation is not polynomial in its derivatives.\>\""}], "}"}]}], "}"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Column", "[", 
