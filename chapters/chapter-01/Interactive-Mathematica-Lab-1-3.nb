         RowBox[{"Style", "[", 
          RowBox[{"\"\<Degree:   \>\"", ",", "Bold"}], "]"}], ",", 
         RowBox[{"examples", "[", 
          RowBox[{"[", 
           RowBox[{"choice", ",", "3"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Explanation\>\"", ",", "14", ",", "Bold"}], "]"}], ",", 
      RowBox[{"examples", "[", 
       RowBox[{"[", 
        RowBox[{"choice", ",", "4"}], "]"}], "]"}], ",", 
      RowBox[{"Spacer", "[", "10", "]"}], ",", 
      RowBox[{"If", "[", 
