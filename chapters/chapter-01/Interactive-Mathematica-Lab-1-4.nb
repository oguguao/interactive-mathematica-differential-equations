Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "op", ",", "residual", ",", "description", ",", "classification"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"Switch", "[", 
       RowBox[{"choice", ",", "1", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"op", "[", "z_", "]"}], ":=", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "^", "2"}], " ", 
            RowBox[{"D", "[", 
             RowBox[{"z", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "+", 
           RowBox[{"x", " ", 
            RowBox[{"D", "[", 
             RowBox[{"z", ",", "x"}], "]"}]}], "-", "z"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"description", "=", "\"\<L[y] = x^2 y'' + x y' - y\>\""}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"classification", "=", "\"\<Linear\>\""}]}], ",", "2", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"op", "[", "z_", "]"}], ":=", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"z", ",", "x"}], "]"}], "+", 
           RowBox[{"z", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"description", "=", "\"\<L[y] = y' + y^2\>\""}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"classification", "=", "\"\<Nonlinear\>\""}]}], ",", "3", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"op", "[", "z_", "]"}], ":=", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"z", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "+", 
           RowBox[{"Sin", "[", "z", "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"description", "=", "\"\<L[y] = y'' + Sin[y]\>\""}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"classification", "=", "\"\<Nonlinear\>\""}]}], ",", "4", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"op", "[", "z_", "]"}], ":=", 
          RowBox[{
           RowBox[{
            RowBox[{"Exp", "[", "x", "]"}], " ", 
            RowBox[{"D", "[", 
             RowBox[{"z", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"Cos", "[", "x", "]"}], " ", 
            RowBox[{"D", "[", 
             RowBox[{"z", ",", "x"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"x", "^", "2"}], " ", "z"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
         "description", "=", "\"\<L[y] = e^x y'' + cos(x)y' + x^2 y\>\""}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"classification", "=", "\"\<Linear\>\""}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"residual", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{"op", "[", 
           RowBox[{
            RowBox[{"a", " ", 
             RowBox[{"f", "[", "x", "]"}]}], "+", 
            RowBox[{"b", " ", 
             RowBox[{"g", "[", "x", "]"}]}]}], "]"}], "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"a", " ", 
             RowBox[{"op", "[", 
              RowBox[{"f", "[", "x", "]"}], "]"}]}], "+", 
            RowBox[{"b", " ", 
             RowBox[{"op", "[", 
              RowBox[{"g", "[", "x", "]"}], "]"}]}]}], ")"}]}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 1.4: Linearity Tester\>\"",
            ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Selected Operator\>\"", ",", "14", ",", "Bold"}], 
          "]"}], ",", "description", ",", 
         RowBox[{"Spacer", "[", "5", "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Superposition Test\>\"", ",", "14", ",", "Bold"}], 
          "]"}], ",", 
         RowBox[{"TraditionalForm", "[", 
          RowBox[{
           RowBox[{"L", "[", 
            RowBox[{
             RowBox[{"a", " ", 
              RowBox[{"f", "[", "x", "]"}]}], "+", 
             RowBox[{"b", " ", 
              RowBox[{"g", "[", "x", "]"}]}]}], "]"}], "==", 
           RowBox[{
            RowBox[{"a", " ", 
             RowBox[{"L", "[", 
              RowBox[{"f", "[", "x", "]"}], "]"}]}], "+", 
            RowBox[{"b", " ", 
             RowBox[{"L", "[", 
              RowBox[{"g", "[", "x", "]"}], "]"}]}]}]}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Residual:   \>\"", ",", "Bold"}], "]"}], ",", 
            RowBox[{"TraditionalForm", "[", "residual", "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"FullSimplify", "[", 
             RowBox[{"residual", "==", "0"}], "]"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<YES \[LongDash] the superposition property \
holds.\>\"", ",", "14", ",", "Bold"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<NO \[LongDash] the superposition property fails.\>\"",
              ",", "14", ",", "Bold"}], "]"}]}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Classification:   \>\"", ",", "Bold"}], "]"}], ",", 
            "classification"}], "}"}], "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"choice", ",", "1", ",", "\"\<Choose an operator:\>\""}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "->", "\"\<Linear: variable coefficients\>\""}], ",", 
       RowBox[{"2", "->", "\"\<Nonlinear: y^2\>\""}], ",", 
       RowBox[{"3", "->", "\"\<Nonlinear: Sin[y]\>\""}], ",", 
       RowBox[{"4", "->", "\"\<Linear: complicated coefficients\>\""}]}], 
      "}"}], ",", 
     RowBox[{"ControlType", "->", "PopupMenu"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "2", ",", "\"\<a\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", "1", ",", "\"\<b\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9974695207903595`*^9, 3.9974695207903595`*^9}},
