     1, StandardForm, 
      "Variables" :> {$CellContext`a$$ = 2, $CellContext`b$$ = 
        1, $CellContext`choice$$ = 1}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`op$, $CellContext`residual$, \
$CellContext`description$, $CellContext`classification$}, 
        Switch[$CellContext`choice$$, 1, $CellContext`op$[
             Pattern[$CellContext`z, 
              Blank[]]] := $CellContext`x^2 
             D[$CellContext`z, {$CellContext`x, 2}] + $CellContext`x 
             D[$CellContext`z, $CellContext`x] - $CellContext`z; \
$CellContext`description$ = 
           "L[y] = x^2 y'' + x y' - y"; $CellContext`classification$ = 
           "Linear", 2, $CellContext`op$[
             Pattern[$CellContext`z, 
              Blank[]]] := 
           D[$CellContext`z, $CellContext`x] + $CellContext`z^2; \
$CellContext`description$ = "L[y] = y' + y^2"; $CellContext`classification$ = 
           "Nonlinear", 3, $CellContext`op$[
             Pattern[$CellContext`z, 
              Blank[]]] := 
           D[$CellContext`z, {$CellContext`x, 2}] + 
            Sin[$CellContext`z]; $CellContext`description$ = 
           "L[y] = y'' + Sin[y]"; $CellContext`classification$ = "Nonlinear", 
          4, $CellContext`op$[
             Pattern[$CellContext`z, 
              Blank[]]] := 
           Exp[$CellContext`x] D[$CellContext`z, {$CellContext`x, 2}] + 
            Cos[$CellContext`x] 
             D[$CellContext`z, $CellContext`x] + $CellContext`x^2 \
$CellContext`z; $CellContext`description$ = 
           "L[y] = e^x y'' + cos(x)y' + x^2 y"; $CellContext`classification$ = 
           "Linear"]; $CellContext`residual$ = FullSimplify[
           
           Expand[$CellContext`op$[$CellContext`a$$ \
$CellContext`f[$CellContext`x] + $CellContext`b$$ \
