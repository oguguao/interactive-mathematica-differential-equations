           TraditionalForm[$CellContext`L[$CellContext`a$$ \
$CellContext`f[$CellContext`x] + $CellContext`b$$ \
$CellContext`g[$CellContext`x]] == $CellContext`a$$ $CellContext`L[
                $CellContext`f[$CellContext`x]] + $CellContext`b$$ \
$CellContext`L[
                $CellContext`g[$CellContext`x]]], 
           Row[{
             Style["Residual:   ", Bold], 
             TraditionalForm[$CellContext`residual$]}], 
           If[
            TrueQ[
             FullSimplify[$CellContext`residual$ == 0]], 
            Style[
            "YES \[LongDash] the superposition property holds.", 14, Bold], 
