    574.9013671875, {174.04057504445234`, 179.77250863820234`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`A$$ = 0, $CellContext`v0$$ = 
        0, $CellContext`y0$$ = 1}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`equation$, $CellContext`classification$, \
$CellContext`solution$, $CellContext`forcing$, $CellContext`verification$}, \
$CellContext`forcing$ = $CellContext`A$$ 
          Exp[3 $CellContext`x]; $CellContext`equation$ = 
         Derivative[2][$CellContext`y][$CellContext`x] - 3 
           Derivative[1][$CellContext`y][$CellContext`x] + 
           2 $CellContext`y[$CellContext`x] == $CellContext`forcing$; \
$CellContext`classification$ = 
         If[$CellContext`A$$ == 0, "Homogeneous Linear Equation", 
           "Nonhomogeneous Linear Equation"]; $CellContext`solution$ = 
         DSolveValue[{$CellContext`equation$, $CellContext`y[
             0] == $CellContext`y0$$, 
            Derivative[1][$CellContext`y][0] == $CellContext`v0$$}, 
           $CellContext`y[$CellContext`x], $CellContext`x]; \
$CellContext`verification$ = 
         FullSimplify[
          D[$CellContext`solution$, {$CellContext`x, 2}] - 3 
            D[$CellContext`solution$, $CellContext`x] + 
            2 $CellContext`solution$ == $CellContext`forcing$]; Column[{
           Style[
           "Interactive Mathematica Lab 1.5: Forcing-Function Explorer", 18, 
            Bold], 
           Style["Differential Equation", 14, Bold], 
           TraditionalForm[$CellContext`equation$], 
           Row[{
             Style["Forcing amplitude A:   ", Bold], $CellContext`A$$}], 
           Row[{
             Style["Forcing function:   ", Bold], 
             TraditionalForm[$CellContext`forcing$]}], 
           Style[$CellContext`classification$, 14, Bold], 
           Spacer[8], 
           Style["Initial Conditions", 14, Bold], 
           Row[{
             TraditionalForm[$CellContext`y[0] == $CellContext`y0$$], "     ", 
             TraditionalForm[
             Derivative[1][$CellContext`y][0] == $CellContext`v0$$]}], 
           Spacer[8], 
           Style["Solution", 14, Bold], 
           
           TraditionalForm[$CellContext`y[$CellContext`x] == \
$CellContext`solution$], 
           Row[{
             Style["Verification:   ", Bold], $CellContext`verification$}], 
           
           Plot[$CellContext`solution$, {$CellContext`x, 0, 2}, PlotRange -> 
            All, AxesLabel -> {"x", "y"}, PlotLabel -> 
            If[$CellContext`A$$ == 0, "Homogeneous Response", 
              "Response With External Forcing"], GridLines -> Automatic]}]], 
      "Specifications" :> {{{$CellContext`A$$, 0, "Forcing amplitude A"}, 0, 
         3, 1}, {{$CellContext`y0$$, 1, "Initial value y(0)"}, -2, 2, 
