Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "equation", ",", "classification", ",", "solution", ",", "forcing", ",",
        "verification"}], "}"}], ",", 
     RowBox[{
      RowBox[{"forcing", "=", 
       RowBox[{"A", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"3", " ", "x"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"equation", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "''"}], "[", "x", "]"}], "-", 
         RowBox[{"3", " ", 
          RowBox[{
           RowBox[{"y", "'"}], "[", "x", "]"}]}], "+", 
         RowBox[{"2", " ", 
          RowBox[{"y", "[", "x", "]"}]}]}], "==", "forcing"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"classification", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"A", "==", "0"}], ",", "\"\<Homogeneous Linear Equation\>\"",
          ",", "\"\<Nonhomogeneous Linear Equation\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solution", "=", 
       RowBox[{"DSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"equation", ",", 
           RowBox[{
            RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "0", "]"}], "==", "v0"}]}], "}"}], ",", 
         RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"solution", ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "-", 
          RowBox[{"3", " ", 
           RowBox[{"D", "[", 
            RowBox[{"solution", ",", "x"}], "]"}]}], "+", 
          RowBox[{"2", " ", "solution"}]}], "==", "forcing"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 1.5: Forcing-Function \
Explorer\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Differential Equation\>\"", ",", "14", ",", "Bold"}], 
          "]"}], ",", 
         RowBox[{"TraditionalForm", "[", "equation", "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Forcing amplitude A:   \>\"", ",", "Bold"}], "]"}], 
            ",", "A"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Forcing function:   \>\"", ",", "Bold"}], "]"}], ",", 
            RowBox[{"TraditionalForm", "[", "forcing", "]"}]}], "}"}], "]"}], 
         ",", 
         RowBox[{"Style", "[", 
          RowBox[{"classification", ",", "14", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Spacer", "[", "8", "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Initial Conditions\>\"", ",", "14", ",", "Bold"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "0", "]"}], "==", "y0"}], "]"}], 
            ",", "\"\<     \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"y", "'"}], "[", "0", "]"}], "==", "v0"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Spacer", "[", "8", "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Solution\>\"", ",", "14", ",", "Bold"}], "]"}], ",", 
         RowBox[{"TraditionalForm", "[", 
          RowBox[{
           RowBox[{"y", "[", "x", "]"}], "==", "solution"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Verification:   \>\"", ",", "Bold"}], "]"}], ",", 
            "verification"}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{"solution", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"A", "==", "0"}], ",", "\"\<Homogeneous Response\>\"", 
              ",", "\"\<Response With External Forcing\>\""}], "]"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}], "}"}], 
       "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"A", ",", "0", ",", "\"\<Forcing amplitude A\>\""}], "}"}], ",",
      "0", ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y0", ",", "1", ",", "\"\<Initial value y(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v0", ",", "0", ",", "\"\<Initial slope y'(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "1"}], "}"}]}], "]"}]}], "Input",
