              RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
            RowBox[{
            "PlotLabel", "->", "\"\<Nonautonomous Direction Field\>\""}]}], 
           "]"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
