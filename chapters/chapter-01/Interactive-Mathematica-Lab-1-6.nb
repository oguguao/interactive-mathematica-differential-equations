                  RowBox[{"\"\<Equilibrium values:   \>\"", ",", "Bold"}], 
                  "]"}], ",", 
                 RowBox[{"TraditionalForm", "[", "equilibria", "]"}]}], "}"}],
                "]"}]}], "}"}], "]"}], ",", "Nothing"}], "]"}], ",", 
         "field"}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "type", ",", "\"\<Autonomous\>\"", ",", "\"\<Equation type:\>\""}], 
