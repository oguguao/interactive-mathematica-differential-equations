Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "field", ",", "equation", ",", "description", ",", "equilibria"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"type", "==", "\"\<Autonomous\>\""}], ",", 
        RowBox[{
         RowBox[{"equation", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
           RowBox[{
            RowBox[{"y", "[", "x", "]"}], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{"y", "[", "x", "]"}], "/", "K"}]}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
         "description", 
          "=", "\"\<The slope depends only on y. The independent variable x \
does not appear explicitly.\>\""}], ";", "\[IndentingNewLine]", 
         RowBox[{"equilibria", "=", 
          RowBox[{"{", 
           RowBox[{"0", ",", "K"}], "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"field", "=", 
          RowBox[{"StreamPlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"y", " ", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"y", "/", "K"}]}], ")"}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "8"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", 
              RowBox[{"-", "2"}], ",", 
              RowBox[{"K", "+", "4"}]}], "}"}], ",", 
            RowBox[{"StreamPoints", "->", "Fine"}], ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
            RowBox[{"PlotLabel", "->", "\"\<Autonomous Direction Field\>\""}],
             ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Dashed", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"8", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "K"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"8", ",", "K"}], "}"}]}], "}"}], "]"}]}], 
              "}"}]}]}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"equation", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
           RowBox[{
            RowBox[{"y", "[", "x", "]"}], " ", 
            RowBox[{"Cos", "[", "x", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "description", 
          "=", "\"\<The slope depends explicitly on x, so the equation is \
nonautonomous.\>\""}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "equilibria", 
          "=", "\"\<Not determined by a single autonomous function \
f(y)\>\""}], ";", "\[IndentingNewLine]", 
         RowBox[{"field", "=", 
          RowBox[{"StreamPlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"y", " ", 
               RowBox[{"Cos", "[", "x", "]"}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "8"}], "}"}], ",", 
