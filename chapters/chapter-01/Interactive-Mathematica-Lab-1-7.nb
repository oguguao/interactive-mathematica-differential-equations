Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "relation", ",", "branches", ",", "derivativeRule", ",", "implicitPlot",
        ",", "explicitPlot"}], "}"}], ",", 
     RowBox[{
      RowBox[{"relation", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], "==", "c"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"branches", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{"relation", ",", "y", ",", "Reals"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"derivativeRule", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "^", "2"}], "+", 
             RowBox[{
              RowBox[{"y", "[", "x", "]"}], "^", "2"}]}], "==", "c"}], ",", 
           "x"}], "]"}], ",", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "x", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"implicitPlot", "=", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", "^", "2"}], "+", 
           RowBox[{"y", "^", "2"}]}], "==", "c"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "c", "]"}]}], "-", "1"}], ",", 
           RowBox[{
            RowBox[{"Sqrt", "[", "c", "]"}], "+", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "c", "]"}]}], "-", "1"}], ",", 
           RowBox[{
            RowBox[{"Sqrt", "[", "c", "]"}], "+", "1"}]}], "}"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Implicit Solution\>\""}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"explicitPlot", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"c", "-", 
             RowBox[{"x", "^", "2"}]}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"c", "-", 
              RowBox[{"x", "^", "2"}]}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", 
            RowBox[{"Sqrt", "[", "c", "]"}]}], ",", 
           RowBox[{"Sqrt", "[", "c", "]"}]}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Two Explicit Branches\>\""}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 1.7: Explicit and Implicit \
Solutions\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Implicit relation:   \>\"", ",", "Bold"}], "]"}], ",", 
            RowBox[{"TraditionalForm", "[", "relation", "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Explicit branches:   \>\"", ",", "Bold"}], "]"}], ",", 
            RowBox[{"TraditionalForm", "[", "branches", "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Implicit derivative:   \>\"", ",", "Bold"}], "]"}], 
            ",", 
            RowBox[{"TraditionalForm", "[", "derivativeRule", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Real domain of the branches:   \>\"", ",", "Bold"}],
              "]"}], ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Sqrt", "[", "c", "]"}]}], "<=", "x", "<=", 
              RowBox[{"Sqrt", "[", "c", "]"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"GraphicsRow", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"implicitPlot", ",", "explicitPlot"}], "}"}], ",", 
           RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "}"}], "]"}]}]}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", "4", ",", "\"\<Constant c\>\""}], "}"}], ",", "1", ",",
      "16", ",", "1"}], "}"}]}], "]"}]}], "Input",
