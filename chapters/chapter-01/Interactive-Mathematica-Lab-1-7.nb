    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`c$$ = 4}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`relation$, $CellContext`branches$, \
$CellContext`derivativeRule$, $CellContext`implicitPlot$, \
$CellContext`explicitPlot$}, $CellContext`relation$ = $CellContext`x^2 + \
$CellContext`y^2 == $CellContext`c$$; $CellContext`branches$ = 
         Solve[$CellContext`relation$, $CellContext`y, 
           Reals]; $CellContext`derivativeRule$ = Solve[
           
           D[$CellContext`x^2 + $CellContext`y[$CellContext`x]^2 == \
$CellContext`c$$, $CellContext`x], 
           Derivative[
           1][$CellContext`y][$CellContext`x]]; $CellContext`implicitPlot$ = 
         ContourPlot[$CellContext`x^2 + $CellContext`y^2 == $CellContext`c$$, \
{$CellContext`x, -Sqrt[$CellContext`c$$] - 1, Sqrt[$CellContext`c$$] + 
            1}, {$CellContext`y, -Sqrt[$CellContext`c$$] - 1, 
            Sqrt[$CellContext`c$$] + 1}, FrameLabel -> {"x", "y"}, PlotLabel -> 
           "Implicit Solution"]; $CellContext`explicitPlot$ = Plot[{
            Sqrt[$CellContext`c$$ - $CellContext`x^2], -
            Sqrt[$CellContext`c$$ - $CellContext`x^2]}, {$CellContext`x, -
            Sqrt[$CellContext`c$$], 
            Sqrt[$CellContext`c$$]}, PlotRange -> All, 
           AxesLabel -> {"x", "y"}, PlotLabel -> "Two Explicit Branches"]; 
        Column[{
           Style[
           "Interactive Mathematica Lab 1.7: Explicit and Implicit Solutions",
             18, Bold], 
           Row[{
             Style["Implicit relation:   ", Bold], 
             TraditionalForm[$CellContext`relation$]}], 
           Row[{
             Style["Explicit branches:   ", Bold], 
             TraditionalForm[$CellContext`branches$]}], 
           Row[{
             Style["Implicit derivative:   ", Bold], 
             TraditionalForm[$CellContext`derivativeRule$]}], 
           Row[{
             Style["Real domain of the branches:   ", Bold], 
             
             TraditionalForm[-Sqrt[$CellContext`c$$] <= $CellContext`x <= 
              Sqrt[$CellContext`c$$]]}], 
           
           GraphicsRow[{$CellContext`implicitPlot$, \
$CellContext`explicitPlot$}, ImageSize -> Large]}]], 
      "Specifications" :> {{{$CellContext`c$$, 4, "Constant c"}, 1, 16, 1}}, 
