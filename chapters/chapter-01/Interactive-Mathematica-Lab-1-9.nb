Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<Unique IVP\>\"", "->", 
     RowBox[{"Manipulate", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "solution", ",", "verification", ",", "field", ",", "curve"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"solution", "=", 
           RowBox[{"DSolveValue", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
                RowBox[{"x", "+", 
                 RowBox[{"y", "[", "x", "]"}]}]}], ",", 
               RowBox[{
                RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], ",", 
             RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"verification", "=", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"D", "[", 
                RowBox[{"solution", ",", "x"}], "]"}], "==", 
               RowBox[{"x", "+", "solution"}]}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"solution", "/.", " ", 
                 RowBox[{"x", "->", "0"}]}], ")"}], "==", "y0"}]}], "}"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"field", "=", 
           RowBox[{"StreamPlot", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"x", "+", "y"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", 
               RowBox[{"-", "4"}], ",", "8"}], "}"}], ",", 
             RowBox[{"StreamPoints", "->", "Fine"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"curve", "=", 
           RowBox[{"Plot", "[", 
            RowBox[{"solution", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<Unique Initial-Value Problem\>\"", ",", "18", ",", 
               "Bold"}], "]"}], ",", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
                 RowBox[{"x", "+", 
                  RowBox[{"y", "[", "x", "]"}]}]}], ",", 
                RowBox[{
                 RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Solution:   \>\"", ",", "Bold"}], "]"}], ",", 
                RowBox[{"TraditionalForm", "[", 
                 RowBox[{
                  RowBox[{"y", "[", "x", "]"}], "==", "solution"}], "]"}]}], 
               "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Verification:   \>\"", ",", "Bold"}], "]"}], ",",
                 "verification"}], "}"}], "]"}], ",", 
             RowBox[{"Show", "[", 
              RowBox[{"field", ",", "curve", ",", 
               RowBox[{"AxesLabel", "->", 
                RowBox[{"{", 
                 RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
               RowBox[{
               "PlotLabel", 
                "->", "\"\<One Solution Curve Through the Initial \
Point\>\""}]}], "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"y0", ",", "1", ",", "\"\<Initial value y(0)\>\""}], "}"}], 
         ",", 
         RowBox[{"-", "2"}], ",", "3", ",", "1"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"\"\<Nonunique IVP\>\"", "->", 
     RowBox[{"Manipulate", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "delayedSolution", "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"delayedSolution", "[", "x_", "]"}], ":=", 
           RowBox[{"Piecewise", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"x", "<=", "a"}]}], "}"}], "}"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "-", "a"}], ")"}], "^", "2"}], "/", "4"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<Nonunique Initial-Value Problem\>\"", ",", "18", ",",
                "Bold"}], "]"}], ",", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"y", "[", "x", "]"}], "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{"y", "[", "0", "]"}], "==", "0"}]}], "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Waiting time a:   \>\"", ",", "Bold"}], "]"}], ",",
                 "a"}], "}"}], "]"}], ",", 
             RowBox[{"TextCell", "[", 
              
              RowBox[{"\"\<The solution remains at y = 0 until x = a, then \
leaves the equilibrium.\>\"", ",", "\"\<Text\>\""}], "]"}], ",", 
             RowBox[{"Plot", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", 
                 RowBox[{"delayedSolution", "[", "x", "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "0", ",", "6"}], "}"}], ",", 
               RowBox[{"PlotRange", "->", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "10"}], "}"}]}], ",", 
               RowBox[{"PlotLegends", "->", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<Equilibrium solution y = 0\>\"", 
                  ",", "\"\<Delayed solution\>\""}], "}"}]}], ",", 
               RowBox[{"AxesLabel", "->", 
                RowBox[{"{", 
                 RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
               RowBox[{
               "PlotLabel", 
                "->", "\"\<Many Solutions Through the Same Initial \
Point\>\""}]}], "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", "0", ",", "\"\<Waiting time a\>\""}], "}"}], ",", 
         "0", ",", "4", ",", "0.25"}], "}"}]}], "]"}]}]}], "}"}], 
  "]"}]}], "Input",
