Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"solution", ",", "check", ",", "plot"}], "}"}], ",", 
     RowBox[{
      RowBox[{"solution", "=", 
       RowBox[{"Tan", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "^", "2"}], "/", "2"}], "+", 
         RowBox[{"ArcTan", "[", "y0", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"check", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"solution", ",", "x"}], "]"}], "==", 
          RowBox[{"x", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"solution", "^", "2"}]}], ")"}]}]}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{"Element", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y0"}], "}"}], ",", "Reals"}], "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"plot", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{"solution", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "1.7"}], ",", "1.7"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "10"}], ",", "10"}], "}"}]}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Separable IVP Solution\>\""}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 2.1: Separable Equations\>\
\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Differential equation: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
              RowBox[{"x", " ", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"y", "[", "x", "]"}], "^", "2"}]}], ")"}]}]}], 
             "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Initial condition: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "0", "]"}], "==", "y0"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Solution: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "x", "]"}], "==", "solution"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification: \>\"", ",", "check"}], "}"}], "]"}], ",",
          "plot"}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y0", ",", "0", ",", "\"\<Initial value y(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "0.75"}], ",", "0.75", ",", "0.25"}], "}"}]}], 
  "]"}]}], "Input",
