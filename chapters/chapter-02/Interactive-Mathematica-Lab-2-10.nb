Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"y", ",", "x", ",", "problemNumber", ",", "revealAnswer"}], "]"}],
    ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"equations", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"HoldForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
        RowBox[{"x", " ", 
         RowBox[{"y", "[", "x", "]"}]}]}], "]"}], ",", 
      RowBox[{"HoldForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "x", "]"}], "+", 
         RowBox[{"2", " ", 
          RowBox[{"y", "[", "x", "]"}]}]}], "==", "x"}], "]"}], ",", 
      RowBox[{"HoldForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "x", " ", 
            RowBox[{"y", "[", "x", "]"}]}], "+", "1"}], ")"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "^", "2"}], "+", 
            RowBox[{"2", " ", 
             RowBox[{"y", "[", "x", "]"}]}]}], ")"}], " ", 
          RowBox[{
           RowBox[{"y", "'"}], "[", "x", "]"}]}]}], "==", "0"}], "]"}], ",", 
      RowBox[{"HoldForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "x", "]"}], "+", 
         RowBox[{"y", "[", "x", "]"}]}], "==", 
        RowBox[{"x", " ", 
         RowBox[{
          RowBox[{"y", "[", "x", "]"}], "^", "2"}]}]}], "]"}], ",", 
      RowBox[{"HoldForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"y", "[", "x", "]"}], "/", "x"}]}]}], "]"}], ",", 
      RowBox[{"HoldForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "+", 
           RowBox[{"y", "[", "x", "]"}]}], ")"}], "^", "2"}]}], "]"}]}], 
     "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"preferredMethods", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Separation of variables\>\"", 
      ",", "\"\<First-order linear\>\"", ",", "\"\<Exact equation\>\"", 
      ",", "\"\<Bernoulli\>\"", 
      ",", "\"\<Homogeneous substitution y = v x\>\"", 
      ",", "\"\<Composite substitution u = x + y\>\""}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"otherMethods", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Also a homogeneous first-order linear equation\>\"", 
      ",", "\"\<No simpler standard method is more direct\>\"", 
      ",", "\"\<Exactness is the most direct structure\>\"", 
      ",", "\"\<Bernoulli is the natural transformation\>\"", 
      ",", "\"\<Also a first-order linear equation\>\"", 
      ",", "\"\<Composite substitution is the natural simplification\>\""}], 
     "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reasons", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<The right-hand side is a product of a function of x and a \
function of y.\>\"", 
      ",", "\"\<The equation is already in the form y' + P(x)y = Q(x).\>\"", 
      ",", "\"\<In differential form, the required mixed partial derivatives \
agree.\>\"", 
      ",", "\"\<The equation contains the nonlinear power y^2 in Bernoulli \
form.\>\"", 
      ",", "\"\<The right-hand side depends only on the ratio y/x, although \
the equation is also linear.\>\"", 
      ",", "\"\<The repeated quantity x + y appears as a single composite \
expression.\>\""}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Column", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Interactive Mathematica Lab 2.10: Method-Selection \
Challenge\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Problem \>\"", ",", "problemNumber"}], "}"}], "]"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Equation: \>\"", ",", 
         RowBox[{"TraditionalForm", "[", 
          RowBox[{"equations", "[", 
           RowBox[{"[", "problemNumber", "]"}], "]"}], "]"}]}], "}"}], "]"}], 
      ",", 
      RowBox[{"If", "[", 
       RowBox[{"revealAnswer", ",", 
        RowBox[{"Column", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<Preferred method: \>\"", ",", "Bold"}], "]"}], ",", 
              RowBox[{"preferredMethods", "[", 
               RowBox[{"[", "problemNumber", "]"}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<Other observation: \>\"", ",", "Bold"}], "]"}], ",", 
              RowBox[{"otherMethods", "[", 
               RowBox[{"[", "problemNumber", "]"}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<Why: \>\"", ",", "Bold"}], "]"}], ",", 
              RowBox[{"reasons", "[", 
               RowBox[{"[", "problemNumber", "]"}], "]"}]}], "}"}], "]"}]}], 
          "}"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Classify the equation before revealing the \
suggestion.\>\"", ",", "14", ",", "Bold"}], "]"}]}], "]"}]}], "}"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"problemNumber", ",", "1", ",", "\"\<Choose a problem:\>\""}], 
      "}"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "equations", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"revealAnswer", ",", "False", ",", "\"\<Reveal answer:\>\""}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"False", ",", "True"}], "}"}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}]}], "]"}]}], "Input",
