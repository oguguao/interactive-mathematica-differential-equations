      Module[{$CellContext`solution$, $CellContext`check$, \
$CellContext`transient$, $CellContext`longTerm$}, $CellContext`solution$ = \
$CellContext`x/$CellContext`p$$ - 
          1/$CellContext`p$$^2 + ($CellContext`y0$$ + 1/$CellContext`p$$^2) 
           Exp[(-$CellContext`p$$) $CellContext`x]; $CellContext`longTerm$ = \
