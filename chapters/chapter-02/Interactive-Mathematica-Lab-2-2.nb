Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"solution", ",", "check", ",", "transient", ",", "longTerm"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"solution", "=", 
       RowBox[{
        RowBox[{"x", "/", "p"}], "-", 
        RowBox[{"1", "/", 
         RowBox[{"p", "^", "2"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y0", "+", 
           RowBox[{"1", "/", 
            RowBox[{"p", "^", "2"}]}]}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "p"}], " ", "x"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"longTerm", "=", 
       RowBox[{
        RowBox[{"x", "/", "p"}], "-", 
        RowBox[{"1", "/", 
         RowBox[{"p", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"transient", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"y0", "+", 
          RowBox[{"1", "/", 
           RowBox[{"p", "^", "2"}]}]}], ")"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "p"}], " ", "x"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"check", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"solution", ",", "x"}], "]"}], "+", 
          RowBox[{"p", " ", "solution"}]}], "==", "x"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 2.2: First-Order Linear \
Equations\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Equation: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"y", "'"}], "[", "x", "]"}], "+", 
               RowBox[{"p", " ", 
                RowBox[{"y", "[", "x", "]"}]}]}], "==", "x"}], "]"}]}], "}"}],
           "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Initial condition: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "0", "]"}], "==", "y0"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Solution: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "x", "]"}], "==", "solution"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Transient term: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "transient", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Long-term component: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "longTerm", "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification: \>\"", ",", "check"}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"solution", ",", "longTerm"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0", ",", "6"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Full solution\>\"", 
              ",", "\"\<Long-term component\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Transient and Long-Term Behavior\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "2", ",", "\"\<Coefficient p\>\""}], "}"}], ",", "1", 
     ",", "4", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y0", ",", "1", ",", "\"\<Initial value y(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "3", ",", "1"}], "}"}]}], "]"}]}], "Input",
