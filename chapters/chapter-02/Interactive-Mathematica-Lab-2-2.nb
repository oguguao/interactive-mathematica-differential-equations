$CellContext`solution$ == $CellContext`x]; Column[{
           Style[
           "Interactive Mathematica Lab 2.2: First-Order Linear Equations", 
            18, Bold], 
           Row[{"Equation: ", 
             TraditionalForm[
             Derivative[
                1][$CellContext`y][$CellContext`x] + $CellContext`p$$ \
$CellContext`y[$CellContext`x] == $CellContext`x]}], 
           Row[{"Initial condition: ", 
             TraditionalForm[$CellContext`y[0] == $CellContext`y0$$]}], 
           Row[{"Solution: ", 
             
             TraditionalForm[$CellContext`y[$CellContext`x] == \
$CellContext`solution$]}], 
           Row[{"Transient term: ", 
             TraditionalForm[$CellContext`transient$]}], 
           Row[{"Long-term component: ", 
             TraditionalForm[$CellContext`longTerm$]}], 
           Row[{"Verification: ", $CellContext`check$}], 
           
           Plot[{$CellContext`solution$, $CellContext`longTerm$}, \
{$CellContext`x, 0, 6}, PlotRange -> All, 
            PlotLegends -> {"Full solution", "Long-term component"}, 
            AxesLabel -> {"x", "y"}, GridLines -> Automatic, PlotLabel -> 
