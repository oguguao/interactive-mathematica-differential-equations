Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mu", ",", "integrand", ",", "generalSolution", ",", "identity", ",", 
       "verification"}], "}"}], ",", 
     RowBox[{
      RowBox[{"mu", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"p", " ", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"integrand", "=", 
       RowBox[{"Expand", "[", 
        RowBox[{"mu", " ", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"generalSolution", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Integrate", "[", 
             RowBox[{"integrand", ",", "x"}], "]"}], "+", 
            RowBox[{"C", "[", "1", "]"}]}], ")"}], "/", "mu"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{"p", ">", "0"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"identity", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"mu", " ", 
            RowBox[{"y", "[", "x", "]"}]}], ",", "x"}], "]"}], "==", 
         RowBox[{"mu", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "x", "]"}], "+", 
            RowBox[{"p", " ", 
             RowBox[{"y", "[", "x", "]"}]}]}], ")"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"generalSolution", ",", "x"}], "]"}], "+", 
           RowBox[{"p", " ", "generalSolution"}]}], "==", "x"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{"p", ">", "0"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 2.3: Integrating-Factor \
Builder\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Standard form: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"y", "'"}], "[", "x", "]"}], "+", 
               RowBox[{"p", " ", 
                RowBox[{"y", "[", "x", "]"}]}]}], "==", "x"}], "]"}]}], "}"}],
           "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<P(x): \>\"", ",", "p"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Integrating factor: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "mu", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Product-rule identity: \>\"", ",", "identity"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<General solution: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "x", "]"}], "==", "generalSolution"}], 
             "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification: \>\"", ",", "verification"}], "}"}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
