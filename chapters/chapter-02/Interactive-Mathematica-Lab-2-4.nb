Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mFun", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"2", " ", "x", " ", "y"}], "+", "3"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"nFun", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"x", "^", "2"}], "+", 
     RowBox[{"4", " ", "y"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"potentialFun", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "^", "2"}], " ", "y"}], "+", 
     RowBox[{"3", " ", "x"}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"y", "^", "2"}]}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"exactnessCheck", ",", "gradientCheck"}], "}"}], ",", 
     RowBox[{
      RowBox[{"exactnessCheck", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"mFun", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "==", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"nFun", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"gradientCheck", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"potentialFun", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "==", 
           RowBox[{"mFun", "[", 
            RowBox[{"x", ",", "y"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"potentialFun", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "==", 
           RowBox[{"nFun", "[", 
            RowBox[{"x", ",", "y"}], "]"}]}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 2.4: Exact Equations and \
Inspection\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<M(x,y) = \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"mFun", "[", 
              RowBox[{"x", ",", "y"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<N(x,y) = \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"nFun", "[", 
              RowBox[{"x", ",", "y"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<M_y = \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"mFun", "[", 
                RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<N_x = \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"nFun", "[", 
                RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Exactness check: \>\"", ",", "exactnessCheck"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Potential function: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"potentialFun", "[", 
              RowBox[{"x", ",", "y"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Gradient verification: \>\"", ",", "gradientCheck"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Selected solution curve: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"potentialFun", "[", 
               RowBox[{"x", ",", "y"}], "]"}], "==", "c"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"ContourPlot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"potentialFun", "[", 
             RowBox[{"x", ",", "y"}], "]"}], "==", "c"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Implicit Solution Curve F(x,y) = C\>\""}], 
           ",", 
           RowBox[{"PlotPoints", "->", "50"}]}], "]"}]}], "}"}], "]"}]}]}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", "0", ",", "\"\<Solution constant C\>\""}], "}"}], ",", 
