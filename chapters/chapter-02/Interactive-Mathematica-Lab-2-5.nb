       Hold[$CellContext`startChoice$$], "Integrate M first", 
       "Choose a starting method:"}, {
      "Integrate M first", "Integrate N first"}, ControlType -> SetterBar}}, 
    Typeset`size$$ = {683.7626953125, {81.7302001953125, 87.4621337890625}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`startChoice$$ = "Integrate M first"}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`exactCheck$, $CellContext`partialPotential$, \
$CellContext`missingDerivative$, $CellContext`potentialFun$, \
$CellContext`gradientCheck$}, $CellContext`exactCheck$ = FullSimplify[D[
             $CellContext`mFun[$CellContext`x, $CellContext`y], \
$CellContext`y] == D[
             $CellContext`nFun[$CellContext`x, $CellContext`y], \
$CellContext`x]]; 
        If[$CellContext`startChoice$$ == 
          "Integrate M first", $CellContext`partialPotential$ = Integrate[
             $CellContext`mFun[$CellContext`x, $CellContext`y], \
$CellContext`x]; $CellContext`missingDerivative$ = 
           FullSimplify[$CellContext`nFun[$CellContext`x, $CellContext`y] - 
             D[$CellContext`partialPotential$, $CellContext`y]]; \
$CellContext`potentialFun$ = 
           FullSimplify[$CellContext`partialPotential$ + 
             Integrate[$CellContext`missingDerivative$, $CellContext`y]], \
$CellContext`partialPotential$ = Integrate[
             $CellContext`nFun[$CellContext`x, $CellContext`y], \
$CellContext`y]; $CellContext`missingDerivative$ = 
           FullSimplify[$CellContext`mFun[$CellContext`x, $CellContext`y] - 
             D[$CellContext`partialPotential$, $CellContext`x]]; \
$CellContext`potentialFun$ = 
           FullSimplify[$CellContext`partialPotential$ + 
             Integrate[$CellContext`missingDerivative$, $CellContext`x]]]; \
$CellContext`gradientCheck$ = 
         FullSimplify[{
           D[$CellContext`potentialFun$, $CellContext`x] == \
$CellContext`mFun[$CellContext`x, $CellContext`y], 
            D[$CellContext`potentialFun$, $CellContext`y] == \
$CellContext`nFun[$CellContext`x, $CellContext`y]}]; Column[{
           Style[
           "Interactive Mathematica Lab 2.5: Systematic Potential-Function \
Method", 18, Bold], 
           Row[{"M(x,y) = ", 
             TraditionalForm[
              $CellContext`mFun[$CellContext`x, $CellContext`y]]}], 
           Row[{"N(x,y) = ", 
             TraditionalForm[
              $CellContext`nFun[$CellContext`x, $CellContext`y]]}], 
           Row[{"Exactness check: ", $CellContext`exactCheck$}], 
           Row[{"Starting expression: ", 
             TraditionalForm[$CellContext`partialPotential$]}], 
           Row[{"Missing derivative: ", 
             TraditionalForm[$CellContext`missingDerivative$]}], 
           Row[{"Potential function F(x,y): ", 
             TraditionalForm[$CellContext`potentialFun$]}], 
           Row[{"Gradient verification: ", $CellContext`gradientCheck$}], 
           Row[{"Implicit solution: ", 
             
             TraditionalForm[$CellContext`potentialFun$ == \
$CellContext`c]}]}]], 
