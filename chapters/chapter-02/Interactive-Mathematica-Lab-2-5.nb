Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "x", ",", "y", ",", "c", ",", "mFun", ",", "nFun", ",", "startChoice"}], 
    "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mFun", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"3", " ", 
      RowBox[{"x", "^", "2"}], " ", "y"}], "+", 
     RowBox[{"2", " ", "y"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"nFun", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"x", "^", "3"}], "+", 
     RowBox[{"2", " ", "x"}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"y", "^", "3"}]}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "exactCheck", ",", "partialPotential", ",", "missingDerivative", ",", 
       "potentialFun", ",", "gradientCheck"}], "}"}], ",", 
     RowBox[{
      RowBox[{"exactCheck", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"mFun", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "==", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"nFun", "[", 
            RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"startChoice", "==", "\"\<Integrate M first\>\""}], ",", 
        RowBox[{
         RowBox[{"partialPotential", "=", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"mFun", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"missingDerivative", "=", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{
            RowBox[{"nFun", "[", 
             RowBox[{"x", ",", "y"}], "]"}], "-", 
            RowBox[{"D", "[", 
             RowBox[{"partialPotential", ",", "y"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"potentialFun", "=", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"partialPotential", "+", 
            RowBox[{"Integrate", "[", 
             RowBox[{"missingDerivative", ",", "y"}], "]"}]}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"partialPotential", "=", 
          RowBox[{"Integrate", "[", 
           RowBox[{
            RowBox[{"nFun", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"missingDerivative", "=", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{
            RowBox[{"mFun", "[", 
             RowBox[{"x", ",", "y"}], "]"}], "-", 
            RowBox[{"D", "[", 
             RowBox[{"partialPotential", ",", "x"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"potentialFun", "=", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"partialPotential", "+", 
            RowBox[{"Integrate", "[", 
             RowBox[{"missingDerivative", ",", "x"}], "]"}]}], "]"}]}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"gradientCheck", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"potentialFun", ",", "x"}], "]"}], "==", 
           RowBox[{"mFun", "[", 
            RowBox[{"x", ",", "y"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"potentialFun", ",", "y"}], "]"}], "==", 
           RowBox[{"nFun", "[", 
            RowBox[{"x", ",", "y"}], "]"}]}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 2.5: Systematic \
Potential-Function Method\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<M(x,y) = \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"mFun", "[", 
              RowBox[{"x", ",", "y"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<N(x,y) = \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"nFun", "[", 
              RowBox[{"x", ",", "y"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Exactness check: \>\"", ",", "exactCheck"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Starting expression: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "partialPotential", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Missing derivative: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "missingDerivative", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Potential function F(x,y): \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "potentialFun", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Gradient verification: \>\"", ",", "gradientCheck"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Implicit solution: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"potentialFun", "==", "c"}], "]"}]}], "}"}], "]"}]}], 
        "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "startChoice", ",", "\"\<Integrate M first\>\"", 
       ",", "\"\<Choose a starting method:\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Integrate M first\>\"", ",", "\"\<Integrate N first\>\""}],
       "}"}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9974718898844013`*^9, 3.9974718898844013`*^9}},
