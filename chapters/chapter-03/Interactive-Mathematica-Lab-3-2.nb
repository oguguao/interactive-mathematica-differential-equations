      Module[{$CellContext`growthConstant$, $CellContext`model$, \
$CellContext`prediction$, $CellContext`classification$, \
$CellContext`characteristicTime$}, $CellContext`growthConstant$ = 
         Log[$CellContext`measuredAmount$$/$CellContext`initialAmount$$]/$\
CellContext`measurementTime$$; $CellContext`model$[
           Pattern[$CellContext`t$, 
            Blank[]]] := $CellContext`initialAmount$$ 
          Exp[$CellContext`growthConstant$ $CellContext`t$]; \
$CellContext`prediction$ = $CellContext`model$[$CellContext`predictionTime$$]; \
$CellContext`classification$ = 
         Which[Chop[$CellContext`growthConstant$] > 0, "Exponential Growth", 
           Chop[$CellContext`growthConstant$] < 0, "Exponential Decay", True, 
           "Constant Amount"]; $CellContext`characteristicTime$ = 
         Which[Chop[$CellContext`growthConstant$] > 0, 
           Log[2]/$CellContext`growthConstant$, 
           Chop[$CellContext`growthConstant$] < 0, Log[2]/
           Abs[$CellContext`growthConstant$], True, Indeterminate]; Column[{
           Style[
           "Interactive Mathematica Lab 3.2: Exponential Growth and Decay", 
            18, Bold], 
           Row[{"Model: ", 
             
             TraditionalForm[$CellContext`q[$CellContext`t] == \
$CellContext`initialAmount$$ 
               Exp[$CellContext`growthConstant$ $CellContext`t]]}], 
           Row[{"Classification: ", $CellContext`classification$}], 
           Row[{"Estimated k: ", 
             NumberForm[
              N[$CellContext`growthConstant$], {7, 4}]}], 
           Row[{
             If[Chop[$CellContext`growthConstant$] > 0, "Doubling time: ", 
              If[
              Chop[$CellContext`growthConstant$] < 0, "Half-life: ", 
               "Doubling/Half-life: "]], 
             If[
