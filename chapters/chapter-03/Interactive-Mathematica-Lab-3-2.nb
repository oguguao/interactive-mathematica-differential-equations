Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "growthConstant", ",", "model", ",", "prediction", ",", 
       "classification", ",", "characteristicTime"}], "}"}], ",", 
     RowBox[{
      RowBox[{"growthConstant", "=", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"measuredAmount", "/", "initialAmount"}], "]"}], "/", 
        "measurementTime"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"model", "[", "t_", "]"}], ":=", 
       RowBox[{"initialAmount", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"growthConstant", " ", "t"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"prediction", "=", 
       RowBox[{"model", "[", "predictionTime", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"classification", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Chop", "[", "growthConstant", "]"}], ">", "0"}], 
         ",", "\"\<Exponential Growth\>\"", ",", 
         RowBox[{
          RowBox[{"Chop", "[", "growthConstant", "]"}], "<", "0"}], 
         ",", "\"\<Exponential Decay\>\"", ",", "True", 
         ",", "\"\<Constant Amount\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"characteristicTime", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Chop", "[", "growthConstant", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"Log", "[", "2", "]"}], "/", "growthConstant"}], ",", 
         RowBox[{
          RowBox[{"Chop", "[", "growthConstant", "]"}], "<", "0"}], ",", 
         RowBox[{
          RowBox[{"Log", "[", "2", "]"}], "/", 
          RowBox[{"Abs", "[", "growthConstant", "]"}]}], ",", "True", ",", 
         "Indeterminate"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 3.2: Exponential Growth \
and Decay\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Model: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"q", "[", "t", "]"}], "==", 
              RowBox[{"initialAmount", " ", 
               RowBox[{"Exp", "[", 
                RowBox[{"growthConstant", " ", "t"}], "]"}]}]}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Classification: \>\"", ",", "classification"}], "}"}],
           "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Estimated k: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "growthConstant", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "4"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Chop", "[", "growthConstant", "]"}], ">", "0"}], 
              ",", "\"\<Doubling time: \>\"", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Chop", "[", "growthConstant", "]"}], "<", "0"}], 
                ",", "\"\<Half-life: \>\"", 
                ",", "\"\<Doubling/Half-life: \>\""}], "]"}]}], "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"NumericQ", "[", "characteristicTime", "]"}], ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"N", "[", "characteristicTime", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"7", ",", "3"}], "}"}]}], "]"}], 
              ",", "\"\<Not applicable\>\""}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Predicted amount at t = \>\"", ",", "predictionTime", 
            ",", "\"\<: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "prediction", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"10", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"model", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"2", " ", "measurementTime"}], ",", "predictionTime"}],
               "]"}]}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<t\>\"", ",", "\"\<Q(t)\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotLabel", "->", "classification"}]}], "]"}]}], "}"}], 
       "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialAmount", ",", "500", ",", "\"\<Initial amount Q0\>\""}],
       "}"}], ",", "100", ",", "1000", ",", "50"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"measurementTime", ",", "3", ",", "\"\<Measurement time\>\""}], 
      "}"}], ",", "1", ",", "10", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"measuredAmount", ",", "650", ",", "\"\<Measured amount\>\""}], 
      "}"}], ",", "100", ",", "1200", ",", "25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"predictionTime", ",", "10", ",", "\"\<Prediction time\>\""}], 
      "}"}], ",", "1", ",", "20", ",", "1"}], "}"}]}], "]"}]}], "Input",
