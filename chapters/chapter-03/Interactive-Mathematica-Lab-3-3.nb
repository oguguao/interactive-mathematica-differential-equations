Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialTemperature", ",", "temperatureModel", ",", 
       "temperatureAtMeasurement"}], "}"}], ",", 
     RowBox[{
      RowBox[{"initialTemperature", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"process", "==", "\"\<Cooling\>\""}], ",", 
         RowBox[{"ambientTemperature", "+", "initialDifference"}], ",", 
         RowBox[{"ambientTemperature", "-", "initialDifference"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"temperatureModel", "[", "t_", "]"}], ":=", 
       RowBox[{"ambientTemperature", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"initialTemperature", "-", "ambientTemperature"}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "coolingConstant"}], " ", "t"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"temperatureAtMeasurement", "=", 
       RowBox[{"temperatureModel", "[", "measurementTime", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 3.3: Newton's Law of \
Cooling and Heating\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Process: \>\"", ",", "process"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Differential equation: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"temp", "'"}], "[", "t", "]"}], "==", 
              RowBox[{
               RowBox[{"-", "coolingConstant"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"temp", "[", "t", "]"}], "-", "ambientTemperature"}],
                 ")"}]}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Initial temperature: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "initialTemperature", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Ambient temperature: \>\"", ",", 
            "ambientTemperature"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Temperature at t = \>\"", ",", "measurementTime", 
            ",", "\"\<: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "temperatureAtMeasurement", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"temperatureModel", "[", "t", "]"}], ",", 
             "ambientTemperature"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "40"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<T(t)\>\"", ",", "\"\<Ambient temperature\>\""}], 
             "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", "\"\<Temperature\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Approach to Ambient Temperature\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"process", ",", "\"\<Cooling\>\"", ",", "\"\<Process\>\""}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Cooling\>\"", ",", "\"\<Heating\>\""}], "}"}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ambientTemperature", ",", "20", ",", "\"\<Ambient temperature\>\""}], 
      "}"}], ",", "0", ",", "40", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialDifference", ",", "70", 
       ",", "\"\<Initial temperature difference\>\""}], "}"}], ",", "10", ",",
      "100", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"coolingConstant", ",", "0.08", ",", "\"\<Constant k\>\""}], 
      "}"}], ",", "0.02", ",", "0.20", ",", "0.01"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"measurementTime", ",", "10", ",", "\"\<Measurement time\>\""}],
       "}"}], ",", "1", ",", "30", ",", "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.997476466663357*^9, 3.997476466663357*^9}},
