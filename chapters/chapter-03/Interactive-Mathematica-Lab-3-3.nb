      Manipulator}, {{
       Hold[$CellContext`coolingConstant$$], 0.08, "Constant k"}, 0.02, 0.2, 
      0.01, ControlType -> Manipulator}, {{
       Hold[$CellContext`measurementTime$$], 10, "Measurement time"}, 1, 30, 
      1, ControlType -> Manipulator}}, Typeset`size$$ = {
    672.9609375, {108.3327430630508, 114.0646766568008}}, Typeset`update$$ = 
    0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`ambientTemperature$$ = 
        20, $CellContext`coolingConstant$$ = 
        0.08, $CellContext`initialDifference$$ = 
        70, $CellContext`measurementTime$$ = 10, $CellContext`process$$ = 
        "Cooling"}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`initialTemperature$, \
$CellContext`temperatureModel$, $CellContext`temperatureAtMeasurement$}, \
$CellContext`initialTemperature$ = 
         If[$CellContext`process$$ == 
           "Cooling", $CellContext`ambientTemperature$$ + \
$CellContext`initialDifference$$, $CellContext`ambientTemperature$$ - \
$CellContext`initialDifference$$]; $CellContext`temperatureModel$[
           Pattern[$CellContext`t$, 
            
            Blank[]]] := $CellContext`ambientTemperature$$ + \
($CellContext`initialTemperature$ - $CellContext`ambientTemperature$$) 
           Exp[(-$CellContext`coolingConstant$$) $CellContext`t$]; \
$CellContext`temperatureAtMeasurement$ = \
$CellContext`temperatureModel$[$CellContext`measurementTime$$]; Column[{
           Style[
           "Interactive Mathematica Lab 3.3: Newton's Law of Cooling and \
Heating", 18, Bold], 
           Row[{"Process: ", $CellContext`process$$}], 
           Row[{"Differential equation: ", 
             TraditionalForm[
             Derivative[
               1][$CellContext`temp][$CellContext`t] == \
(-$CellContext`coolingConstant$$) ($CellContext`temp[$CellContext`t] - \
$CellContext`ambientTemperature$$)]}], 
           Row[{"Initial temperature: ", 
             NumberForm[
              N[$CellContext`initialTemperature$], {7, 2}]}], 
           Row[{"Ambient temperature: ", $CellContext`ambientTemperature$$}], 
           Row[{"Temperature at t = ", $CellContext`measurementTime$$, ": ", 
             NumberForm[
              N[$CellContext`temperatureAtMeasurement$], {7, 2}]}], 
           Plot[{
             $CellContext`temperatureModel$[$CellContext`t], \
$CellContext`ambientTemperature$$}, {$CellContext`t, 0, 40}, PlotRange -> All,
             PlotLegends -> {"T(t)", "Ambient temperature"}, 
            AxesLabel -> {"Time", "Temperature"}, GridLines -> Automatic, 
            PlotLabel -> "Approach to Ambient Temperature"]}]], 
      "Specifications" :> {{{$CellContext`process$$, "Cooling", "Process"}, {
         "Cooling", "Heating"}, ControlType -> 
         SetterBar}, {{$CellContext`ambientTemperature$$, 20, 
          "Ambient temperature"}, 0, 40, 
