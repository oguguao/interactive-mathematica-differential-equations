      ControlType -> Manipulator}, {{
       Hold[$CellContext`initialFraction$$], 0.05, 
       "Initial population as fraction of K"}, 0.05, 0.45, 0.05, ControlType -> 
      Manipulator}}, Typeset`size$$ = {
    583.892578125, {139.1783445725575, 144.9102781663075}}, Typeset`update$$ =
     0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`carryingCapacity$$ = 
        1000, $CellContext`growthRate$$ = 0.4, $CellContext`initialFraction$$ = 
        0.05}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`initialPopulation$, $CellContext`aValue$, \
$CellContext`populationModel$, $CellContext`halfCapacityTime$, \
$CellContext`maximumGrowthRate$}, $CellContext`initialPopulation$ = \
$CellContext`initialFraction$$ $CellContext`carryingCapacity$$; \
$CellContext`aValue$ = ($CellContext`carryingCapacity$$ - \
$CellContext`initialPopulation$)/$CellContext`initialPopulation$; \
$CellContext`populationModel$[
           Pattern[$CellContext`t$, 
            Blank[]]] := $CellContext`carryingCapacity$$/(
          1 + $CellContext`aValue$ 
           Exp[(-$CellContext`growthRate$$) $CellContext`t$]); \
$CellContext`halfCapacityTime$ = 
         Log[$CellContext`aValue$]/$CellContext`growthRate$$; \
$CellContext`maximumGrowthRate$ = $CellContext`growthRate$$ \
($CellContext`carryingCapacity$$/4); Column[{
           Style[
           "Interactive Mathematica Lab 3.4: Logistic Population Growth", 18, 
            Bold], 
           Row[{"Logistic equation: ", 
             TraditionalForm[
             Derivative[
               1][$CellContext`p][$CellContext`t] == \
$CellContext`growthRate$$ $CellContext`p[$CellContext`t] (
                1 - $CellContext`p[$CellContext`t]/$CellContext`\
carryingCapacity$$)]}], 
           Row[{"Initial population: ", 
             NumberForm[$CellContext`initialPopulation$, {8, 1}]}], 
           Row[{"Carrying capacity K: ", $CellContext`carryingCapacity$$}], 
           Row[{"Equilibria: ", 
             TraditionalForm[{0, $CellContext`carryingCapacity$$}]}], 
           
           Row[{"Population of maximum growth: ", \
$CellContext`carryingCapacity$$/2}], 
           Row[{"Maximum growth rate: ", 
             NumberForm[
              N[$CellContext`maximumGrowthRate$], {9, 2}]}], 
           Row[{"Time to reach K/2: ", 
             NumberForm[
              N[$CellContext`halfCapacityTime$], {7, 2}]}], 
           Plot[{
             $CellContext`populationModel$[$CellContext`t], \
$CellContext`carryingCapacity$$, $CellContext`carryingCapacity$$/
             2}, {$CellContext`t, 0, 30}, 
            PlotRange -> {0, 1.1 $CellContext`carryingCapacity$$}, 
            PlotLegends -> {"P(t)", "K", "K/2"}, 
            AxesLabel -> {"t", "Population"}, GridLines -> Automatic, 
            PlotLabel -> "Logistic Population Model"]}]], 
      "Specifications" :> {{{$CellContext`carryingCapacity$$, 1000, 
          "Carrying capacity K"}, 500, 2000, 
         100}, {{$CellContext`growthRate$$, 0.4, "Growth rate r"}, 0.1, 1, 
         0.1}, {{$CellContext`initialFraction$$, 0.05, 
