Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialPopulation", ",", "aValue", ",", "populationModel", ",", 
       "halfCapacityTime", ",", "maximumGrowthRate"}], "}"}], ",", 
     RowBox[{
      RowBox[{"initialPopulation", "=", 
       RowBox[{"initialFraction", "*", "carryingCapacity"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aValue", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"carryingCapacity", "-", "initialPopulation"}], ")"}], "/", 
        "initialPopulation"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"populationModel", "[", "t_", "]"}], ":=", 
       RowBox[{"carryingCapacity", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"aValue", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "growthRate"}], " ", "t"}], "]"}]}]}], ")"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"halfCapacityTime", "=", 
       RowBox[{
        RowBox[{"Log", "[", "aValue", "]"}], "/", "growthRate"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maximumGrowthRate", "=", 
       RowBox[{"growthRate", "*", 
        RowBox[{"carryingCapacity", "/", "4"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 3.4: Logistic Population \
Growth\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Logistic equation: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"p", "'"}], "[", "t", "]"}], "==", 
              RowBox[{"growthRate", " ", 
               RowBox[{"p", "[", "t", "]"}], " ", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{
                  RowBox[{"p", "[", "t", "]"}], "/", "carryingCapacity"}]}], 
                ")"}]}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Initial population: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"initialPopulation", ",", 
              RowBox[{"{", 
               RowBox[{"8", ",", "1"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Carrying capacity K: \>\"", ",", "carryingCapacity"}],
            "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Equilibria: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "carryingCapacity"}], "}"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Population of maximum growth: \>\"", ",", 
            RowBox[{"carryingCapacity", "/", "2"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Maximum growth rate: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "maximumGrowthRate", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"9", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Time to reach K/2: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "halfCapacityTime", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"populationModel", "[", "t", "]"}], ",", 
             "carryingCapacity", ",", 
             RowBox[{"carryingCapacity", "/", "2"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "30"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"1.1", " ", "carryingCapacity"}]}], "}"}]}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<P(t)\>\"", ",", "\"\<K\>\"", ",", "\"\<K/2\>\""}], 
             "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<t\>\"", ",", "\"\<Population\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<Logistic Population Model\>\""}]}],
           "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "carryingCapacity", ",", "1000", ",", "\"\<Carrying capacity K\>\""}], 
      "}"}], ",", "500", ",", "2000", ",", "100"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"growthRate", ",", "0.4", ",", "\"\<Growth rate r\>\""}], "}"}],
      ",", "0.1", ",", "1", ",", "0.1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialFraction", ",", "0.05", 
       ",", "\"\<Initial population as fraction of K\>\""}], "}"}], ",", 
     "0.05", ",", "0.45", ",", "0.05"}], "}"}]}], "]"}]}], "Input",
