Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "equilibriumAmount", ",", "amountModel", ",", "concentrationModel", ",",
        "rateIn"}], "}"}], ",", 
     RowBox[{
      RowBox[{"equilibriumAmount", "=", 
       RowBox[{"tankVolume", "*", "incomingConcentration"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rateIn", "=", 
       RowBox[{"flowRate", "*", "incomingConcentration"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"amountModel", "[", "t_", "]"}], ":=", 
       RowBox[{"equilibriumAmount", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"initialAmount", "-", "equilibriumAmount"}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "flowRate"}], " ", 
           RowBox[{"t", "/", "tankVolume"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"concentrationModel", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{"amountModel", "[", "t", "]"}], "/", "tankVolume"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 3.5: Mixture Problems\>\"",
            ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Tank volume: \>\"", ",", "tankVolume"}], "}"}], "]"}],
          ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Rate in: \>\"", ",", "rateIn"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Rate out: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"flowRate", "*", 
              RowBox[{
               RowBox[{"a", "[", "t", "]"}], "/", "tankVolume"}]}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Equilibrium amount: \>\"", ",", "equilibriumAmount"}],
            "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Limiting concentration: \>\"", ",", 
            "incomingConcentration"}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"amountModel", "[", "t", "]"}], ",", 
             "equilibriumAmount"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "150"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Amount A(t)\>\"", 
              ",", "\"\<Equilibrium amount\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", "\"\<Amount\>\""}], "}"}]}], ",", 
