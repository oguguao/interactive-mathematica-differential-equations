           "PlotLabel", "->", "\"\<Amount of Dissolved Substance\>\""}]}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"concentrationModel", "[", "t", "]"}], ",", 
             "incomingConcentration"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "150"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Tank concentration\>\"", 
              ",", "\"\<Incoming concentration\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", "\"\<Concentration\>\""}], "}"}]}], 
