       2, ControlType -> Manipulator}, {{
       Hold[$CellContext`initialVelocity$$], 0, "Initial downward velocity"}, 
      0, 80, 5, ControlType -> Manipulator}}, Typeset`size$$ = {
    643.271484375, {81.47328811578537, 87.20522170953537}}, Typeset`update$$ =
     0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`dragCoefficient$$ = 
        12, $CellContext`initialVelocity$$ = 0, $CellContext`mass$$ = 80}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`gravity$, $CellContext`terminalVelocity$, \
$CellContext`velocityModel$, $CellContext`timeToFivePercentGap$}, \
$CellContext`gravity$ = 
         9.81; $CellContext`terminalVelocity$ = $CellContext`mass$$ \
($CellContext`gravity$/$CellContext`dragCoefficient$$); \
$CellContext`velocityModel$[
           Pattern[$CellContext`t$, 
            
            Blank[]]] := $CellContext`terminalVelocity$ + \
($CellContext`initialVelocity$$ - $CellContext`terminalVelocity$) 
           Exp[(-$CellContext`dragCoefficient$$) \
($CellContext`t$/$CellContext`mass$$)]; $CellContext`timeToFivePercentGap$ = \
(-($CellContext`mass$$/$CellContext`dragCoefficient$$)) Log[0.05]; Column[{
           Style[
           "Interactive Mathematica Lab 3.6: Motion and Linear Air \
Resistance", 18, Bold], 
           Row[{"Differential equation: ", 
             
             TraditionalForm[$CellContext`mass$$ 
               Derivative[
                1][$CellContext`v][$CellContext`t] == $CellContext`mass$$ \
$CellContext`gravity$ - $CellContext`dragCoefficient$$ \
$CellContext`v[$CellContext`t]]}], 
           Row[{"Terminal velocity: ", 
             NumberForm[
              N[$CellContext`terminalVelocity$], {8, 2}], " m/s"}], 
           Row[{"Time for the velocity gap to shrink to 5%: ", 
             NumberForm[
              N[$CellContext`timeToFivePercentGap$], {7, 2}], " s"}], 
           Plot[{
             $CellContext`velocityModel$[$CellContext`t], \
