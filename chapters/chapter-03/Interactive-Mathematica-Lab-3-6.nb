Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "gravity", ",", "terminalVelocity", ",", "velocityModel", ",", 
       "timeToFivePercentGap"}], "}"}], ",", 
     RowBox[{
      RowBox[{"gravity", "=", "9.81"}], ";", "\[IndentingNewLine]", 
      RowBox[{"terminalVelocity", "=", 
       RowBox[{"mass", " ", 
        RowBox[{"gravity", "/", "dragCoefficient"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"velocityModel", "[", "t_", "]"}], ":=", 
       RowBox[{"terminalVelocity", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"initialVelocity", "-", "terminalVelocity"}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "dragCoefficient"}], " ", 
           RowBox[{"t", "/", "mass"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"timeToFivePercentGap", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"mass", "/", "dragCoefficient"}], ")"}]}], " ", 
        RowBox[{"Log", "[", "0.05", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 3.6: Motion and Linear Air \
Resistance\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Differential equation: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"mass", " ", 
               RowBox[{
                RowBox[{"v", "'"}], "[", "t", "]"}]}], "==", 
              RowBox[{
               RowBox[{"mass", " ", "gravity"}], "-", 
               RowBox[{"dragCoefficient", " ", 
                RowBox[{"v", "[", "t", "]"}]}]}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Terminal velocity: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "terminalVelocity", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"8", ",", "2"}], "}"}]}], "]"}], ",", "\"\< m/s\>\""}],
            "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Time for the velocity gap to shrink to 5%: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "timeToFivePercentGap", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "2"}], "}"}]}], "]"}], ",", "\"\< s\>\""}], 
           "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"velocityModel", "[", "t", "]"}], ",", 
             "terminalVelocity"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "30"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<v(t)\>\"", ",", "\"\<Terminal velocity\>\""}], 
             "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Seconds\>\"", ",", "\"\<m/s\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Velocity with Linear Air Resistance\>\""}]}], "]"}]}], 
        "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mass", ",", "80", ",", "\"\<Mass m (kg)\>\""}], "}"}], ",", 
     "20", ",", "120", ",", "10"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dragCoefficient", ",", "12", ",", "\"\<Drag coefficient c\>\""}], 
      "}"}], ",", "2", ",", "30", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialVelocity", ",", "0", ",", "\"\<Initial downward velocity\>\""}],
       "}"}], ",", "0", ",", "80", ",", "5"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.997476573947912*^9, 3.997476573947912*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"b07e540e-66a6-6d4e-a57c-b6da965de1ce"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`dragCoefficient$$ = 
    12, $CellContext`initialVelocity$$ = 0, $CellContext`mass$$ = 80, 
    Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
    Typeset`bookmarkMode$$ = "Menu", Typeset`animator$$, Typeset`animvar$$ = 
    1, Typeset`name$$ = "\"untitled\"", Typeset`specs$$ = {{{
