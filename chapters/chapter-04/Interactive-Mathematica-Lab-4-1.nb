Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "basis1", ",", "basis2", ",", "wronskianValue", ",", "combination", ",",
        "checks"}], "}"}], ",", 
     RowBox[{
      RowBox[{"basis1", "=", 
       RowBox[{"Exp", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"basis2", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"wronskianValue", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"Det", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"basis1", ",", "basis2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"basis1", ",", "x"}], "]"}], ",", 
             RowBox[{"D", "[", 
              RowBox[{"basis2", ",", "x"}], "]"}]}], "}"}]}], "}"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"combination", "=", 
       RowBox[{
        RowBox[{"c1", " ", "basis1"}], "+", 
        RowBox[{"c2", " ", "basis2"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"checks", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"basis1", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "-", "basis1"}], "==",
            "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"basis2", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "-", "basis2"}], "==",
            "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"combination", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "-", "combination"}], 
           "==", "0"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 4.1: Linearity, Wronskian, \
and Superposition\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Differential equation:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"y", "''"}], "[", "x", "]"}], "-", 
               RowBox[{"y", "[", "x", "]"}]}], "==", "0"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Basis functions:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"{", 
              RowBox[{"basis1", ",", "basis2"}], "}"}], "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Wronskian:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "wronskianValue", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification:   \>\"", ",", "checks"}], "}"}], "]"}], 
         ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Linear combination:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "combination", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"basis1", ",", "basis2", ",", "combination"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Exp[x]\>\"", ",", "\"\<Exp[-x]\>\"", 
              ",", "\"\<c1 Exp[x] + c2 Exp[-x]\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Fundamental Solutions and Superposition\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c1", ",", "1", ",", "\"\<c1\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c2", ",", "1", ",", "\"\<c2\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
