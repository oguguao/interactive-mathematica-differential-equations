     1, StandardForm, 
      "Variables" :> {$CellContext`c1$$ = 1, $CellContext`c2$$ = 1}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`basis1$, $CellContext`basis2$, \
$CellContext`wronskianValue$, $CellContext`combination$, \
$CellContext`checks$}, $CellContext`basis1$ = 
         Exp[$CellContext`x]; $CellContext`basis2$ = 
         Exp[-$CellContext`x]; $CellContext`wronskianValue$ = FullSimplify[
           Det[{{$CellContext`basis1$, $CellContext`basis2$}, {
              D[$CellContext`basis1$, $CellContext`x], 
              
              D[$CellContext`basis2$, $CellContext`x]}}]]; \
$CellContext`combination$ = $CellContext`c1$$ $CellContext`basis1$ + \
$CellContext`c2$$ $CellContext`basis2$; $CellContext`checks$ = 
         FullSimplify[{
           D[$CellContext`basis1$, {$CellContext`x, 
                2}] - $CellContext`basis1$ == 0, 
            D[$CellContext`basis2$, {$CellContext`x, 
                2}] - $CellContext`basis2$ == 0, 
            D[$CellContext`combination$, {$CellContext`x, 
                2}] - $CellContext`combination$ == 0}]; Column[{
           Style[
           "Interactive Mathematica Lab 4.1: Linearity, Wronskian, and \
Superposition", 18, Bold], 
           Row[{"Differential equation:   ", 
             TraditionalForm[
             Derivative[
                2][$CellContext`y][$CellContext`x] - \
$CellContext`y[$CellContext`x] == 0]}], 
           Row[{"Basis functions:   ", 
             TraditionalForm[{$CellContext`basis1$, $CellContext`basis2$}]}], 
           Row[{"Wronskian:   ", 
             TraditionalForm[$CellContext`wronskianValue$]}], 
           Row[{"Verification:   ", $CellContext`checks$}], 
           Row[{"Linear combination:   ", 
             TraditionalForm[$CellContext`combination$]}], 
           
           Plot[{$CellContext`basis1$, $CellContext`basis2$, \
$CellContext`combination$}, {$CellContext`x, -2, 2}, PlotRange -> All, 
            PlotLegends -> {"Exp[x]", "Exp[-x]", "c1 Exp[x] + c2 Exp[-x]"}, 
            AxesLabel -> {"x", "y"}, GridLines -> Automatic, PlotLabel -> 
            "Fundamental Solutions and Superposition"]}]], 
      "Specifications" :> {{{$CellContext`c1$$, 1, "c1"}, -3, 3, 
