        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`label$, $CellContext`root1$, $CellContext`root2$, \
$CellContext`coefficient1$, $CellContext`coefficient2$, \
$CellContext`solution$, $CellContext`verification$}, {$CellContext`label$, \
$CellContext`root1$, $CellContext`root2$} = 
         Part[$CellContext`examples, $CellContext`caseChoice$$]; \
$CellContext`coefficient1$ = ($CellContext`initialSlope$$ - \
$CellContext`root2$ $CellContext`initialValue$$)/($CellContext`root1$ - \
$CellContext`root2$); $CellContext`coefficient2$ = \
$CellContext`initialValue$$ - $CellContext`coefficient1$; \
$CellContext`solution$ = $CellContext`coefficient1$ 
           Exp[$CellContext`root1$ $CellContext`x] + \
$CellContext`coefficient2$ 
           Exp[$CellContext`root2$ $CellContext`x]; \
$CellContext`verification$ = 
         FullSimplify[{
           ReplaceAll[$CellContext`solution$, $CellContext`x -> 
              0] == $CellContext`initialValue$$, ReplaceAll[
              D[$CellContext`solution$, $CellContext`x], $CellContext`x -> 
              0] == $CellContext`initialSlope$$}]; Column[{
           Style[
           "Interactive Mathematica Lab 4.2: Distinct Real Characteristic \
Roots", 18, Bold], 
           Row[{"Root pattern:   ", $CellContext`label$}], 
           Row[{"Characteristic roots:   ", 
             TraditionalForm[{$CellContext`root1$, $CellContext`root2$}]}], 
           Row[{"Solution:   ", 
             
             TraditionalForm[$CellContext`y[$CellContext`x] == \
$CellContext`solution$]}], 
           Row[{"Initial-condition check:   ", $CellContext`verification$}], 
           
           Plot[$CellContext`solution$, {$CellContext`x, 0, 4}, PlotRange -> 
            All, AxesLabel -> {"x", "y"}, GridLines -> Automatic, 
            PlotLabel -> $CellContext`label$]}]], 
      "Specifications" :> {{{$CellContext`caseChoice$$, 1, "Root pattern"}, {
         1 -> "Both negative", 2 -> "Opposite signs", 3 -> 
          "Both positive"}}, {{$CellContext`initialValue$$, 1, "y(0)"}, -2, 2,
          0.5}, {{$CellContext`initialSlope$$, 0, "y'(0)"}, -3, 3, 0.5}}, 
