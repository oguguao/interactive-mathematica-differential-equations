Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"examples", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Both negative\>\"", ",", 
        RowBox[{"-", "2"}], ",", 
        RowBox[{"-", "3"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Opposite signs\>\"", ",", "1", ",", 
        RowBox[{"-", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Both positive\>\"", ",", "1", ",", "3"}], "}"}]}], 
     "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "label", ",", "root1", ",", "root2", ",", "coefficient1", ",", 
       "coefficient2", ",", "solution", ",", "verification"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"label", ",", "root1", ",", "root2"}], "}"}], "=", 
       RowBox[{"examples", "[", 
        RowBox[{"[", "caseChoice", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coefficient1", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"initialSlope", "-", 
          RowBox[{"root2", " ", "initialValue"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"root1", "-", "root2"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coefficient2", "=", 
       RowBox[{"initialValue", "-", "coefficient1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solution", "=", 
       RowBox[{
        RowBox[{"coefficient1", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"root1", " ", "x"}], "]"}]}], "+", 
        RowBox[{"coefficient2", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"root2", " ", "x"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"solution", "/.", " ", 
             RowBox[{"x", "->", "0"}]}], ")"}], "==", "initialValue"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"solution", ",", "x"}], "]"}], "/.", " ", 
             RowBox[{"x", "->", "0"}]}], ")"}], "==", "initialSlope"}]}], 
         "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 4.2: Distinct Real \
Characteristic Roots\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Root pattern:   \>\"", ",", "label"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Characteristic roots:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"{", 
              RowBox[{"root1", ",", "root2"}], "}"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Solution:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "x", "]"}], "==", "solution"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Initial-condition check:   \>\"", ",", 
            "verification"}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{"solution", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0", ",", "4"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotLabel", "->", "label"}]}], "]"}]}], "}"}], "]"}]}]}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"caseChoice", ",", "1", ",", "\"\<Root pattern\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "->", "\"\<Both negative\>\""}], ",", 
       RowBox[{"2", "->", "\"\<Opposite signs\>\""}], ",", 
       RowBox[{"3", "->", "\"\<Both positive\>\""}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialValue", ",", "1", ",", "\"\<y(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialSlope", ",", "0", ",", "\"\<y'(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
