Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "basis1", ",", "basis2", ",", "wronskianValue", ",", "solution", ",", 
       "operatorCheck"}], "}"}], ",", 
     RowBox[{
      RowBox[{"basis1", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"rootValue", " ", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"basis2", "=", 
       RowBox[{"x", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"rootValue", " ", "x"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wronskianValue", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"Det", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"basis1", ",", "basis2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"basis1", ",", "x"}], "]"}], ",", 
             RowBox[{"D", "[", 
              RowBox[{"basis2", ",", "x"}], "]"}]}], "}"}]}], "}"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"solution", "=", 
       RowBox[{
        RowBox[{"c1", " ", "basis1"}], "+", 
        RowBox[{"c2", " ", "basis2"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"operatorCheck", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"solution", ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "-", 
          RowBox[{"2", " ", "rootValue", " ", 
           RowBox[{"D", "[", 
            RowBox[{"solution", ",", "x"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"rootValue", "^", "2"}], " ", "solution"}]}], "==", "0"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 4.3: Repeated Real \
Characteristic Roots\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Repeated root:   \>\"", ",", "rootValue"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Basis functions:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"{", 
              RowBox[{"basis1", ",", "basis2"}], "}"}], "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Wronskian:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "wronskianValue", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification:   \>\"", ",", "operatorCheck"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<General solution:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "solution", "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Plot", "[", 
          RowBox[{"solution", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0", ",", "4"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<Repeated-Root Solution\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rootValue", ",", 
       RowBox[{"-", "1"}], ",", "\"\<Repeated root\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c1", ",", "1", ",", "\"\<c1\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c2", ",", "1", ",", "\"\<c2\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
