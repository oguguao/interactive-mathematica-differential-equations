    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`alpha$$ = -0.5, $CellContext`beta$$ = 
        2, $CellContext`initialSlope$$ = 0, $CellContext`initialValue$$ = 1}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`coefficient1$, $CellContext`coefficient2$, \
$CellContext`solution$, $CellContext`period$, $CellContext`amplitude$, \
$CellContext`upperEnvelope$, $CellContext`lowerEnvelope$, \
$CellContext`verification$}, $CellContext`coefficient1$ = \
$CellContext`initialValue$$; $CellContext`coefficient2$ = \
($CellContext`initialSlope$$ - $CellContext`alpha$$ \
$CellContext`initialValue$$)/$CellContext`beta$$; $CellContext`solution$ = 
         Exp[$CellContext`alpha$$ $CellContext`x] ($CellContext`coefficient1$ 
            Cos[$CellContext`beta$$ $CellContext`x] + \
$CellContext`coefficient2$ 
            Sin[$CellContext`beta$$ $CellContext`x]); $CellContext`period$ = 
         2 (Pi/Abs[$CellContext`beta$$]); $CellContext`amplitude$ = 
         Sqrt[$CellContext`coefficient1$^2 + $CellContext`coefficient2$^2]; \
$CellContext`upperEnvelope$ = $CellContext`amplitude$ 
          Exp[$CellContext`alpha$$ $CellContext`x]; \
$CellContext`lowerEnvelope$ = -$CellContext`upperEnvelope$; \
$CellContext`verification$ = 
         FullSimplify[
          D[$CellContext`solution$, {$CellContext`x, 2}] - 
            2 $CellContext`alpha$$ 
            D[$CellContext`solution$, $CellContext`x] + \
($CellContext`alpha$$^2 + $CellContext`beta$$^2) $CellContext`solution$ == 0]; 
        Column[{
           Style[
           "Interactive Mathematica Lab 4.4: Complex Conjugate Characteristic \
Roots", 18, Bold], 
           Row[{"Characteristic roots:   ", 
             
             TraditionalForm[{$CellContext`alpha$$ + 
               I $CellContext`beta$$, $CellContext`alpha$$ - 
               I $CellContext`beta$$}]}], 
           Row[{"Period:   ", 
             TraditionalForm[$CellContext`period$]}], 
           Row[{"Verification:   ", $CellContext`verification$}], 
           
           Plot[{$CellContext`solution$, $CellContext`upperEnvelope$, \
$CellContext`lowerEnvelope$}, {$CellContext`x, 0, 10}, PlotRange -> All, 
            PlotLegends -> {"Solution", "Upper envelope", "Lower envelope"}, 
            AxesLabel -> {"x", "y"}, GridLines -> Automatic, PlotLabel -> 
            "Oscillatory Solution and Exponential Envelope"]}]], 
      "Specifications" :> {{{$CellContext`alpha$$, -0.5, 
