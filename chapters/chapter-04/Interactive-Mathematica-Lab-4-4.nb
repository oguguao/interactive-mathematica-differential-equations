 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`alpha$$ = -0.5, $CellContext`beta$$ = 
    2, $CellContext`initialSlope$$ = 0, $CellContext`initialValue$$ = 1, 
    Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
    Typeset`bookmarkMode$$ = "Menu", Typeset`animator$$, Typeset`animvar$$ = 
