Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "coefficient1", ",", "coefficient2", ",", "solution", ",", "period", ",",
        "amplitude", ",", "upperEnvelope", ",", "lowerEnvelope", ",", 
       "verification"}], "}"}], ",", 
     RowBox[{
      RowBox[{"coefficient1", "=", "initialValue"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coefficient2", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"initialSlope", "-", 
          RowBox[{"alpha", " ", "initialValue"}]}], ")"}], "/", "beta"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"solution", "=", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"alpha", " ", "x"}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"coefficient1", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"beta", " ", "x"}], "]"}]}], "+", 
          RowBox[{"coefficient2", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"beta", " ", "x"}], "]"}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"period", "=", 
       RowBox[{"2", " ", 
        RowBox[{"Pi", "/", 
         RowBox[{"Abs", "[", "beta", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"amplitude", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"coefficient1", "^", "2"}], "+", 
         RowBox[{"coefficient2", "^", "2"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"upperEnvelope", "=", 
       RowBox[{"amplitude", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"alpha", " ", "x"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lowerEnvelope", "=", 
       RowBox[{"-", "upperEnvelope"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"solution", ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "-", 
          RowBox[{"2", " ", "alpha", " ", 
           RowBox[{"D", "[", 
            RowBox[{"solution", ",", "x"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"alpha", "^", "2"}], "+", 
             RowBox[{"beta", "^", "2"}]}], ")"}], " ", "solution"}]}], "==", 
         "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 4.4: Complex Conjugate \
Characteristic Roots\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Characteristic roots:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"alpha", "+", 
                RowBox[{"I", " ", "beta"}]}], ",", 
               RowBox[{"alpha", "-", 
                RowBox[{"I", " ", "beta"}]}]}], "}"}], "]"}]}], "}"}], "]"}], 
         ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Period:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "period", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification:   \>\"", ",", "verification"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"solution", ",", "upperEnvelope", ",", "lowerEnvelope"}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Solution\>\"", ",", "\"\<Upper envelope\>\"", 
              ",", "\"\<Lower envelope\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Oscillatory Solution and Exponential Envelope\>\""}]}],
           "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"alpha", ",", 
       RowBox[{"-", "0.5"}], ",", "\"\<Real part alpha\>\""}], "}"}], ",", 
     RowBox[{"-", "1.5"}], ",", "1", ",", "0.25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"beta", ",", "2", ",", "\"\<Imaginary magnitude beta\>\""}], 
      "}"}], ",", "0.5", ",", "4", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialValue", ",", "1", ",", "\"\<y(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialSlope", ",", "0", ",", "\"\<y'(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.997477505138775*^9, 3.99747750513978*^9}},
