       Hold[$CellContext`initialValue$$], 1, "y(0)"}, -2, 2, 0.5, ControlType -> 
      Manipulator}, {{
       Hold[$CellContext`initialSlope$$], 0, "y'(0)"}, -3, 3, 0.5, 
      ControlType -> Manipulator}}, Typeset`size$$ = {
    702.650390625, {96.06365676845441, 101.79559036220441`}}, 
