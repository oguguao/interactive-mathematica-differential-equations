Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"solution", ",", "amplitude", ",", "verification"}], "}"}], ",", 
     RowBox[{
      RowBox[{"solution", "=", 
       RowBox[{
        RowBox[{"initialValue", " ", 
         RowBox[{"Cos", "[", "x", "]"}]}], "+", 
        RowBox[{"initialSlope", " ", 
         RowBox[{"Sin", "[", "x", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"amplitude", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"initialValue", "^", "2"}], "+", 
         RowBox[{"initialSlope", "^", "2"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"solution", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "+", "solution"}], "==",
            "0"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"solution", "/.", " ", 
             RowBox[{"x", "->", "0"}]}], ")"}], "==", "initialValue"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"solution", ",", "x"}], "]"}], "/.", 
             "\[IndentingNewLine]", 
             RowBox[{"x", "->", "0"}]}], ")"}], "==", "initialSlope"}]}], 
         "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 4.5: Initial-Value \
Problems for Homogeneous Equations\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Differential equation:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"y", "''"}], "[", "x", "]"}], "+", 
               RowBox[{"y", "[", "x", "]"}]}], "==", "0"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Solution:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "x", "]"}], "==", "solution"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Amplitude:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "amplitude", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification:   \>\"", ",", "verification"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{"solution", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0", ",", 
             RowBox[{"4", " ", "Pi"}]}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Solution Selected by the Initial Conditions\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialValue", ",", "2", ",", "\"\<y(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialSlope", ",", 
       RowBox[{"-", "1"}], ",", "\"\<y'(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9974775367803097`*^9, 3.9974775367803097`*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"a0ecbc4e-b9a8-3f40-89a0-3cd56fa72de6"],

