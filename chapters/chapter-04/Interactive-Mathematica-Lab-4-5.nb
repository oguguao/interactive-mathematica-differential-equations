       Hold[$CellContext`initialValue$$], 2, "y(0)"}, -3, 3, 0.5, ControlType -> 
      Manipulator}, {{
       Hold[$CellContext`initialSlope$$], -1, "y'(0)"}, -3, 3, 0.5, 
      ControlType -> Manipulator}}, Typeset`size$$ = {
    802.5205078125, {108.23827582397432`, 113.97020941772432`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`initialSlope$$ = -1, \
$CellContext`initialValue$$ = 2}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`solution$, $CellContext`amplitude$, \
$CellContext`verification$}, $CellContext`solution$ = \
$CellContext`initialValue$$ Cos[$CellContext`x] + $CellContext`initialSlope$$ 
           Sin[$CellContext`x]; $CellContext`amplitude$ = 
         Sqrt[$CellContext`initialValue$$^2 + $CellContext`initialSlope$$^2]; \
$CellContext`verification$ = 
         FullSimplify[{
           D[$CellContext`solution$, {$CellContext`x, 
                2}] + $CellContext`solution$ == 0, 
            ReplaceAll[$CellContext`solution$, $CellContext`x -> 
              0] == $CellContext`initialValue$$, ReplaceAll[
              D[$CellContext`solution$, $CellContext`x], $CellContext`x -> 
              0] == $CellContext`initialSlope$$}]; Column[{
           Style[
           "Interactive Mathematica Lab 4.5: Initial-Value Problems for \
Homogeneous Equations", 18, Bold], 
           Row[{"Differential equation:   ", 
             TraditionalForm[
             Derivative[
                2][$CellContext`y][$CellContext`x] + \
$CellContext`y[$CellContext`x] == 0]}], 
           Row[{"Solution:   ", 
             
             TraditionalForm[$CellContext`y[$CellContext`x] == \
$CellContext`solution$]}], 
           Row[{"Amplitude:   ", 
             TraditionalForm[$CellContext`amplitude$]}], 
           Row[{"Verification:   ", $CellContext`verification$}], 
           
           Plot[$CellContext`solution$, {$CellContext`x, 0, 4 Pi}, PlotRange -> 
            All, AxesLabel -> {"x", "y"}, GridLines -> Automatic, PlotLabel -> 
            "Solution Selected by the Initial Conditions"]}]], 
      "Specifications" :> {{{$CellContext`initialValue$$, 2, "y(0)"}, -3, 3, 
