 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`initialSlope$$ = -1, \
$CellContext`initialValue$$ = 2, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
