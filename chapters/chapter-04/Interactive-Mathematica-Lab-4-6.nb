Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "complementary", ",", "particular", ",", "completeSolution", ",", 
       "checks"}], "}"}], ",", 
     RowBox[{
      RowBox[{"complementary", "=", 
       RowBox[{
        RowBox[{"c1", " ", 
         RowBox[{"Exp", "[", "x", "]"}]}], "+", 
        RowBox[{"c2", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "x"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"particular", "=", 
       RowBox[{
        RowBox[{"forcingAmplitude", "/", "3"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", " ", "x"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"completeSolution", "=", 
       RowBox[{"complementary", "+", "particular"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"checks", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"complementary", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "-", 
            "complementary"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"particular", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "-", "particular"}], "==", 
           RowBox[{"forcingAmplitude", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"2", " ", "x"}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"completeSolution", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "-", 
            "completeSolution"}], "==", 
           RowBox[{"forcingAmplitude", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"2", " ", "x"}], "]"}]}]}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 4.6: Nonhomogeneous \
Solution Decomposition\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Complementary solution:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "complementary", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Particular solution:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "particular", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Complete solution:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "completeSolution", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification:   \>\"", ",", "checks"}], "}"}], "]"}], 
         ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "complementary", ",", "particular", ",", "completeSolution"}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Complementary yc\>\"", ",", "\"\<Particular yp\>\"",
               ",", "\"\<Complete yc + yp\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Complementary + Particular Solution\>\""}]}], "]"}]}], 
        "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "forcingAmplitude", ",", "1", ",", "\"\<Forcing amplitude\>\""}], "}"}],
      ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c1", ",", "1", ",", "\"\<c1\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c2", ",", "0", ",", "\"\<c2\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
