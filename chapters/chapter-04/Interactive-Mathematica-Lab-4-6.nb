        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`complementary$, $CellContext`particular$, \
$CellContext`completeSolution$, $CellContext`checks$}, \
$CellContext`complementary$ = $CellContext`c1$$ 
           Exp[$CellContext`x] + $CellContext`c2$$ 
           Exp[-$CellContext`x]; $CellContext`particular$ = \
($CellContext`forcingAmplitude$$/3) 
          Exp[2 $CellContext`x]; $CellContext`completeSolution$ = \
$CellContext`complementary$ + $CellContext`particular$; $CellContext`checks$ = 
