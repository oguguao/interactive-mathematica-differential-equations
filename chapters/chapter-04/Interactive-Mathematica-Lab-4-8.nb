Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "basis1", ",", "basis2", ",", "forcing", ",", "intervalLeft", ",", 
       "intervalRight", ",", "wronskianValue", ",", "parameter1", ",", 
       "parameter2", ",", "particular", ",", "verification"}], "}"}], ",", 
     RowBox[{
      RowBox[{"basis1", "=", 
       RowBox[{"Cos", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"basis2", "=", 
       RowBox[{"Sin", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Switch", "[", 
       RowBox[{"forcingChoice", ",", "\"\<Sec[x]\>\"", ",", 
        RowBox[{
         RowBox[{"forcing", "=", 
          RowBox[{"Sec", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"intervalLeft", "=", 
          RowBox[{"-", "1.4"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"intervalRight", "=", "1.4"}]}], ",", "\"\<Exp[x]\>\"", ",", 
        RowBox[{
         RowBox[{"forcing", "=", 
          RowBox[{"Exp", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"intervalLeft", "=", 
          RowBox[{"-", "2"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"intervalRight", "=", "2"}]}], ",", "\"\<x\>\"", ",", 
        RowBox[{
         RowBox[{"forcing", "=", "x"}], ";", "\[IndentingNewLine]", 
         RowBox[{"intervalLeft", "=", 
          RowBox[{"-", "3"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"intervalRight", "=", "3"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wronskianValue", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"Det", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"basis1", ",", "basis2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"basis1", ",", "x"}], "]"}], ",", 
             RowBox[{"D", "[", 
              RowBox[{"basis2", ",", "x"}], "]"}]}], "}"}]}], "}"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"parameter1", "=", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "basis2"}], " ", 
          RowBox[{"forcing", "/", "wronskianValue"}]}], ",", "x"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"parameter2", "=", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"basis1", " ", 
          RowBox[{"forcing", "/", "wronskianValue"}]}], ",", "x"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"particular", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"basis1", " ", "parameter1"}], "+", 
          RowBox[{"basis2", " ", "parameter2"}]}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"forcingChoice", "==", "\"\<Sec[x]\>\""}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "Pi"}], "/", "2"}], "<", "x", "<", 
             RowBox[{"Pi", "/", "2"}]}], ",", 
            RowBox[{"Element", "[", 
             RowBox[{"x", ",", "Reals"}], "]"}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"particular", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "+", "particular"}], "==",
           "forcing"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"forcingChoice", "==", "\"\<Sec[x]\>\""}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "Pi"}], "/", "2"}], "<", "x", "<", 
             RowBox[{"Pi", "/", "2"}]}], ",", 
            RowBox[{"Element", "[", 
             RowBox[{"x", ",", "Reals"}], "]"}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 4.8: Variation of \
Parameters\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Forcing function:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "forcing", "]"}]}], "}"}], "]"}], 
         ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Fundamental set:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"{", 
              RowBox[{"basis1", ",", "basis2"}], "}"}], "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Wronskian:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "wronskianValue", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<u1:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "parameter1", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<u2:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "parameter2", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Particular solution:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "particular", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification:   \>\"", ",", "verification"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{"particular", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "intervalLeft", ",", "intervalRight"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<yp(x)\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Particular Solution from Variation of \
Parameters\>\""}]}], "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "forcingChoice", ",", "\"\<Sec[x]\>\"", 
       ",", "\"\<Choose forcing function\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Sec[x]\>\"", ",", "\"\<Exp[x]\>\"", ",", "\"\<x\>\""}], 
      "}"}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9974776370300045`*^9, 3.9974776370300045`*^9}},
