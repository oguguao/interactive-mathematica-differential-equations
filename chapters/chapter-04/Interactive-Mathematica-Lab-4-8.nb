Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`forcingChoice$$ = "Sec[x]", Typeset`show$$ =
     True, Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`forcingChoice$$], "Sec[x]", 
       "Choose forcing function"}, {"Sec[x]", "Exp[x]", "x"}, ControlType -> 
      SetterBar}}, Typeset`size$$ = {
    554.203125, {136.56596825803913`, 142.29790185178913`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`forcingChoice$$ = "Sec[x]"}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`basis1$, $CellContext`basis2$, \
$CellContext`forcing$, $CellContext`intervalLeft$, \
$CellContext`intervalRight$, $CellContext`wronskianValue$, \
$CellContext`parameter1$, $CellContext`parameter2$, $CellContext`particular$, \
$CellContext`verification$}, $CellContext`basis1$ = 
         Cos[$CellContext`x]; $CellContext`basis2$ = Sin[$CellContext`x]; 
        Switch[$CellContext`forcingChoice$$, 
          "Sec[x]", $CellContext`forcing$ = 
           Sec[$CellContext`x]; $CellContext`intervalLeft$ = -1.4; \
$CellContext`intervalRight$ = 1.4, 
          "Exp[x]", $CellContext`forcing$ = 
           Exp[$CellContext`x]; $CellContext`intervalLeft$ = -2; \
$CellContext`intervalRight$ = 2, 
          "x", $CellContext`forcing$ = $CellContext`x; \
$CellContext`intervalLeft$ = -3; $CellContext`intervalRight$ = 
           3]; $CellContext`wronskianValue$ = FullSimplify[
           Det[{{$CellContext`basis1$, $CellContext`basis2$}, {
              D[$CellContext`basis1$, $CellContext`x], 
              
              D[$CellContext`basis2$, $CellContext`x]}}]]; \
$CellContext`parameter1$ = 
         Integrate[(-$CellContext`basis2$) \
($CellContext`forcing$/$CellContext`wronskianValue$), $CellContext`x]; \
$CellContext`parameter2$ = 
         Integrate[$CellContext`basis1$ \
($CellContext`forcing$/$CellContext`wronskianValue$), $CellContext`x]; \
$CellContext`particular$ = 
         FullSimplify[$CellContext`basis1$ $CellContext`parameter1$ + \
$CellContext`basis2$ $CellContext`parameter2$, Assumptions -> 
           If[$CellContext`forcingChoice$$ == 
             "Sec[x]", (-Pi)/2 < $CellContext`x < Pi/2, 
             Element[$CellContext`x, Reals]]]; $CellContext`verification$ = 
         FullSimplify[
          D[$CellContext`particular$, {$CellContext`x, 
               2}] + $CellContext`particular$ == $CellContext`forcing$, 
           Assumptions -> 
           If[$CellContext`forcingChoice$$ == 
             "Sec[x]", (-Pi)/2 < $CellContext`x < Pi/2, 
             Element[$CellContext`x, Reals]]]; Column[{
           Style[
           "Interactive Mathematica Lab 4.8: Variation of Parameters", 18, 
            Bold], 
           Row[{"Forcing function:   ", 
             TraditionalForm[$CellContext`forcing$]}], 
           Row[{"Fundamental set:   ", 
             TraditionalForm[{$CellContext`basis1$, $CellContext`basis2$}]}], 
           Row[{"Wronskian:   ", 
             TraditionalForm[$CellContext`wronskianValue$]}], 
           Row[{"u1:   ", 
             TraditionalForm[$CellContext`parameter1$]}], 
           Row[{"u2:   ", 
             TraditionalForm[$CellContext`parameter2$]}], 
           Row[{"Particular solution:   ", 
             TraditionalForm[$CellContext`particular$]}], 
           Row[{"Verification:   ", $CellContext`verification$}], 
           
           Plot[$CellContext`particular$, {$CellContext`x, \
$CellContext`intervalLeft$, $CellContext`intervalRight$}, PlotRange -> All, 
            AxesLabel -> {"x", "yp(x)"}, GridLines -> Automatic, PlotLabel -> 
            "Particular Solution from Variation of Parameters"]}]], 
      "Specifications" :> {{{$CellContext`forcingChoice$$, "Sec[x]", 
          "Choose forcing function"}, {"Sec[x]", "Exp[x]", "x"}, ControlType -> 
         SetterBar}}, "Options" :> {}, "DefaultOptions" :> {}],
