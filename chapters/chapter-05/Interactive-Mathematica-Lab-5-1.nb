Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "forcingFunction", ",", "solution", ",", "modelType", ",", 
       "naturalFrequency"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"forcingFunction", "[", "t_", "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"forcingAmplitude", "==", "0"}], ",", "0", ",", 
         RowBox[{"forcingAmplitude", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"forcingFrequency", " ", "t"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"naturalFrequency", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"springConstant", "/", "mass"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"modelType", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dampingCoefficient", "==", "0"}], "&&", 
          RowBox[{"forcingAmplitude", "==", "0"}]}], 
         ",", "\"\<Free undamped\>\"", ",", 
         RowBox[{
          RowBox[{"dampingCoefficient", ">", "0"}], "&&", 
          RowBox[{"forcingAmplitude", "==", "0"}]}], 
         ",", "\"\<Free damped\>\"", ",", 
         RowBox[{
          RowBox[{"dampingCoefficient", "==", "0"}], "&&", 
          RowBox[{"forcingAmplitude", "!=", "0"}]}], 
         ",", "\"\<Forced undamped\>\"", ",", "True", 
         ",", "\"\<Forced damped\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"solution", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"mass", " ", 
              RowBox[{
               RowBox[{"x", "''"}], "[", "t", "]"}]}], "+", 
             RowBox[{"dampingCoefficient", " ", 
              RowBox[{
               RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
             RowBox[{"springConstant", " ", 
              RowBox[{"x", "[", "t", "]"}]}]}], "==", 
            RowBox[{"forcingFunction", "[", "t", "]"}]}], ",", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], "==", "initialDisplacement"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "0", "]"}], "==", "initialVelocity"}]}],
           "}"}], ",", "x", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 5.1: Modeling Spring-Mass \
Systems\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Classification: \>\"", ",", "modelType"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Natural angular frequency: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "naturalFrequency", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Model: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"mass", " ", 
                RowBox[{
                 RowBox[{"x", "''"}], "[", "t", "]"}]}], "+", 
               RowBox[{"dampingCoefficient", " ", 
                RowBox[{
                 RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
               RowBox[{"springConstant", " ", 
                RowBox[{"x", "[", "t", "]"}]}]}], "==", 
              RowBox[{"forcingFunction", "[", "t", "]"}]}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Initial conditions: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "[", "0", "]"}], "==", "initialDisplacement"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"x", "'"}], "[", "0", "]"}], "==", 
                "initialVelocity"}]}], "}"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"solution", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", "\"\<Displacement\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotLabel", "->", "modelType"}]}], "]"}]}], "}"}], 
       "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mass", ",", "2", ",", "\"\<Mass m\>\""}], "}"}], ",", "0.5", ",",
      "5", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dampingCoefficient", ",", "3", ",", "\"\<Damping coefficient c\>\""}], 
      "}"}], ",", "0", ",", "8", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"springConstant", ",", "8", ",", "\"\<Spring constant k\>\""}], 
      "}"}], ",", "1", ",", "20", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "forcingAmplitude", ",", "4", ",", "\"\<Forcing amplitude\>\""}], "}"}],
      ",", "0", ",", "10", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "forcingFrequency", ",", "2", ",", "\"\<Forcing frequency\>\""}], "}"}],
      ",", "0.5", ",", "5", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialDisplacement", ",", "0.5", 
       ",", "\"\<Initial displacement\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialVelocity", ",", "0", ",", "\"\<Initial velocity\>\""}], 
      "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.997478059691065*^9, 3.997478059691065*^9}},
 CellLabel->
