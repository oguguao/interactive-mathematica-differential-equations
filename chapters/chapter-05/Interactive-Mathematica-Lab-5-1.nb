Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`dampingCoefficient$$ = 
    3, $CellContext`forcingAmplitude$$ = 4, $CellContext`forcingFrequency$$ = 
    2, $CellContext`initialDisplacement$$ = 
    0.5, $CellContext`initialVelocity$$ = 0, $CellContext`mass$$ = 
    2, $CellContext`springConstant$$ = 8, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`mass$$], 2, "Mass m"}, 0.5, 5, 0.5, ControlType -> 
      Manipulator}, {{
       Hold[$CellContext`dampingCoefficient$$], 3, "Damping coefficient c"}, 
      0, 8, 0.5, ControlType -> Manipulator}, {{
       Hold[$CellContext`springConstant$$], 8, "Spring constant k"}, 1, 20, 1,
       ControlType -> Manipulator}, {{
       Hold[$CellContext`forcingAmplitude$$], 4, "Forcing amplitude"}, 0, 10, 
      1, ControlType -> Manipulator}, {{
       Hold[$CellContext`forcingFrequency$$], 2, "Forcing frequency"}, 0.5, 5,
       0.5, ControlType -> Manipulator}, {{
       Hold[$CellContext`initialDisplacement$$], 0.5, 
       "Initial displacement"}, -2, 2, 0.25, ControlType -> Manipulator}, {{
       Hold[$CellContext`initialVelocity$$], 0, "Initial velocity"}, -3, 3, 
      0.5, ControlType -> Manipulator}}, Typeset`size$$ = {
    604.5908203125, {95.11710823202719, 100.84904182577719`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`dampingCoefficient$$ = 
        3, $CellContext`forcingAmplitude$$ = 
        4, $CellContext`forcingFrequency$$ = 
        2, $CellContext`initialDisplacement$$ = 
        0.5, $CellContext`initialVelocity$$ = 0, $CellContext`mass$$ = 
        2, $CellContext`springConstant$$ = 8}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`forcingFunction$, $CellContext`solution$, \
$CellContext`modelType$, $CellContext`naturalFrequency$}, \
$CellContext`forcingFunction$[
           Pattern[$CellContext`t$, 
            Blank[]]] := 
         If[$CellContext`forcingAmplitude$$ == 0, 
           0, $CellContext`forcingAmplitude$$ 
           Cos[$CellContext`forcingFrequency$$ $CellContext`t$]]; \
$CellContext`naturalFrequency$ = 
         Sqrt[$CellContext`springConstant$$/$CellContext`mass$$]; \
$CellContext`modelType$ = Which[
           
           And[$CellContext`dampingCoefficient$$ == 
            0, $CellContext`forcingAmplitude$$ == 0], "Free undamped", 
           
           And[$CellContext`dampingCoefficient$$ > 
            0, $CellContext`forcingAmplitude$$ == 0], "Free damped", 
           
           And[$CellContext`dampingCoefficient$$ == 
            0, $CellContext`forcingAmplitude$$ != 0], "Forced undamped", True,
            "Forced damped"]; $CellContext`solution$ = 
         NDSolveValue[{$CellContext`mass$$ 
              Derivative[
               2][$CellContext`x][$CellContext`t] + \
$CellContext`dampingCoefficient$$ 
              Derivative[
               1][$CellContext`x][$CellContext`t] + \
$CellContext`springConstant$$ $CellContext`x[$CellContext`t] == \
$CellContext`forcingFunction$[$CellContext`t], $CellContext`x[
             0] == $CellContext`initialDisplacement$$, 
            Derivative[1][$CellContext`x][
             0] == $CellContext`initialVelocity$$}, $CellContext`x, \
{$CellContext`t, 0, 20}]; Column[{
           Style[
           "Interactive Mathematica Lab 5.1: Modeling Spring-Mass Systems", 
            18, Bold], 
           Row[{"Classification: ", $CellContext`modelType$}], 
           Row[{"Natural angular frequency: ", 
             NumberForm[
              N[$CellContext`naturalFrequency$], {7, 3}]}], 
           Row[{"Model: ", 
             
             TraditionalForm[$CellContext`mass$$ 
                Derivative[
                 
                 2][$CellContext`x][$CellContext`t] + \
$CellContext`dampingCoefficient$$ 
                Derivative[
                 1][$CellContext`x][$CellContext`t] + \
$CellContext`springConstant$$ $CellContext`x[$CellContext`t] == \
$CellContext`forcingFunction$[$CellContext`t]]}], 
           Row[{"Initial conditions: ", 
             
             TraditionalForm[{$CellContext`x[
                0] == $CellContext`initialDisplacement$$, 
               Derivative[1][$CellContext`x][
                0] == $CellContext`initialVelocity$$}]}], 
           Plot[
            $CellContext`solution$[$CellContext`t], {$CellContext`t, 0, 20}, 
            PlotRange -> All, AxesLabel -> {"Time", "Displacement"}, 
            GridLines -> Automatic, PlotLabel -> $CellContext`modelType$]}]], 
      "Specifications" :> {{{$CellContext`mass$$, 2, "Mass m"}, 0.5, 5, 
         0.5}, {{$CellContext`dampingCoefficient$$, 3, 
          "Damping coefficient c"}, 0, 8, 
         0.5}, {{$CellContext`springConstant$$, 8, "Spring constant k"}, 1, 
         20, 1}, {{$CellContext`forcingAmplitude$$, 4, "Forcing amplitude"}, 
         0, 10, 1}, {{$CellContext`forcingFrequency$$, 2, 
          "Forcing frequency"}, 0.5, 5, 
         0.5}, {{$CellContext`initialDisplacement$$, 0.5, 
          "Initial displacement"}, -2, 2, 
         0.25}, {{$CellContext`initialVelocity$$, 0, "Initial velocity"}, -3, 
         3, 0.5}}, "Options" :> {}, "DefaultOptions" :> {}],
