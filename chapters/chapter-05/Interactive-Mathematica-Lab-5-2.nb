Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "naturalFrequency", ",", "coefficient1", ",", "coefficient2", ",", 
       "amplitude", ",", "period", ",", "ordinaryFrequency", ",", 
       "displacement", ",", "velocity", ",", "energy", ",", 
       "simplifiedEnergy"}], "}"}], ",", 
     RowBox[{
      RowBox[{"naturalFrequency", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"springConstant", "/", "mass"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coefficient1", "=", "initialDisplacement"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coefficient2", "=", 
       RowBox[{"initialVelocity", "/", "naturalFrequency"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"amplitude", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"coefficient1", "^", "2"}], "+", 
         RowBox[{"coefficient2", "^", "2"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"period", "=", 
       RowBox[{"2", " ", 
        RowBox[{"Pi", "/", "naturalFrequency"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ordinaryFrequency", "=", 
       RowBox[{"1", "/", "period"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"displacement", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{"coefficient1", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"naturalFrequency", " ", "t"}], "]"}]}], "+", 
        RowBox[{"coefficient2", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"naturalFrequency", " ", "t"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"velocity", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "coefficient1"}], " ", "naturalFrequency", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"naturalFrequency", " ", "t"}], "]"}]}], "+", 
        RowBox[{"coefficient2", " ", "naturalFrequency", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"naturalFrequency", " ", "t"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"energy", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "mass", " ", 
         RowBox[{
          RowBox[{"velocity", "[", "t", "]"}], "^", "2"}]}], "+", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "springConstant", " ", 
         RowBox[{
          RowBox[{"displacement", "[", "t", "]"}], "^", "2"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"simplifiedEnergy", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"energy", "[", "t", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 5.2: Free Undamped \
Motion\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Natural angular frequency: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "naturalFrequency", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Amplitude: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "amplitude", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Period: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "period", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Ordinary frequency: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "ordinaryFrequency", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Total mechanical energy: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "simplifiedEnergy", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"displacement", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", 
             RowBox[{"4", " ", "period"}]}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", "\"\<Displacement\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<Free Undamped Motion\>\""}]}], 
          "]"}], ",", 
         RowBox[{"ParametricPlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"displacement", "[", "t", "]"}], ",", 
             RowBox[{"velocity", "[", "t", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", 
             RowBox[{"4", " ", "period"}]}], "}"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Displacement\>\"", ",", "\"\<Velocity\>\""}], 
             "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<Undamped Phase Curve\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mass", ",", "1", ",", "\"\<Mass m\>\""}], "}"}], ",", "0.5", ",",
      "5", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"springConstant", ",", "9", ",", "\"\<Spring constant k\>\""}], 
      "}"}], ",", "1", ",", "20", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialDisplacement", ",", "2", ",", "\"\<Initial displacement\>\""}], 
      "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialVelocity", ",", "0", ",", "\"\<Initial velocity\>\""}], 
      "}"}], ",", 
     RowBox[{"-", "4"}], ",", "4", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
