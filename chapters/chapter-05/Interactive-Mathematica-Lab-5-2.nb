       Hold[$CellContext`springConstant$$], 9, "Spring constant k"}, 1, 20, 1,
       ControlType -> Manipulator}, {{
       Hold[$CellContext`initialDisplacement$$], 2, 
       "Initial displacement"}, -3, 3, 0.5, ControlType -> Manipulator}, {{
       Hold[$CellContext`initialVelocity$$], 0, "Initial velocity"}, -4, 4, 
      0.5, ControlType -> Manipulator}}, Typeset`size$$ = {
    524.513671875, {222.7082137706156, 228.4401473643656}}, Typeset`update$$ =
     0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`initialDisplacement$$ = 
        2, $CellContext`initialVelocity$$ = 0, $CellContext`mass$$ = 
        1, $CellContext`springConstant$$ = 9}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`naturalFrequency$, $CellContext`coefficient1$, \
$CellContext`coefficient2$, $CellContext`amplitude$, $CellContext`period$, \
$CellContext`ordinaryFrequency$, $CellContext`displacement$, \
$CellContext`velocity$, $CellContext`energy$, \
$CellContext`simplifiedEnergy$}, $CellContext`naturalFrequency$ = 
         Sqrt[$CellContext`springConstant$$/$CellContext`mass$$]; \
$CellContext`coefficient1$ = $CellContext`initialDisplacement$$; \
$CellContext`coefficient2$ = \
$CellContext`initialVelocity$$/$CellContext`naturalFrequency$; \
$CellContext`amplitude$ = 
         Sqrt[$CellContext`coefficient1$^2 + $CellContext`coefficient2$^2]; \
$CellContext`period$ = 
         2 (Pi/$CellContext`naturalFrequency$); \
$CellContext`ordinaryFrequency$ = 
         1/$CellContext`period$; $CellContext`displacement$[
           Pattern[$CellContext`t$, 
            Blank[]]] := $CellContext`coefficient1$ 
           Cos[$CellContext`naturalFrequency$ $CellContext`t$] + \
$CellContext`coefficient2$ 
           Sin[$CellContext`naturalFrequency$ $CellContext`t$]; \
$CellContext`velocity$[
           Pattern[$CellContext`t$, 
            
            Blank[]]] := (-$CellContext`coefficient1$) \
$CellContext`naturalFrequency$ 
           Sin[$CellContext`naturalFrequency$ $CellContext`t$] + \
$CellContext`coefficient2$ $CellContext`naturalFrequency$ 
           Cos[$CellContext`naturalFrequency$ $CellContext`t$]; \
$CellContext`energy$[
           Pattern[$CellContext`t$, 
            Blank[]]] := (1/
            2) $CellContext`mass$$ $CellContext`velocity$[$CellContext`t$]^2 + \
(1/2) $CellContext`springConstant$$ \
$CellContext`displacement$[$CellContext`t$]^2; $CellContext`simplifiedEnergy$ = 
         FullSimplify[
           $CellContext`energy$[$CellContext`t]]; Column[{
           Style[
           "Interactive Mathematica Lab 5.2: Free Undamped Motion", 18, Bold], 
           Row[{"Natural angular frequency: ", 
             TraditionalForm[$CellContext`naturalFrequency$]}], 
           Row[{"Amplitude: ", 
             TraditionalForm[$CellContext`amplitude$]}], 
           Row[{"Period: ", 
             TraditionalForm[$CellContext`period$]}], 
           Row[{"Ordinary frequency: ", 
             TraditionalForm[$CellContext`ordinaryFrequency$]}], 
           Row[{"Total mechanical energy: ", 
             TraditionalForm[$CellContext`simplifiedEnergy$]}], 
           Plot[
            $CellContext`displacement$[$CellContext`t], {$CellContext`t, 0, 
             4 $CellContext`period$}, PlotRange -> All, 
            AxesLabel -> {"Time", "Displacement"}, GridLines -> Automatic, 
            PlotLabel -> "Free Undamped Motion"], 
           ParametricPlot[{
             $CellContext`displacement$[$CellContext`t], 
             $CellContext`velocity$[$CellContext`t]}, {$CellContext`t, 0, 
             4 $CellContext`period$}, 
            AxesLabel -> {"Displacement", "Velocity"}, PlotLabel -> 
            "Undamped Phase Curve"]}]], 
      "Specifications" :> {{{$CellContext`mass$$, 1, "Mass m"}, 0.5, 5, 
