       Hold[$CellContext`springConstant$$], 4, "Spring constant k"}, 1, 12, 1,
       ControlType -> Manipulator}, {{
       Hold[$CellContext`dampingCoefficient$$], 0, "Damping coefficient c"}, 
      0, 2, 0.25, ControlType -> Manipulator}, {{
       Hold[$CellContext`forcingAmplitude$$], 1, "Forcing amplitude"}, 0.5, 3,
       0.5, ControlType -> Manipulator}, {{
       Hold[$CellContext`forcingFrequency$$], 2, "Forcing frequency"}, 0.5, 4,
       0.1, ControlType -> Manipulator}}, Typeset`size$$ = {
    593.7890625, {95.38434004938112, 101.11627364313112`}}, Typeset`update$$ =
     0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`dampingCoefficient$$ = 
        0, $CellContext`forcingAmplitude$$ = 
        1, $CellContext`forcingFrequency$$ = 2, $CellContext`mass$$ = 
        1, $CellContext`springConstant$$ = 4}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`response$, $CellContext`naturalFrequency$, \
$CellContext`forcingFunction$, $CellContext`frequencyDifference$, \
$CellContext`description$}, $CellContext`naturalFrequency$ = 
         Sqrt[$CellContext`springConstant$$/$CellContext`mass$$]; \
$CellContext`forcingFunction$[
           Pattern[$CellContext`t$, 
            Blank[]]] := $CellContext`forcingAmplitude$$ 
          Cos[$CellContext`forcingFrequency$$ $CellContext`t$]; \
$CellContext`frequencyDifference$ = $CellContext`forcingFrequency$$ - \
$CellContext`naturalFrequency$; $CellContext`description$ = Which[
           
           And[$CellContext`dampingCoefficient$$ == 0, 
            Abs[$CellContext`frequencyDifference$] < 10^(-8)], 
           "Ideal undamped resonance", 
           
           And[$CellContext`dampingCoefficient$$ == 0, 
            Abs[$CellContext`frequencyDifference$] < 0.3], 
           "Near resonance / possible beats", \
$CellContext`dampingCoefficient$$ > 0, "Damped forced response", True, 
           "Nonresonant forced response"]; $CellContext`response$ = 
         NDSolveValue[{$CellContext`mass$$ 
              Derivative[
               2][$CellContext`x][$CellContext`t] + \
$CellContext`dampingCoefficient$$ 
              Derivative[
               1][$CellContext`x][$CellContext`t] + \
$CellContext`springConstant$$ $CellContext`x[$CellContext`t] == \
$CellContext`forcingFunction$[$CellContext`t], $CellContext`x[0] == 0, 
            Derivative[1][$CellContext`x][0] == 
            0}, $CellContext`x, {$CellContext`t, 0, 40}]; Column[{
           Style[
           "Interactive Mathematica Lab 5.4: Forced Motion and Resonance", 18,
             Bold], 
           Row[{"Natural angular frequency: ", 
             NumberForm[
              N[$CellContext`naturalFrequency$], {6, 3}]}], 
           
           Row[{"Forcing angular frequency: ", \
$CellContext`forcingFrequency$$}], 
           Row[{"Frequency difference: ", 
             NumberForm[
              N[$CellContext`frequencyDifference$], {6, 3}]}], 
           Row[{"Response type: ", $CellContext`description$}], 
           Plot[
            $CellContext`response$[$CellContext`t], {$CellContext`t, 0, 40}, 
            PlotRange -> All, AxesLabel -> {"Time", "Displacement"}, 
            GridLines -> Automatic, 
            PlotLabel -> $CellContext`description$]}]], 
      "Specifications" :> {{{$CellContext`mass$$, 1, "Mass m"}, 1, 3, 
         0.5}, {{$CellContext`springConstant$$, 4, "Spring constant k"}, 1, 
         12, 1}, {{$CellContext`dampingCoefficient$$, 0, 
          "Damping coefficient c"}, 0, 2, 
         0.25}, {{$CellContext`forcingAmplitude$$, 1, "Forcing amplitude"}, 
