Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "response", ",", "naturalFrequency", ",", "forcingFunction", ",", 
       "frequencyDifference", ",", "description"}], "}"}], ",", 
     RowBox[{
      RowBox[{"naturalFrequency", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"springConstant", "/", "mass"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"forcingFunction", "[", "t_", "]"}], ":=", 
       RowBox[{"forcingAmplitude", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"forcingFrequency", " ", "t"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"frequencyDifference", "=", 
       RowBox[{"forcingFrequency", "-", "naturalFrequency"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"description", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dampingCoefficient", "==", "0"}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", "frequencyDifference", "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}]}]}], ",", "\"\<Ideal undamped resonance\>\"",
          ",", 
         RowBox[{
          RowBox[{"dampingCoefficient", "==", "0"}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", "frequencyDifference", "]"}], "<", "0.3"}]}], 
         ",", "\"\<Near resonance / possible beats\>\"", ",", 
         RowBox[{"dampingCoefficient", ">", "0"}], 
         ",", "\"\<Damped forced response\>\"", ",", "True", 
         ",", "\"\<Nonresonant forced response\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"response", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"mass", " ", 
              RowBox[{
               RowBox[{"x", "''"}], "[", "t", "]"}]}], "+", 
             RowBox[{"dampingCoefficient", " ", 
              RowBox[{
               RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
             RowBox[{"springConstant", " ", 
              RowBox[{"x", "[", "t", "]"}]}]}], "==", 
            RowBox[{"forcingFunction", "[", "t", "]"}]}], ",", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
         "x", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "40"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 5.4: Forced Motion and \
Resonance\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Natural angular frequency: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "naturalFrequency", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"6", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Forcing angular frequency: \>\"", ",", 
            "forcingFrequency"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Frequency difference: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "frequencyDifference", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"6", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Response type: \>\"", ",", "description"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"response", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "40"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", "\"\<Displacement\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotLabel", "->", "description"}]}], "]"}]}], "}"}], 
       "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mass", ",", "1", ",", "\"\<Mass m\>\""}], "}"}], ",", "1", ",",
      "3", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"springConstant", ",", "4", ",", "\"\<Spring constant k\>\""}], 
      "}"}], ",", "1", ",", "12", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dampingCoefficient", ",", "0", ",", "\"\<Damping coefficient c\>\""}], 
      "}"}], ",", "0", ",", "2", ",", "0.25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "forcingAmplitude", ",", "1", ",", "\"\<Forcing amplitude\>\""}], "}"}],
      ",", "0.5", ",", "3", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "forcingFrequency", ",", "2", ",", "\"\<Forcing frequency\>\""}], "}"}],
      ",", "0.5", ",", "4", ",", "0.1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.997478160447075*^9, 3.997478160447075*^9}},
