 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`dampingCoefficient$$ = 
    0, $CellContext`forcingAmplitude$$ = 1, $CellContext`forcingFrequency$$ = 
    2, $CellContext`mass$$ = 1, $CellContext`springConstant$$ = 4, 
    Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
