Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "voltageFunction", ",", "charge", ",", "current", ",", 
       "criticalResistance", ",", "discriminant", ",", "classification"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"voltageFunction", "[", "t_", "]"}], ":=", 
       RowBox[{"voltageAmplitude", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"forcingFrequency", " ", "t"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"criticalResistance", "=", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"inductance", "/", "capacitance"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"discriminant", "=", 
       RowBox[{
        RowBox[{"resistance", "^", "2"}], "-", 
        RowBox[{"4", " ", 
         RowBox[{"inductance", "/", "capacitance"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"classification", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"discriminant", "<", "0"}], ",", "\"\<Underdamped\>\"", ",", 
         RowBox[{
          RowBox[{"Chop", "[", "discriminant", "]"}], "==", "0"}], 
         ",", "\"\<Critically damped\>\"", ",", 
         RowBox[{"discriminant", ">", "0"}], ",", "\"\<Overdamped\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"charge", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"inductance", " ", 
              RowBox[{
               RowBox[{"q", "''"}], "[", "t", "]"}]}], "+", 
             RowBox[{"resistance", " ", 
              RowBox[{
               RowBox[{"q", "'"}], "[", "t", "]"}]}], "+", 
             RowBox[{
              RowBox[{"q", "[", "t", "]"}], "/", "capacitance"}]}], "==", 
            RowBox[{"voltageFunction", "[", "t", "]"}]}], ",", 
           RowBox[{
            RowBox[{"q", "[", "0", "]"}], "==", "initialCharge"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"q", "'"}], "[", "0", "]"}], "==", "initialCurrent"}]}], 
          "}"}], ",", "q", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"current", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{"charge", "'"}], "[", "t", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 5.5: Series RLC Circuits\>\
\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Source-free classification: \>\"", ",", 
            "classification"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Critical resistance: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "criticalResistance", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Circuit equation: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"inductance", " ", 
                RowBox[{
                 RowBox[{"q", "''"}], "[", "t", "]"}]}], "+", 
               RowBox[{"resistance", " ", 
                RowBox[{
                 RowBox[{"q", "'"}], "[", "t", "]"}]}], "+", 
               RowBox[{
                RowBox[{"q", "[", "t", "]"}], "/", "capacitance"}]}], "==", 
              RowBox[{"voltageFunction", "[", "t", "]"}]}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"charge", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", "\"\<Charge\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<Charge q(t)\>\""}]}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"current", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", "\"\<Current\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<Current i(t)\>\""}]}], "]"}]}], 
        "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"inductance", ",", "1", ",", "\"\<Inductance L\>\""}], "}"}], ",",
      "0.5", ",", "3", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"resistance", ",", "2", ",", "\"\<Resistance R\>\""}], "}"}], ",",
      "0", ",", "8", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"capacitance", ",", "0.25", ",", "\"\<Capacitance C\>\""}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.125", "->", "\"\<1/8 F\>\""}], ",", 
       RowBox[{"0.25", "->", "\"\<1/4 F\>\""}], ",", 
       RowBox[{"0.5", "->", "\"\<1/2 F\>\""}], ",", 
       RowBox[{"1", "->", "\"\<1 F\>\""}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "voltageAmplitude", ",", "10", ",", "\"\<Voltage amplitude\>\""}], 
      "}"}], ",", "0", ",", "20", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "forcingFrequency", ",", "3", ",", "\"\<Forcing frequency\>\""}], "}"}],
      ",", "0.5", ",", "5", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialCharge", ",", "0", ",", "\"\<Initial charge\>\""}], 
      "}"}], ",", 
     RowBox[{"-", "1"}], ",", "1", ",", "0.25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialCurrent", ",", "0", ",", "\"\<Initial current\>\""}], 
      "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9974781905684395`*^9, 3.9974781905684395`*^9}},
 CellLabel->
