Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`capacitance$$ = 
    0.25, $CellContext`forcingFrequency$$ = 3, $CellContext`inductance$$ = 
    1, $CellContext`initialCharge$$ = 0, $CellContext`initialCurrent$$ = 
    0, $CellContext`resistance$$ = 2, $CellContext`voltageAmplitude$$ = 10, 
    Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
    Typeset`bookmarkMode$$ = "Menu", Typeset`animator$$, Typeset`animvar$$ = 
    1, Typeset`name$$ = "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`inductance$$], 1, "Inductance L"}, 0.5, 3, 0.5, 
      ControlType -> Manipulator}, {{
       Hold[$CellContext`resistance$$], 2, "Resistance R"}, 0, 8, 0.5, 
      ControlType -> Manipulator}, {{
       Hold[$CellContext`capacitance$$], 0.25, "Capacitance C"}, {
      0.125 -> "1/8 F", 0.25 -> "1/4 F", 0.5 -> "1/2 F", 1 -> "1 F"}, 
      ControlType -> SetterBar}, {{
       Hold[$CellContext`voltageAmplitude$$], 10, "Voltage amplitude"}, 0, 20,
       2, ControlType -> Manipulator}, {{
       Hold[$CellContext`forcingFrequency$$], 3, "Forcing frequency"}, 0.5, 5,
       0.5, ControlType -> Manipulator}, {{
       Hold[$CellContext`initialCharge$$], 0, "Initial charge"}, -1, 1, 0.25, 
      ControlType -> Manipulator}, {{
       Hold[$CellContext`initialCurrent$$], 0, "Initial current"}, -2, 2, 0.5,
       ControlType -> Manipulator}}, Typeset`size$$ = {
    514.6171875, {149.35544373118313`, 155.08737732493313`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`capacitance$$ = 
        0.25, $CellContext`forcingFrequency$$ = 3, $CellContext`inductance$$ = 
        1, $CellContext`initialCharge$$ = 0, $CellContext`initialCurrent$$ = 
        0, $CellContext`resistance$$ = 2, $CellContext`voltageAmplitude$$ = 
        10}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`voltageFunction$, $CellContext`charge$, \
$CellContext`current$, $CellContext`criticalResistance$, \
$CellContext`discriminant$, $CellContext`classification$}, \
$CellContext`voltageFunction$[
           Pattern[$CellContext`t$, 
            Blank[]]] := $CellContext`voltageAmplitude$$ 
          Sin[$CellContext`forcingFrequency$$ $CellContext`t$]; \
$CellContext`criticalResistance$ = 
         2 Sqrt[$CellContext`inductance$$/$CellContext`capacitance$$]; \
$CellContext`discriminant$ = $CellContext`resistance$$^2 - 
          4 ($CellContext`inductance$$/$CellContext`capacitance$$); \
$CellContext`classification$ = 
         Which[$CellContext`discriminant$ < 0, "Underdamped", 
           Chop[$CellContext`discriminant$] == 0, 
           "Critically damped", $CellContext`discriminant$ > 0, 
           "Overdamped"]; $CellContext`charge$ = 
         NDSolveValue[{$CellContext`inductance$$ 
              Derivative[
               2][$CellContext`q][$CellContext`t] + $CellContext`resistance$$ 
              Derivative[
               1][$CellContext`q][$CellContext`t] + \
$CellContext`q[$CellContext`t]/$CellContext`capacitance$$ == \
$CellContext`voltageFunction$[$CellContext`t], $CellContext`q[
             0] == $CellContext`initialCharge$$, 
            Derivative[1][$CellContext`q][
             0] == $CellContext`initialCurrent$$}, $CellContext`q, \
{$CellContext`t, 0, 20}]; $CellContext`current$[
           Pattern[$CellContext`t$, 
            Blank[]]] := Derivative[1][$CellContext`charge$][$CellContext`t$]; 
        Column[{
           Style[
           "Interactive Mathematica Lab 5.5: Series RLC Circuits", 18, Bold], 
           
           Row[{"Source-free classification: ", \
$CellContext`classification$}], 
           Row[{"Critical resistance: ", 
             NumberForm[
              N[$CellContext`criticalResistance$], {7, 3}]}], 
           Row[{"Circuit equation: ", 
             
             TraditionalForm[$CellContext`inductance$$ 
                Derivative[
                 2][$CellContext`q][$CellContext`t] + \
$CellContext`resistance$$ 
                Derivative[
                 1][$CellContext`q][$CellContext`t] + \
$CellContext`q[$CellContext`t]/$CellContext`capacitance$$ == \
$CellContext`voltageFunction$[$CellContext`t]]}], 
           Plot[
            $CellContext`charge$[$CellContext`t], {$CellContext`t, 0, 20}, 
            PlotRange -> All, AxesLabel -> {"Time", "Charge"}, GridLines -> 
            Automatic, PlotLabel -> "Charge q(t)"], 
           Plot[
            $CellContext`current$[$CellContext`t], {$CellContext`t, 0, 20}, 
            PlotRange -> All, AxesLabel -> {"Time", "Current"}, GridLines -> 
            Automatic, PlotLabel -> "Current i(t)"]}]], 
      "Specifications" :> {{{$CellContext`inductance$$, 1, "Inductance L"}, 
         0.5, 3, 0.5}, {{$CellContext`resistance$$, 2, "Resistance R"}, 0, 8, 
         0.5}, {{$CellContext`capacitance$$, 0.25, "Capacitance C"}, {
         0.125 -> "1/8 F", 0.25 -> "1/4 F", 0.5 -> "1/2 F", 1 -> 
          "1 F"}}, {{$CellContext`voltageAmplitude$$, 10, 
          "Voltage amplitude"}, 0, 20, 
         2}, {{$CellContext`forcingFrequency$$, 3, "Forcing frequency"}, 0.5, 
         5, 0.5}, {{$CellContext`initialCharge$$, 0, "Initial charge"}, -1, 1,
          0.25}, {{$CellContext`initialCurrent$$, 0, "Initial current"}, -2, 
         2, 0.5}}, "Options" :> {}, "DefaultOptions" :> {}],
