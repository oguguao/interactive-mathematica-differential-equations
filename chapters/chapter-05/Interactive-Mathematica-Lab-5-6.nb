Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`gravity$$ = 
    9.81, $CellContext`initialAngle$$ = 0.2, $CellContext`length$$ = 1, 
    Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
    Typeset`bookmarkMode$$ = "Menu", Typeset`animator$$, Typeset`animvar$$ = 
    1, Typeset`name$$ = "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`initialAngle$$], 0.2, "Initial angle (radians)"}, 
      0.1, 1.4, 0.1, ControlType -> Manipulator}, {{
       Hold[$CellContext`length$$], 1, "Pendulum length"}, 0.5, 3, 0.25, 
      ControlType -> Manipulator}, {{
       Hold[$CellContext`gravity$$], 9.81, "Gravity"}, {9.81 -> "9.81 m/s^2"},
       ControlType -> PopupMenu}}, Typeset`size$$ = {
    653.16796875, {88.99076999792406, 94.72270359167406}}, Typeset`update$$ = 
    0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`gravity$$ = 
        9.81, $CellContext`initialAngle$$ = 0.2, $CellContext`length$$ = 1}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`nonlinearSolution$, $CellContext`linearSolution$, \
$CellContext`approximatePeriod$, $CellContext`maximumDifference$}, \
$CellContext`nonlinearSolution$ = 
         NDSolveValue[{
           Derivative[
              2][$CellContext`theta][$CellContext`t] + \
($CellContext`gravity$$/$CellContext`length$$) Sin[
                $CellContext`theta[$CellContext`t]] == 
            0, $CellContext`theta[0] == $CellContext`initialAngle$$, 
            Derivative[1][$CellContext`theta][0] == 
            0}, $CellContext`theta, {$CellContext`t, 0, 
            15}]; $CellContext`linearSolution$ = 
         NDSolveValue[{
           Derivative[
              2][$CellContext`linearAngle][$CellContext`t] + \
($CellContext`gravity$$/$CellContext`length$$) \
$CellContext`linearAngle[$CellContext`t] == 
            0, $CellContext`linearAngle[0] == $CellContext`initialAngle$$, 
            Derivative[1][$CellContext`linearAngle][0] == 
            0}, $CellContext`linearAngle, {$CellContext`t, 0, 
            15}]; $CellContext`approximatePeriod$ = 
         2 Pi Sqrt[$CellContext`length$$/$CellContext`gravity$$]; \
$CellContext`maximumDifference$ = Max[
           Table[
            
            Abs[$CellContext`nonlinearSolution$[$CellContext`t] - \
$CellContext`linearSolution$[$CellContext`t]], {$CellContext`t, 0, 15, 
             0.05}]]; Column[{
           Style[
           "Interactive Mathematica Lab 5.6: Pendulum Motion and \
Linearization", 18, Bold], 
           Row[{"Initial angle: ", $CellContext`initialAngle$$, " radians"}], 
           Row[{"Small-angle period: ", 
             NumberForm[
              N[$CellContext`approximatePeriod$], {7, 3}]}], 
           Row[{"Maximum model difference: ", 
             NumberForm[
              N[$CellContext`maximumDifference$], {8, 5}]}], 
           Plot[{
             $CellContext`nonlinearSolution$[$CellContext`t], 
             $CellContext`linearSolution$[$CellContext`t]}, {$CellContext`t, 
             0, 15}, PlotRange -> All, 
            PlotLegends -> {"Exact nonlinear model", "Small-angle model"}, 
            AxesLabel -> {"Time", "Angle"}, GridLines -> Automatic, PlotLabel -> 
            "Exact and Linearized Pendulum"]}]], 
      "Specifications" :> {{{$CellContext`initialAngle$$, 0.2, 
          "Initial angle (radians)"}, 0.1, 1.4, 
         0.1}, {{$CellContext`length$$, 1, "Pendulum length"}, 0.5, 3, 
         0.25}, {{$CellContext`gravity$$, 9.81, "Gravity"}, {
         9.81 -> "9.81 m/s^2"}}}, "Options" :> {}, "DefaultOptions" :> {}],
