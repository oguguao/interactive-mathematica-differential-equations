Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nonlinearSolution", ",", "linearSolution", ",", "approximatePeriod", ",",
        "maximumDifference"}], "}"}], ",", 
     RowBox[{
      RowBox[{"nonlinearSolution", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"theta", "''"}], "[", "t", "]"}], "+", 
             RowBox[{
              RowBox[{"gravity", "/", "length"}], " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"theta", "[", "t", "]"}], "]"}]}]}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"theta", "[", "0", "]"}], "==", "initialAngle"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"theta", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",",
          "theta", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "15"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"linearSolution", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"linearAngle", "''"}], "[", "t", "]"}], "+", 
             RowBox[{
              RowBox[{"gravity", "/", "length"}], " ", 
              RowBox[{"linearAngle", "[", "t", "]"}]}]}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"linearAngle", "[", "0", "]"}], "==", "initialAngle"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"linearAngle", "'"}], "[", "0", "]"}], "==", "0"}]}], 
          "}"}], ",", "linearAngle", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "15"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"approximatePeriod", "=", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"length", "/", "gravity"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maximumDifference", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"nonlinearSolution", "[", "t", "]"}], "-", 
            RowBox[{"linearSolution", "[", "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "15", ",", "0.05"}], "}"}]}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 5.6: Pendulum Motion and \
Linearization\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Initial angle: \>\"", ",", "initialAngle", 
            ",", "\"\< radians\>\""}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Small-angle period: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "approximatePeriod", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"7", ",", "3"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Maximum model difference: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "maximumDifference", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"8", ",", "5"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"nonlinearSolution", "[", "t", "]"}], ",", 
             RowBox[{"linearSolution", "[", "t", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "15"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Exact nonlinear model\>\"", 
              ",", "\"\<Small-angle model\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Time\>\"", ",", "\"\<Angle\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Exact and Linearized Pendulum\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "initialAngle", ",", "0.2", ",", "\"\<Initial angle (radians)\>\""}], 
      "}"}], ",", "0.1", ",", "1.4", ",", "0.1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"length", ",", "1", ",", "\"\<Pendulum length\>\""}], "}"}], ",",
      "0.5", ",", "3", ",", "0.25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gravity", ",", "9.81", ",", "\"\<Gravity\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"9.81", "->", "\"\<9.81 m/s^2\>\""}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9974782206325665`*^9, 3.9974782206325665`*^9}},
 CellLabel->
