         Switch[$CellContext`systemChoice$$, "Spring-mass", 
           
           Column[{"Dependent variable: displacement", 
             "Second-derivative coefficient: mass", 
             "First-derivative coefficient: damping", 
             "Dependent-variable coefficient: spring stiffness"}], 
