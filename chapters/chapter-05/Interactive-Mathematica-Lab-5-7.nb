      Module[{$CellContext`discriminant$, $CellContext`classification$, \
$CellContext`characteristicRoots$, $CellContext`interpretation$}, \
$CellContext`discriminant$ = $CellContext`firstDerivativeCoefficient$$^2 - 
          4 $CellContext`secondDerivativeCoefficient$$ \
$CellContext`dependentVariableCoefficient$$; $CellContext`classification$ = 
         Which[$CellContext`discriminant$ < 0, 
           "Underdamped / oscillatory decay", 
           Chop[$CellContext`discriminant$] == 0, 
           "Critically damped", $CellContext`discriminant$ > 0, 
           "Overdamped"]; $CellContext`characteristicRoots$ = 
         Solve[$CellContext`secondDerivativeCoefficient$$ $CellContext`r^2 + \
