Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "discriminant", ",", "classification", ",", "characteristicRoots", ",", 
       "interpretation"}], "}"}], ",", 
     RowBox[{
      RowBox[{"discriminant", "=", 
       RowBox[{
        RowBox[{"firstDerivativeCoefficient", "^", "2"}], "-", 
        RowBox[{
        "4", " ", "secondDerivativeCoefficient", " ", 
         "dependentVariableCoefficient"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"classification", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"discriminant", "<", "0"}], 
         ",", "\"\<Underdamped / oscillatory decay\>\"", ",", 
         RowBox[{
          RowBox[{"Chop", "[", "discriminant", "]"}], "==", "0"}], 
         ",", "\"\<Critically damped\>\"", ",", 
         RowBox[{"discriminant", ">", "0"}], ",", "\"\<Overdamped\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"characteristicRoots", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"secondDerivativeCoefficient", " ", 
            RowBox[{"r", "^", "2"}]}], "+", 
           RowBox[{"firstDerivativeCoefficient", " ", "r"}], "+", 
           "dependentVariableCoefficient"}], "==", "0"}], ",", "r"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"interpretation", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{"systemChoice", ",", "\"\<Spring-mass\>\"", ",", 
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Dependent variable: displacement\>\"", 
            ",", "\"\<Second-derivative coefficient: mass\>\"", 
            ",", "\"\<First-derivative coefficient: damping\>\"", 
            ",", "\"\<Dependent-variable coefficient: spring stiffness\>\""}],
            "}"}], "]"}], ",", "\"\<RLC circuit\>\"", ",", 
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Dependent variable: charge\>\"", 
            ",", "\"\<Second-derivative coefficient: inductance\>\"", 
            ",", "\"\<First-derivative coefficient: resistance\>\"", 
            ",", "\"\<Dependent-variable coefficient: reciprocal \
capacitance\>\""}], "}"}], "]"}], ",", "\"\<Linearized pendulum\>\"", ",", 
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Dependent variable: angular displacement\>\"", 
            ",", "\"\<Second-derivative coefficient: inertia role\>\"", 
            ",", "\"\<First-derivative coefficient: rotational damping\>\"", 
            ",", "\"\<Dependent-variable coefficient: restoring effect\>\""}],
            "}"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 5.7: Selecting and \
Interpreting Second-Order Models\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Physical system: \>\"", ",", "systemChoice"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Model: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"secondDerivativeCoefficient", " ", 
                RowBox[{
                 RowBox[{"y", "''"}], "[", "t", "]"}]}], "+", 
               RowBox[{"firstDerivativeCoefficient", " ", 
                RowBox[{
                 RowBox[{"y", "'"}], "[", "t", "]"}]}], "+", 
               RowBox[{"dependentVariableCoefficient", " ", 
                RowBox[{"y", "[", "t", "]"}]}]}], "==", "0"}], "]"}]}], "}"}],
           "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Discriminant: \>\"", ",", "discriminant"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Classification: \>\"", ",", "classification"}], "}"}],
           "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Characteristic roots: \>\"", ",", 
            "characteristicRoots"}], "}"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Physical Interpretation\>\"", ",", "14", ",", "Bold"}],
           "]"}], ",", "interpretation"}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "systemChoice", ",", "\"\<Spring-mass\>\"", 
       ",", "\"\<Choose physical system\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Spring-mass\>\"", ",", "\"\<RLC circuit\>\"", 
       ",", "\"\<Linearized pendulum\>\""}], "}"}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "secondDerivativeCoefficient", ",", "1", 
