Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "slopeFunction", ",", "exactSolution", ",", "numberOfSteps", ",", 
       "eulerStep", ",", "eulerPoints", ",", "errorTable", ",", 
       "finalError"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"slopeFunction", "[", 
        RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
       RowBox[{"y", "-", 
        RowBox[{"x", "^", "2"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"exactSolution", "[", "x_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "+", "1"}], ")"}], "^", "2"}], "-", 
        RowBox[{"0.5", " ", 
         RowBox[{"Exp", "[", "x", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"numberOfSteps", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"2", "/", "stepSize"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"eulerStep", "[", 
        RowBox[{"{", 
         RowBox[{"currentX_", ",", "currentY_"}], "}"}], "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"currentX", "+", "stepSize"}], ",", 
         RowBox[{"currentY", "+", 
          RowBox[{"stepSize", " ", 
           RowBox[{"slopeFunction", "[", 
            RowBox[{"currentX", ",", "currentY"}], "]"}]}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eulerPoints", "=", 
       RowBox[{"NestList", "[", 
        RowBox[{"eulerStep", ",", 
         RowBox[{"{", 
          RowBox[{"0.", ",", "0.5"}], "}"}], ",", "numberOfSteps"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"errorTable", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"exactSolution", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", 
              RowBox[{"exactSolution", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "}"}], 
          "&"}], ")"}], "/@", "eulerPoints"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"finalError", "=", 
       RowBox[{
        RowBox[{"Last", "[", "errorTable", "]"}], "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 6.2: Euler's Method\>\"", ",",
            "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Step size h: \>\"", ",", "stepSize"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Number of steps: \>\"", ",", "numberOfSteps"}], "}"}],
           "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Final absolute error: \>\"", ",", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "finalError", "]"}], ",", "5"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"errorTable", ",", "8"}], "]"}], ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<x\>\"", ",", "\"\<Euler\>\"", ",", "\"\<Exact\>\"",
                ",", "\"\<Error\>\""}], "}"}]}], "]"}], ",", 
           RowBox[{"Frame", "->", "All"}]}], "]"}], ",", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"ListLinePlot", "[", 
            RowBox[{"eulerPoints", ",", 
             RowBox[{"PlotMarkers", "->", "Automatic"}]}], "]"}], ",", 
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"exactSolution", "[", "x", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "2"}], "}"}]}], "]"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Euler Approximation and Exact Solution\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stepSize", ",", "0.2", ",", "\"\<Step size h\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.5", "->", "\"\<0.5\>\""}], ",", 
       RowBox[{"0.25", "->", "\"\<0.25\>\""}], ",", 
       RowBox[{"0.2", "->", "\"\<0.2\>\""}], ",", 
       RowBox[{"0.1", "->", "\"\<0.1\>\""}], ",", 
       RowBox[{"0.05", "->", "\"\<0.05\>\""}]}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9974786508399506`*^9, 3.9974786508399506`*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"ae1f8675-b981-3b4c-b69c-cf55d9aad087"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`stepSize$$ = 0.2, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`stepSize$$], 0.2, "Step size h"}, {
      0.5 -> "0.5", 0.25 -> "0.25", 0.2 -> "0.2", 0.1 -> "0.1", 0.05 -> 
       "0.05"}, ControlType -> SetterBar}}, Typeset`size$$ = {
    465.134765625, {214.14705548822874`, 219.87898908197874`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`stepSize$$ = 0.2}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`slopeFunction$, $CellContext`exactSolution$, \
$CellContext`numberOfSteps$, $CellContext`eulerStep$, \
$CellContext`eulerPoints$, $CellContext`errorTable$, \
$CellContext`finalError$}, $CellContext`slopeFunction$[
           Pattern[$CellContext`x, 
            Blank[]], 
           Pattern[$CellContext`y, 
            Blank[]]] := $CellContext`y - $CellContext`x^2 + 
          1; $CellContext`exactSolution$[
           Pattern[$CellContext`x, 
            Blank[]]] := ($CellContext`x + 1)^2 - 0.5 
          Exp[$CellContext`x]; $CellContext`numberOfSteps$ = 
         Round[2/$CellContext`stepSize$$]; $CellContext`eulerStep$[{
            Pattern[$CellContext`currentX$, 
             Blank[]], 
            Pattern[$CellContext`currentY$, 
             
             Blank[]]}] := {$CellContext`currentX$ + $CellContext`stepSize$$, \
$CellContext`currentY$ + $CellContext`stepSize$$ \
$CellContext`slopeFunction$[$CellContext`currentX$, $CellContext`currentY$]}; \
$CellContext`eulerPoints$ = 
         NestList[$CellContext`eulerStep$, {0., 
           0.5}, $CellContext`numberOfSteps$]; $CellContext`errorTable$ = Map[{
            Part[#, 1], 
            Part[#, 2], 
            $CellContext`exactSolution$[
             Part[#, 1]], 
            Abs[Part[#, 2] - $CellContext`exactSolution$[
              
              Part[#, 1]]]}& , $CellContext`eulerPoints$]; \
$CellContext`finalError$ = Part[
           Last[$CellContext`errorTable$], 4]; Column[{
           Style["Interactive Mathematica Lab 6.2: Euler's Method", 18, Bold], 
           Row[{"Step size h: ", $CellContext`stepSize$$}], 
           Row[{"Number of steps: ", $CellContext`numberOfSteps$}], 
           Row[{"Final absolute error: ", 
             ScientificForm[
              N[$CellContext`finalError$], 5]}], 
           Grid[
            Prepend[
             N[$CellContext`errorTable$, 8], {
             "x", "Euler", "Exact", "Error"}], Frame -> All], 
           Show[
            ListLinePlot[$CellContext`eulerPoints$, PlotMarkers -> Automatic], 
            Plot[
             $CellContext`exactSolution$[$CellContext`x], {$CellContext`x, 0, 
              2}], AxesLabel -> {"x", "y"}, PlotLabel -> 
            "Euler Approximation and Exact Solution"]}]], 
      "Specifications" :> {{{$CellContext`stepSize$$, 0.2, "Step size h"}, {
         0.5 -> "0.5", 0.25 -> "0.25", 0.2 -> "0.2", 0.1 -> "0.1", 0.05 -> 
          "0.05"}}}, "Options" :> {}, "DefaultOptions" :> {}],
