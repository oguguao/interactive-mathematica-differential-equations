Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "slopeFunction", ",", "exactSolution", ",", "numberOfSteps", ",", 
       "modifiedEulerStep", ",", "modifiedPoints", ",", "errorTable", ",", 
       "finalError"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"slopeFunction", "[", 
        RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
       RowBox[{"y", "-", 
        RowBox[{"x", "^", "2"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"exactSolution", "[", "x_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "+", "1"}], ")"}], "^", "2"}], "-", 
        RowBox[{"0.5", " ", 
         RowBox[{"Exp", "[", "x", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"numberOfSteps", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"2", "/", "stepSize"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"modifiedEulerStep", "[", 
        RowBox[{"{", 
         RowBox[{"currentX_", ",", "currentY_"}], "}"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"beginningSlope", ",", "predictor", ",", "endpointSlope"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"beginningSlope", "=", 
           RowBox[{"slopeFunction", "[", 
            RowBox[{"currentX", ",", "currentY"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"predictor", "=", 
           RowBox[{"currentY", "+", 
            RowBox[{"stepSize", " ", "beginningSlope"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"endpointSlope", "=", 
           RowBox[{"slopeFunction", "[", 
            RowBox[{
             RowBox[{"currentX", "+", "stepSize"}], ",", "predictor"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"currentX", "+", "stepSize"}], ",", 
            RowBox[{"currentY", "+", 
             RowBox[{
              RowBox[{"stepSize", "/", "2"}], " ", 
              RowBox[{"(", 
               RowBox[{"beginningSlope", "+", "endpointSlope"}], ")"}]}]}]}], 
           "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"modifiedPoints", "=", 
       RowBox[{"NestList", "[", 
        RowBox[{"modifiedEulerStep", ",", 
         RowBox[{"{", 
          RowBox[{"0.", ",", "0.5"}], "}"}], ",", "numberOfSteps"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"errorTable", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"exactSolution", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", 
              RowBox[{"exactSolution", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], "}"}], 
          "&"}], ")"}], "/@", "modifiedPoints"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"finalError", "=", 
       RowBox[{
        RowBox[{"Last", "[", "errorTable", "]"}], "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 6.3: Modified Euler's \
Method\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Step size h: \>\"", ",", "stepSize"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Final absolute error: \>\"", ",", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "finalError", "]"}], ",", "5"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"errorTable", ",", "8"}], "]"}], ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<x\>\"", ",", "\"\<Modified Euler\>\"", 
               ",", "\"\<Exact\>\"", ",", "\"\<Error\>\""}], "}"}]}], "]"}], ",", 
           RowBox[{"Frame", "->", "All"}]}], "]"}], ",", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"ListLinePlot", "[", 
            RowBox[{"modifiedPoints", ",", 
             RowBox[{"PlotMarkers", "->", "Automatic"}]}], "]"}], ",", 
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"exactSolution", "[", "x", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "2"}], "}"}]}], "]"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Modified Euler and Exact Solution\>\""}]}],
           "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stepSize", ",", "0.2", ",", "\"\<Step size h\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.5", "->", "\"\<0.5\>\""}], ",", 
       RowBox[{"0.25", "->", "\"\<0.25\>\""}], ",", 
       RowBox[{"0.2", "->", "\"\<0.2\>\""}], ",", 
       RowBox[{"0.1", "->", "\"\<0.1\>\""}], ",", 
       RowBox[{"0.05", "->", "\"\<0.05\>\""}]}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.997478679035572*^9, 3.997478679035572*^9}},
