Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`stepSize$$ = 0.2, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`stepSize$$], 0.2, "Step size h"}, {
      0.5 -> "0.5", 0.25 -> "0.25", 0.2 -> "0.2", 0.1 -> "0.1", 0.05 -> 
       "0.05"}, ControlType -> SetterBar}}, Typeset`size$$ = {
    635.185546875, {112.98706565123254`, 118.71899924498254`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`stepSize$$ = 0.2}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`slopeFunction$, $CellContext`exactSolution$, \
$CellContext`numberOfSteps$, $CellContext`rk4Step$, $CellContext`rk4Points$, \
$CellContext`finalPoint$, $CellContext`finalError$}, \
$CellContext`slopeFunction$[
           Pattern[$CellContext`x, 
            Blank[]], 
           Pattern[$CellContext`y, 
            Blank[]]] := $CellContext`y - $CellContext`x^2 + 
          1; $CellContext`exactSolution$[
           Pattern[$CellContext`x, 
            Blank[]]] := ($CellContext`x + 1)^2 - 0.5 
          Exp[$CellContext`x]; $CellContext`numberOfSteps$ = 
         Round[2/$CellContext`stepSize$$]; $CellContext`rk4Step$[{
            Pattern[$CellContext`currentX$, 
             Blank[]], 
            Pattern[$CellContext`currentY$, 
             Blank[]]}] := 
         Module[{$CellContext`slope1$, $CellContext`slope2$, \
$CellContext`slope3$, $CellContext`slope4$}, $CellContext`slope1$ = \
$CellContext`slopeFunction$[$CellContext`currentX$, $CellContext`currentY$]; \
$CellContext`slope2$ = $CellContext`slopeFunction$[$CellContext`currentX$ + \
$CellContext`stepSize$$/
               2, $CellContext`currentY$ + $CellContext`stepSize$$ \
($CellContext`slope1$/
                2)]; $CellContext`slope3$ = \
$CellContext`slopeFunction$[$CellContext`currentX$ + $CellContext`stepSize$$/
               2, $CellContext`currentY$ + $CellContext`stepSize$$ \
($CellContext`slope2$/
                2)]; $CellContext`slope4$ = \
$CellContext`slopeFunction$[$CellContext`currentX$ + $CellContext`stepSize$$, \
$CellContext`currentY$ + $CellContext`stepSize$$ $CellContext`slope3$]; \
{$CellContext`currentX$ + $CellContext`stepSize$$, $CellContext`currentY$ + \
($CellContext`stepSize$$/6) ($CellContext`slope1$ + 2 $CellContext`slope2$ + 
               2 $CellContext`slope3$ + $CellContext`slope4$)}]; \
$CellContext`rk4Points$ = 
         NestList[$CellContext`rk4Step$, {0., 
           0.5}, $CellContext`numberOfSteps$]; $CellContext`finalPoint$ = 
         Last[$CellContext`rk4Points$]; $CellContext`finalError$ = 
         Abs[Part[$CellContext`finalPoint$, 2] - $CellContext`exactSolution$[
            Part[$CellContext`finalPoint$, 1]]]; Column[{
           Style[
           "Interactive Mathematica Lab 6.4: Fourth-Order Runge-Kutta Method",
             18, Bold], 
           Row[{"Step size h: ", $CellContext`stepSize$$}], 
           Row[{"Number of steps: ", $CellContext`numberOfSteps$}], 
           Row[{"Final approximation: ", 
             N[
              Part[$CellContext`finalPoint$, 2], 10]}], 
           Row[{"Final absolute error: ", 
             ScientificForm[
              N[$CellContext`finalError$], 5]}], 
           Show[
            ListLinePlot[$CellContext`rk4Points$, PlotMarkers -> Automatic], 
            Plot[
             $CellContext`exactSolution$[$CellContext`x], {$CellContext`x, 0, 
              2}], AxesLabel -> {"x", "y"}, PlotLabel -> 
            "RK4 Approximation and Exact Solution"]}]], 
      "Specifications" :> {{{$CellContext`stepSize$$, 0.2, "Step size h"}, {
         0.5 -> "0.5", 0.25 -> "0.25", 0.2 -> "0.2", 0.1 -> "0.1", 0.05 -> 
