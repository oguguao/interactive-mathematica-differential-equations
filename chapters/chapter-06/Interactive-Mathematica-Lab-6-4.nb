Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "slopeFunction", ",", "exactSolution", ",", "numberOfSteps", ",", 
       "rk4Step", ",", "rk4Points", ",", "finalPoint", ",", "finalError"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"slopeFunction", "[", 
        RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
       RowBox[{"y", "-", 
        RowBox[{"x", "^", "2"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"exactSolution", "[", "x_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "+", "1"}], ")"}], "^", "2"}], "-", 
        RowBox[{"0.5", " ", 
         RowBox[{"Exp", "[", "x", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"numberOfSteps", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"2", "/", "stepSize"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rk4Step", "[", 
        RowBox[{"{", 
         RowBox[{"currentX_", ",", "currentY_"}], "}"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"slope1", ",", "slope2", ",", "slope3", ",", "slope4"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"slope1", "=", 
           RowBox[{"slopeFunction", "[", 
            RowBox[{"currentX", ",", "currentY"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"slope2", "=", 
           RowBox[{"slopeFunction", "[", 
            RowBox[{
             RowBox[{"currentX", "+", 
              RowBox[{"stepSize", "/", "2"}]}], ",", 
             RowBox[{"currentY", "+", 
              RowBox[{"stepSize", " ", 
               RowBox[{"slope1", "/", "2"}]}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"slope3", "=", 
           RowBox[{"slopeFunction", "[", 
            RowBox[{
             RowBox[{"currentX", "+", 
              RowBox[{"stepSize", "/", "2"}]}], ",", 
             RowBox[{"currentY", "+", 
              RowBox[{"stepSize", " ", 
               RowBox[{"slope2", "/", "2"}]}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"slope4", "=", 
           RowBox[{"slopeFunction", "[", 
            RowBox[{
             RowBox[{"currentX", "+", "stepSize"}], ",", 
             RowBox[{"currentY", "+", 
              RowBox[{"stepSize", " ", "slope3"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"currentX", "+", "stepSize"}], ",", 
            RowBox[{"currentY", "+", 
             RowBox[{
              RowBox[{"stepSize", "/", "6"}], " ", 
              RowBox[{"(", 
               RowBox[{"slope1", "+", 
                RowBox[{"2", " ", "slope2"}], "+", 
                RowBox[{"2", " ", "slope3"}], "+", "slope4"}], ")"}]}]}]}], 
           "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rk4Points", "=", 
       RowBox[{"NestList", "[", 
        RowBox[{"rk4Step", ",", 
         RowBox[{"{", 
          RowBox[{"0.", ",", "0.5"}], "}"}], ",", "numberOfSteps"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"finalPoint", "=", 
       RowBox[{"Last", "[", "rk4Points", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"finalError", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"finalPoint", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"exactSolution", "[", 
          RowBox[{"finalPoint", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 6.4: Fourth-Order \
Runge-Kutta Method\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Step size h: \>\"", ",", "stepSize"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Number of steps: \>\"", ",", "numberOfSteps"}], "}"}],
           "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Final approximation: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"finalPoint", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "10"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Final absolute error: \>\"", ",", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "finalError", "]"}], ",", "5"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"ListLinePlot", "[", 
            RowBox[{"rk4Points", ",", 
             RowBox[{"PlotMarkers", "->", "Automatic"}]}], "]"}], ",", 
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"exactSolution", "[", "x", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "2"}], "}"}]}], "]"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<RK4 Approximation and Exact Solution\>\""}]}], "]"}]}],
         "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stepSize", ",", "0.2", ",", "\"\<Step size h\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.5", "->", "\"\<0.5\>\""}], ",", 
       RowBox[{"0.25", "->", "\"\<0.25\>\""}], ",", 
       RowBox[{"0.2", "->", "\"\<0.2\>\""}], ",", 
       RowBox[{"0.1", "->", "\"\<0.1\>\""}], ",", 
       RowBox[{"0.05", "->", "\"\<0.05\>\""}]}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
