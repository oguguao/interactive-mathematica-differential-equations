$CellContext`timeDataV$, $CellContext`phaseData$}, $CellContext`vectorField$[{
            Pattern[$CellContext`uValue, 
             Blank[]], 
            Pattern[$CellContext`vValue, 
             
             Blank[]]}] := {$CellContext`uValue - $CellContext`vValue, \
$CellContext`uValue + $CellContext`vValue}; $CellContext`numberOfSteps$ = 
         Round[2/$CellContext`stepSize$$]; $CellContext`eulerStep$[{
            Pattern[$CellContext`currentTime$, 
             Blank[]], 
            Pattern[$CellContext`currentState$, 
             
             Blank[]]}] := {$CellContext`currentTime$ + \
