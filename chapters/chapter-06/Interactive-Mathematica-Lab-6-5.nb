Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "vectorField", ",", "numberOfSteps", ",", "eulerStep", ",", "rk4Step", ",",
        "numericalPoints", ",", "timeDataU", ",", "timeDataV", ",", 
       "phaseData"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"vectorField", "[", 
        RowBox[{"{", 
         RowBox[{"uValue_", ",", "vValue_"}], "}"}], "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"uValue", "-", "vValue"}], ",", 
         RowBox[{"uValue", "+", "vValue"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"numberOfSteps", "=", 
       RowBox[{"Round", "[", 
        RowBox[{"2", "/", "stepSize"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"eulerStep", "[", 
        RowBox[{"{", 
         RowBox[{"currentTime_", ",", "currentState_"}], "}"}], "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"currentTime", "+", "stepSize"}], ",", 
         RowBox[{"currentState", "+", 
          RowBox[{"stepSize", " ", 
           RowBox[{"vectorField", "[", "currentState", "]"}]}]}]}], "}"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rk4Step", "[", 
        RowBox[{"{", 
         RowBox[{"currentTime_", ",", "currentState_"}], "}"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"slope1", ",", "slope2", ",", "slope3", ",", "slope4"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"slope1", "=", 
           RowBox[{"vectorField", "[", "currentState", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"slope2", "=", 
           RowBox[{"vectorField", "[", 
            RowBox[{"currentState", "+", 
             RowBox[{"stepSize", " ", 
              RowBox[{"slope1", "/", "2"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"slope3", "=", 
           RowBox[{"vectorField", "[", 
            RowBox[{"currentState", "+", 
             RowBox[{"stepSize", " ", 
              RowBox[{"slope2", "/", "2"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"slope4", "=", 
           RowBox[{"vectorField", "[", 
            RowBox[{"currentState", "+", 
             RowBox[{"stepSize", " ", "slope3"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"currentTime", "+", "stepSize"}], ",", 
            RowBox[{"currentState", "+", 
             RowBox[{
              RowBox[{"stepSize", "/", "6"}], " ", 
              RowBox[{"(", 
               RowBox[{"slope1", "+", 
                RowBox[{"2", " ", "slope2"}], "+", 
                RowBox[{"2", " ", "slope3"}], "+", "slope4"}], ")"}]}]}]}], 
           "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"numericalPoints", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"methodChoice", "==", "\"\<Euler\>\""}], ",", 
         RowBox[{"NestList", "[", 
          RowBox[{"eulerStep", ",", 
           RowBox[{"{", 
            RowBox[{"0.", ",", 
             RowBox[{"{", 
              RowBox[{"initialU", ",", "initialV"}], "}"}]}], "}"}], ",", 
           "numberOfSteps"}], "]"}], ",", 
         RowBox[{"NestList", "[", 
          RowBox[{"rk4Step", ",", 
           RowBox[{"{", 
            RowBox[{"0.", ",", 
             RowBox[{"{", 
              RowBox[{"initialU", ",", "initialV"}], "}"}]}], "}"}], ",", 
           "numberOfSteps"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"timeDataU", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
        "numericalPoints"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"timeDataV", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
        "numericalPoints"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"phaseData", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "numericalPoints"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 6.5: Numerical Methods for \
Systems\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Method: \>\"", ",", "methodChoice"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Step size: \>\"", ",", "stepSize"}], "}"}], "]"}], ",", 
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ListLinePlot", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"timeDataU", ",", "timeDataV"}], "}"}], ",", 
              RowBox[{"PlotLegends", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<u(t)\>\"", ",", "\"\<v(t)\>\""}], "}"}]}], ",", 
              RowBox[{"AxesLabel", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<t\>\"", ",", "\"\<Value\>\""}], "}"}]}], ",", 
              RowBox[{"PlotLabel", "->", "\"\<Component Solutions\>\""}]}], 
             "]"}], ",", 
            RowBox[{"ListLinePlot", "[", 
             RowBox[{"phaseData", ",", 
              RowBox[{"AxesLabel", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<u\>\"", ",", "\"\<v\>\""}], "}"}]}], ",", 
              RowBox[{"PlotLabel", "->", "\"\<Phase Curve\>\""}]}], "]"}]}], 
           "}"}], "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"methodChoice", ",", "\"\<Euler\>\"", ",", "\"\<Method\>\""}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Euler\>\"", ",", "\"\<RK4\>\""}], "}"}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stepSize", ",", "0.05", ",", "\"\<Step size\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.2", "->", "\"\<0.2\>\""}], ",", 
       RowBox[{"0.1", "->", "\"\<0.1\>\""}], ",", 
       RowBox[{"0.05", "->", "\"\<0.05\>\""}], ",", 
       RowBox[{"0.025", "->", "\"\<0.025\>\""}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialU", ",", "1", ",", "\"\<u(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialV", ",", "0", ",", "\"\<v(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
