$CellContext`vectorField$[$CellContext`currentState$]}; $CellContext`rk4Step$[{
            Pattern[$CellContext`currentTime$, 
             Blank[]], 
            Pattern[$CellContext`currentState$, 
             Blank[]]}] := 
         Module[{$CellContext`slope1$, $CellContext`slope2$, \
$CellContext`slope3$, $CellContext`slope4$}, $CellContext`slope1$ = \
$CellContext`vectorField$[$CellContext`currentState$]; $CellContext`slope2$ = \
$CellContext`vectorField$[$CellContext`currentState$ + \
$CellContext`stepSize$$ ($CellContext`slope1$/
                2)]; $CellContext`slope3$ = \
$CellContext`vectorField$[$CellContext`currentState$ + \
