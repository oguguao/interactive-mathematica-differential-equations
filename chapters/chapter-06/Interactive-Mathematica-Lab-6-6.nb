Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "solution", ",", "angleSolution", ",", "angularVelocitySolution"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"solution", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"angleState", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"angularVelocityState", "[", "t", "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"angularVelocityState", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "dampingCoefficient"}], " ", 
              RowBox[{"angularVelocityState", "[", "t", "]"}]}], "-", 
             RowBox[{"Sin", "[", 
              RowBox[{"angleState", "[", "t", "]"}], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"angleState", "[", "0", "]"}], "==", "initialAngle"}], ",", 
           RowBox[{
            RowBox[{"angularVelocityState", "[", "0", "]"}], "==", 
            "initialAngularVelocity"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"angleState", ",", "angularVelocityState"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "30"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"angleSolution", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{"solution", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"angularVelocitySolution", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{"solution", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 6.6: Higher-Order \
Initial-Value Problems\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<First-order system: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"angleState", "'"}], "[", "t", "]"}], "==", 
                RowBox[{"angularVelocityState", "[", "t", "]"}]}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"angularVelocityState", "'"}], "[", "t", "]"}], "==", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "dampingCoefficient"}], " ", 
                  RowBox[{"angularVelocityState", "[", "t", "]"}]}], "-", 
                 RowBox[{"Sin", "[", 
                  RowBox[{"angleState", "[", "t", "]"}], "]"}]}]}]}], "}"}], 
             "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Plot", "[", 
             RowBox[{
              RowBox[{"angleSolution", "[", "t", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "0", ",", "30"}], "}"}], ",", 
              RowBox[{"AxesLabel", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<t\>\"", ",", "\"\<Angle\>\""}], "}"}]}], ",", 
              RowBox[{"GridLines", "->", "Automatic"}], ",", 
              RowBox[{"PlotLabel", "->", "\"\<Angular Displacement\>\""}]}], 
             "]"}], ",", 
            RowBox[{"ParametricPlot", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"angleSolution", "[", "t", "]"}], ",", 
                RowBox[{"angularVelocitySolution", "[", "t", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "0", ",", "30"}], "}"}], ",", 
              RowBox[{"AxesLabel", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<Angle\>\"", ",", "\"\<Angular Velocity\>\""}], 
                "}"}]}], ",", 
              RowBox[{"GridLines", "->", "Automatic"}], ",", 
              RowBox[{"PlotLabel", "->", "\"\<Phase Curve\>\""}]}], "]"}]}], 
           "}"}], "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialAngle", ",", "1.2", ",", "\"\<Initial angle\>\""}], 
