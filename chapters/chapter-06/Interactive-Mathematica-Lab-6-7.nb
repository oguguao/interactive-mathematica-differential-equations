         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              
              RowBox[{"\"\<Method\>\"", ",", "\"\<Observed Factor\>\"", 
               ",", "\"\<Theoretical Factor\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Euler\>\"", ",", 
               RowBox[{"N", "[", 
                RowBox[{"eulerRatio", ",", "6"}], "]"}], ",", "2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Modified Euler\>\"", ",", 
               RowBox[{"N", "[", 
