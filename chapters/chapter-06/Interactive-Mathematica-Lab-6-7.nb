          RowBox[{"1", ",", "4"}], "]"}], "]"}], "/", 
        RowBox[{"comparison", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "4"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
