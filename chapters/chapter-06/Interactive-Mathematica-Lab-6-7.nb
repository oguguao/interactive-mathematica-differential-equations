Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"slopeFunction", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", "y"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eulerFinal", "[", "stepSize_", "]"}], ":=", 
    RowBox[{"Nest", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"currentPoint", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"currentPoint", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "+", "stepSize"}], ",", 
          RowBox[{
           RowBox[{"currentPoint", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "+", 
           RowBox[{"stepSize", " ", 
            RowBox[{"slopeFunction", "[", 
             RowBox[{
              RowBox[{"currentPoint", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"currentPoint", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], "}"}]}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"0.", ",", "1."}], "}"}], ",", 
      RowBox[{"Round", "[", 
       RowBox[{"1", "/", "stepSize"}], "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"modifiedEulerFinal", "[", "stepSize_", "]"}], ":=", 
    RowBox[{"Nest", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"currentPoint", ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"currentX", "=", 
             RowBox[{"currentPoint", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"currentY", "=", 
             RowBox[{"currentPoint", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", "predictor"}], "}"}], ",", 
          RowBox[{
           RowBox[{"predictor", "=", 
            RowBox[{"currentY", "+", 
             RowBox[{"stepSize", " ", 
              RowBox[{"slopeFunction", "[", 
               RowBox[{"currentX", ",", "currentY"}], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"currentX", "+", "stepSize"}], ",", 
             RowBox[{"currentY", "+", 
              RowBox[{
               RowBox[{"stepSize", "/", "2"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"slopeFunction", "[", 
                  RowBox[{"currentX", ",", "currentY"}], "]"}], "+", 
                 RowBox[{"slopeFunction", "[", 
                  RowBox[{
                   RowBox[{"currentX", "+", "stepSize"}], ",", "predictor"}], 
                  "]"}]}], ")"}]}]}]}], "}"}]}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.", ",", "1."}], "}"}], ",", 
      RowBox[{"Round", "[", 
       RowBox[{"1", "/", "stepSize"}], "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rk4Final", "[", "stepSize_", "]"}], ":=", 
    RowBox[{"Nest", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"currentPoint", ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"currentX", "=", 
             RowBox[{"currentPoint", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"currentY", "=", 
             RowBox[{"currentPoint", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", "slope1", ",", "slope2", 
            ",", "slope3", ",", "slope4"}], "}"}], ",", 
          RowBox[{
           RowBox[{"slope1", "=", 
            RowBox[{"slopeFunction", "[", 
             RowBox[{"currentX", ",", "currentY"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"slope2", "=", 
            RowBox[{"slopeFunction", "[", 
             RowBox[{
              RowBox[{"currentX", "+", 
               RowBox[{"stepSize", "/", "2"}]}], ",", 
              RowBox[{"currentY", "+", 
               RowBox[{"stepSize", " ", 
                RowBox[{"slope1", "/", "2"}]}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"slope3", "=", 
            RowBox[{"slopeFunction", "[", 
             RowBox[{
              RowBox[{"currentX", "+", 
               RowBox[{"stepSize", "/", "2"}]}], ",", 
              RowBox[{"currentY", "+", 
               RowBox[{"stepSize", " ", 
                RowBox[{"slope2", "/", "2"}]}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
