      "\[IndentingNewLine]", 
      RowBox[{"comparison", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"currentStep", ",", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"eulerFinal", "[", "currentStep", "]"}], "[", 
