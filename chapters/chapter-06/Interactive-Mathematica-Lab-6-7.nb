            "}"}]}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.", ",", "1."}], "}"}], ",", 
      RowBox[{"Round", "[", 
       RowBox[{"1", "/", "stepSize"}], "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "stepSizes", ",", "comparison", ",", "eulerRatio", ",", "modifiedRatio",
