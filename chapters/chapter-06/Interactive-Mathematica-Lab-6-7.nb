              RowBox[{"\"\<h\>\"", ",", "\"\<Euler Error\>\"", 
               ",", "\"\<Modified Euler Error\>\"", 
               ",", "\"\<RK4 Error\>\""}], "}"}]}], "]"}], ",", 
           RowBox[{"Frame", "->", "All"}]}], "]"}], ",", 
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Observed Error-Reduction Factors When h Is Halved\>\"",
