Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`initialSlope$$ = 
    0, $CellContext`initialValue$$ = 1, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`initialValue$$], 1, "y(0)"}, -2, 2, 0.5, ControlType -> 
      Manipulator}, {{
       Hold[$CellContext`initialSlope$$], 0, "y'(0)"}, -2, 2, 0.5, 
      ControlType -> Manipulator}}, Typeset`size$$ = {
    742.236328125, {130.16374796487003`, 135.89568155862003`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`initialSlope$$ = 
        0, $CellContext`initialValue$$ = 1}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`transformEquation$, $CellContext`transformRule$, \
$CellContext`transformSolution$, $CellContext`partialFractionForm$, \
$CellContext`timeSolution$, $CellContext`verification$}, \
$CellContext`transformEquation$ = ($CellContext`s^2 $CellContext`transformY - \
$CellContext`s $CellContext`initialValue$$ - $CellContext`initialSlope$$) + 
           3 ($CellContext`s $CellContext`transformY - \
$CellContext`initialValue$$) + 2 $CellContext`transformY == 
          0; $CellContext`transformRule$ = First[
           
           Solve[$CellContext`transformEquation$, $CellContext`transformY]]; \
$CellContext`transformSolution$ = FullSimplify[
           
           ReplaceAll[$CellContext`transformY, $CellContext`transformRule$]]; \
$CellContext`partialFractionForm$ = 
         Apart[$CellContext`transformSolution$, $CellContext`s]; \
$CellContext`timeSolution$ = 
         InverseLaplaceTransform[$CellContext`transformSolution$, \
$CellContext`s, $CellContext`t]; $CellContext`verification$ = 
         FullSimplify[{
           D[$CellContext`timeSolution$, {$CellContext`t, 2}] + 
             3 D[$CellContext`timeSolution$, $CellContext`t] + 
             2 $CellContext`timeSolution$ == 0, 
            ReplaceAll[$CellContext`timeSolution$, $CellContext`t -> 
              0] == $CellContext`initialValue$$, ReplaceAll[
              D[$CellContext`timeSolution$, $CellContext`t], $CellContext`t -> 
              0] == $CellContext`initialSlope$$}]; Column[{
           Style[
           "Interactive Mathematica Lab 7.2: Inverse Transforms and \
Derivative Formulas", 18, Bold], 
           Row[{"Transformed equation:   ", 
             TraditionalForm[$CellContext`transformEquation$]}], 
           Row[{"Y(s):   ", 
             TraditionalForm[$CellContext`transformSolution$]}], 
           Row[{"Partial-fraction form:   ", 
             TraditionalForm[$CellContext`partialFractionForm$]}], 
           Row[{"Time-domain solution:   ", 
             
             TraditionalForm[$CellContext`y[$CellContext`t] == \
$CellContext`timeSolution$]}], 
           Row[{"Verification:   ", $CellContext`verification$}], 
           
           Plot[$CellContext`timeSolution$, {$CellContext`t, 0, 8}, PlotRange -> 
            All, AxesLabel -> {"t", "y(t)"}, GridLines -> Automatic, 
            PlotLabel -> "Solution Obtained by Laplace Transform"]}]], 
      "Specifications" :> {{{$CellContext`initialValue$$, 1, "y(0)"}, -2, 2, 
