Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "transformEquation", ",", "transformRule", ",", "transformSolution", ",",
        "partialFractionForm", ",", "timeSolution", ",", "verification"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"transformEquation", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "^", "2"}], " ", "transformY"}], "-", 
           RowBox[{"s", " ", "initialValue"}], "-", "initialSlope"}], ")"}], "+", 
         RowBox[{"3", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"s", " ", "transformY"}], "-", "initialValue"}], ")"}]}], 
         "+", 
         RowBox[{"2", " ", "transformY"}]}], "==", "0"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"transformRule", "=", 
       RowBox[{"First", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{"transformEquation", ",", "transformY"}], "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"transformSolution", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"transformY", "/.", "\[IndentingNewLine]", "transformRule"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"partialFractionForm", "=", 
       RowBox[{"Apart", "[", 
        RowBox[{"transformSolution", ",", "s"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"timeSolution", "=", 
       RowBox[{"InverseLaplaceTransform", "[", 
        RowBox[{"transformSolution", ",", "s", ",", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{"timeSolution", ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "+", 
            RowBox[{"3", " ", 
             RowBox[{"D", "[", 
              RowBox[{"timeSolution", ",", "t"}], "]"}]}], "+", 
            RowBox[{"2", " ", "timeSolution"}]}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"timeSolution", "/.", "\[IndentingNewLine]", 
             RowBox[{"t", "->", "0"}]}], ")"}], "==", "initialValue"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"timeSolution", ",", "t"}], "]"}], "/.", 
             "\[IndentingNewLine]", 
             RowBox[{"t", "->", "0"}]}], ")"}], "==", "initialSlope"}]}], 
         "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 7.2: Inverse Transforms \
and Derivative Formulas\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Transformed equation:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "transformEquation", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Y(s):   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "transformSolution", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Partial-fraction form:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "partialFractionForm", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Time-domain solution:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"y", "[", "t", "]"}], "==", "timeSolution"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification:   \>\"", ",", "verification"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{"timeSolution", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "8"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<t\>\"", ",", "\"\<y(t)\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Solution Obtained by Laplace Transform\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialValue", ",", "1", ",", "\"\<y(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialSlope", ",", "0", ",", "\"\<y'(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
