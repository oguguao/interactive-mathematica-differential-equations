          "Exponential Shift", $CellContext`baseTransform$ = LaplaceTransform[
             Sin[
             3 $CellContext`t], $CellContext`t, $CellContext`s]; \
$CellContext`propertyResult$ = 
           ReplaceAll[$CellContext`baseTransform$, $CellContext`s -> \
