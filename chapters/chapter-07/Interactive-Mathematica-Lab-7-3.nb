Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "baseTransform", ",", "propertyResult", ",", "directResult", ",", 
       "verification", ",", "explanation"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"propertyChoice", "==", "\"\<Exponential Shift\>\""}], ",", 
        RowBox[{
         RowBox[{"baseTransform", "=", 
          RowBox[{"LaplaceTransform", "[", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"3", " ", "t"}], "]"}], ",", "t", ",", "s"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"propertyResult", "=", 
          RowBox[{"baseTransform", "/.", "\[IndentingNewLine]", 
           RowBox[{"s", "->", 
            RowBox[{"s", "-", "shiftAmount"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"directResult", "=", 
          RowBox[{"LaplaceTransform", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"shiftAmount", " ", "t"}], "]"}], "*", 
             RowBox[{"Sin", "[", 
              RowBox[{"3", " ", "t"}], "]"}]}], ",", "t", ",", "s"}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"explanation", "=", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Property used: F(s) becomes F(s - \>\"", ",", 
             "shiftAmount", ",", "\"\<)\>\""}], "}"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"baseTransform", "=", 
          RowBox[{"LaplaceTransform", "[", 
           RowBox[{
            RowBox[{"Cos", "[", "t", "]"}], ",", "t", ",", "s"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"propertyResult", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "timePower"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{"baseTransform", ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "timePower"}], "}"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"directResult", "=", 
          RowBox[{"LaplaceTransform", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"t", "^", "timePower"}], " ", 
             RowBox[{"Cos", "[", "t", "]"}]}], ",", "t", ",", "s"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"explanation", "=", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Property used: L{t^n f(t)} = (-1)^n d^nF/ds^n, n = \
\>\"", ",", "timePower"}], "}"}], "]"}]}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"propertyResult", "==", "directResult"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 7.3: Operational \
Properties I\>\"", ",", "18", ",", "Bold"}], "]"}], ",", "explanation", ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Base transform:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "baseTransform", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Using the property:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "propertyResult", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Direct transformation:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "directResult", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Results agree:   \>\"", ",", "verification"}], "}"}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "propertyChoice", ",", "\"\<Exponential Shift\>\"", 
       ",", "\"\<Choose property\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Exponential Shift\>\"", 
       ",", "\"\<Multiplication by t^n\>\""}], "}"}], ",", 
     RowBox[{"ControlType", "->", "SetterBar"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"shiftAmount", ",", "2", ",", "\"\<Exponential shift a\>\""}], 
      "}"}], ",", 
     RowBox[{"-", "2"}], ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"timePower", ",", "2", ",", "\"\<Power n\>\""}], "}"}], ",", 
     "1", ",", "4", ",", "1"}], "}"}]}], "]"}]}], "Input",
