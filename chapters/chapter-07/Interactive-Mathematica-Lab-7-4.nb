Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "forcingFunction", ",", "transformForcing", ",", "responseTransform", ",",
        "responseFunction"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"forcingFunction", "[", "t_", "]"}], ":=", 
       RowBox[{"inputMagnitude", "*", 
        RowBox[{"UnitStep", "[", 
         RowBox[{"t", "-", "switchingTime"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"transformForcing", "=", 
       RowBox[{"inputMagnitude", "*", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "switchingTime"}], " ", "s"}], "]"}], "/", "s"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"responseTransform", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"transformForcing", "/", 
         RowBox[{"(", 
          RowBox[{"s", "+", "1"}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"responseFunction", "[", "t_", "]"}], ":=", 
       RowBox[{"inputMagnitude", "*", 
        RowBox[{"UnitStep", "[", 
         RowBox[{"t", "-", "switchingTime"}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"t", "-", "switchingTime"}], ")"}]}], "]"}]}], ")"}]}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 7.4: Unit Steps and \
Delayed Inputs\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Switching time:   \>\"", ",", "switchingTime"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Input magnitude:   \>\"", ",", "inputMagnitude"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Laplace transform of input:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "transformForcing", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Transform-domain response:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "responseTransform", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"forcingFunction", "[", "t", "]"}], ",", 
             RowBox[{"responseFunction", "[", "t", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Input\>\"", ",", "\"\<Response\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<t\>\"", ",", "\"\<Value\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "switchingTime", "}"}], ",", "Automatic"}], 
             "}"}]}], ",", 
           RowBox[{"Exclusions", "->", 
            RowBox[{"{", "switchingTime", "}"}]}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Delayed Input and System Response\>\""}]}],
           "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"switchingTime", ",", "2", ",", "\"\<Switching time\>\""}], 
      "}"}], ",", "0.5", ",", "6", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
