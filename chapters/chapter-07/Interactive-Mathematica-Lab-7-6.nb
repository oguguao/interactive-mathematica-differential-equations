Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "responseTransform", ",", "responseFunction", ",", "inverseResult", ",",
        "verification"}], "}"}], ",", 
     RowBox[{
      RowBox[{"responseTransform", "=", 
       RowBox[{"impulseStrength", "*", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "impulseTime"}], " ", "s"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"s", "^", "2"}], "+", 
           RowBox[{"naturalFrequency", "^", "2"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"responseFunction", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{"impulseStrength", "/", "naturalFrequency"}], "*", 
        RowBox[{"UnitStep", "[", 
         RowBox[{"t", "-", "impulseTime"}], "]"}], "*", 
        RowBox[{"Sin", "[", 
         RowBox[{"naturalFrequency", "*", 
          RowBox[{"(", 
           RowBox[{"t", "-", "impulseTime"}], ")"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"inverseResult", "=", 
       RowBox[{"InverseLaplaceTransform", "[", 
        RowBox[{"responseTransform", ",", "s", ",", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"inverseResult", "==", 
          RowBox[{"responseFunction", "[", "t", "]"}]}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{
           RowBox[{"t", ">=", "0"}], "&&", 
           RowBox[{"impulseTime", ">", "0"}], "&&", 
           RowBox[{"naturalFrequency", ">", "0"}], "&&", 
           RowBox[{"t", "!=", "impulseTime"}]}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 7.6: Dirac Delta and \
Impulse Inputs\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Impulse time:   \>\"", ",", "impulseTime"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Impulse strength:   \>\"", ",", "impulseStrength"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Natural frequency:   \>\"", ",", "naturalFrequency"}],
            "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Transform-domain response:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "responseTransform", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Time-domain response:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"responseFunction", "[", "t", "]"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Inverse-transform check:   \>\"", ",", 
            "verification"}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"responseFunction", "[", "t", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "12"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<t\>\"", ",", "\"\<y(t)\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "impulseTime", "}"}], ",", "Automatic"}], "}"}]}], 
           ",", 
           RowBox[{"Exclusions", "->", 
            RowBox[{"{", "impulseTime", "}"}]}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Oscillator Response to a Delayed Impulse\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"impulseTime", ",", "Pi", ",", "\"\<Impulse time\>\""}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "->", "\"\<1\>\""}], ",", 
       RowBox[{"2", "->", "\"\<2\>\""}], ",", 
       RowBox[{"Pi", "->", "\"\<Pi\>\""}], ",", 
       RowBox[{"4", "->", "\"\<4\>\""}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"impulseStrength", ",", "1", ",", "\"\<Impulse strength\>\""}], 
      "}"}], ",", "0.5", ",", "4", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "naturalFrequency", ",", "1", ",", "\"\<Natural frequency\>\""}], "}"}],
      ",", "0.5", ",", "3", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
