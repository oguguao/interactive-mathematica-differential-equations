         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`responseTransform$, \
$CellContext`responseFunction$, $CellContext`inverseResult$, \
$CellContext`verification$}, $CellContext`responseTransform$ = \
$CellContext`impulseStrength$$ (
           Exp[(-$CellContext`impulseTime$$) \
$CellContext`s]/($CellContext`s^2 + $CellContext`naturalFrequency$$^2)); \
$CellContext`responseFunction$[
           Pattern[$CellContext`t$, 
            
            Blank[]]] := \
($CellContext`impulseStrength$$/$CellContext`naturalFrequency$$) 
          UnitStep[$CellContext`t$ - $CellContext`impulseTime$$] 
          Sin[$CellContext`naturalFrequency$$ ($CellContext`t$ - \
$CellContext`impulseTime$$)]; $CellContext`inverseResult$ = 
