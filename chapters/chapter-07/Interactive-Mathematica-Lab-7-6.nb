     1, StandardForm, 
      "Variables" :> {$CellContext`impulseStrength$$ = 
        1, $CellContext`impulseTime$$ = Pi, $CellContext`naturalFrequency$$ = 
        1}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
