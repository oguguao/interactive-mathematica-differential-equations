           Row[{"Impulse time:   ", $CellContext`impulseTime$$}], 
           Row[{"Impulse strength:   ", $CellContext`impulseStrength$$}], 
           Row[{"Natural frequency:   ", $CellContext`naturalFrequency$$}], 
           Row[{"Transform-domain response:   ", 
             TraditionalForm[$CellContext`responseTransform$]}], 
           Row[{"Time-domain response:   ", 
