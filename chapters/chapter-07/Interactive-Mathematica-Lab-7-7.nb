           Plot[{$CellContext`timeResponse$, $CellContext`steadyStateValue$}, \
{$CellContext`t, 0, 15}, PlotRange -> All, 
            PlotLegends -> {"Response", "Steady-state value"}, 
            AxesLabel -> {"t", "Response"}, 
            GridLines -> {{$CellContext`delayTime$$}, Automatic}, 
