Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "transferFunction", ",", "inputTransform", ",", "responseTransform", ",",
        "timeResponse", ",", "steadyStateValue"}], "}"}], ",", 
     RowBox[{
      RowBox[{"transferFunction", "=", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"s", "^", "2"}], "+", 
          RowBox[{"dampingCoefficient", " ", "s"}], "+", 
          "stiffnessCoefficient"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"inputTransform", "=", 
       RowBox[{"forcingMagnitude", "*", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "delayTime"}], " ", "s"}], "]"}], "/", "s"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"responseTransform", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"transferFunction", "*", "inputTransform"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"timeResponse", "=", 
       RowBox[{"InverseLaplaceTransform", "[", 
        RowBox[{"responseTransform", ",", "s", ",", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"steadyStateValue", "=", 
       RowBox[{"forcingMagnitude", "/", "stiffnessCoefficient"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 7.7: Applications of \
Laplace Transforms\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Transfer function H(s):   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "transferFunction", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Input transform G(s):   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "inputTransform", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Response transform Y(s):   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "responseTransform", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Predicted steady-state value:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "steadyStateValue", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"timeResponse", ",", "steadyStateValue"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "15"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Response\>\"", ",", "\"\<Steady-state value\>\""}], 
             "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<t\>\"", ",", "\"\<Response\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "delayTime", "}"}], ",", "Automatic"}], "}"}]}], ",", 
           RowBox[{"Exclusions", "->", 
            RowBox[{"{", "delayTime", "}"}]}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<Delayed Forced Response\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"delayTime", ",", "1", ",", "\"\<Delay time\>\""}], "}"}], ",", 
     "0.5", ",", "4", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"forcingMagnitude", ",", "10", ",", "\"\<Step magnitude\>\""}], 
      "}"}], ",", "2", ",", "20", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dampingCoefficient", ",", "2", ",", "\"\<Damping coefficient\>\""}], 
      "}"}], ",", "0.5", ",", "5", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "stiffnessCoefficient", ",", "5", 
       ",", "\"\<Restoring coefficient\>\""}], "}"}], ",", "1", ",", "10", ",",
      "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9974797646889133`*^9, 3.9974797646889133`*^9}},
 CellLabel->
