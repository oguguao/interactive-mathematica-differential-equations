       Hold[$CellContext`dampingCoefficient$$], 2, "Damping coefficient"}, 
      0.5, 5, 0.5, ControlType -> Manipulator}, {{
       Hold[$CellContext`stiffnessCoefficient$$], 5, "Restoring coefficient"},
       1, 10, 1, ControlType -> Manipulator}}, Typeset`size$$ = {
    663.064453125, {123.13628512364843`, 128.86821871739843`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`dampingCoefficient$$ = 
        2, $CellContext`delayTime$$ = 1, $CellContext`forcingMagnitude$$ = 
        10, $CellContext`stiffnessCoefficient$$ = 5}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`transferFunction$, $CellContext`inputTransform$, \
$CellContext`responseTransform$, $CellContext`timeResponse$, \
$CellContext`steadyStateValue$}, $CellContext`transferFunction$ = 
         1/($CellContext`s^2 + $CellContext`dampingCoefficient$$ \
$CellContext`s + $CellContext`stiffnessCoefficient$$); \
$CellContext`inputTransform$ = $CellContext`forcingMagnitude$$ (
           Exp[(-$CellContext`delayTime$$) $CellContext`s]/$CellContext`s); \
$CellContext`responseTransform$ = 
         FullSimplify[$CellContext`transferFunction$ \
$CellContext`inputTransform$]; $CellContext`timeResponse$ = 
         InverseLaplaceTransform[$CellContext`responseTransform$, \
$CellContext`s, $CellContext`t]; $CellContext`steadyStateValue$ = \
$CellContext`forcingMagnitude$$/$CellContext`stiffnessCoefficient$$; Column[{
