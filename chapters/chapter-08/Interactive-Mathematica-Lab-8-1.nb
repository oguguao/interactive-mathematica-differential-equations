Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "coefficientMatrix", ",", "eigenvalues", ",", "eigenvectors", ",", 
       "fundamentalMatrix", ",", "matrixCheck", ",", "tolerance", ",", 
       "classification"}], "}"}], ",", 
     RowBox[{
      RowBox[{"coefficientMatrix", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"entry11", ",", "entry12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"entry21", ",", "entry22"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eigenvalues", ",", "eigenvectors"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", "coefficientMatrix", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fundamentalMatrix", "[", "t_", "]"}], ":=", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{"coefficientMatrix", " ", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"matrixCheck", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"fundamentalMatrix", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
         RowBox[{"coefficientMatrix", ".", 
          RowBox[{"fundamentalMatrix", "[", "t", "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tolerance", "=", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"classification", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Im", "[", 
              RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "]"}], "<",
            "tolerance"}], "&&", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "<", "0"}],
           "&&", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], ">", 
           "0"}]}], ",", "\"\<Saddle point\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Im", "[", 
              RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "]"}], "<",
            "tolerance"}], "&&", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "<", 
           "0"}]}], ",", "\"\<Stable node\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Im", "[", 
              RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "]"}], "<",
            "tolerance"}], "&&", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], ">", 
           "0"}]}], ",", "\"\<Unstable node\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Im", "[", 
              RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "]"}], ">=",
            "tolerance"}], "&&", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "<", 
           RowBox[{"-", "tolerance"}]}]}], ",", "\"\<Stable spiral\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Im", "[", 
              RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "]"}], ">=",
            "tolerance"}], "&&", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], ">", 
           "tolerance"}]}], ",", "\"\<Unstable spiral\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Im", "[", 
              RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "]"}], ">=",
            "tolerance"}], "&&", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Re", "[", 
              RowBox[{"N", "[", "eigenvalues", "]"}], "]"}], "]"}], "]"}], "<",
            "tolerance"}]}], ",", "\"\<Center\>\"", ",", "True", 
         ",", "\"\<Degenerate or boundary case\>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 8.1: Preliminary Theory \
\[LongDash] Linear Systems\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Coefficient matrix:   \>\"", ",", 
            RowBox[{"MatrixForm", "[", "coefficientMatrix", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Eigenvalues:   \>\"", ",", "eigenvalues"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Eigenvectors:   \>\"", ",", "eigenvectors"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Equilibrium classification:   \>\"", ",", 
            "classification"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Matrix exponential satisfies Phi'(t) = A Phi(t):   \>\
\"", ",", "matrixCheck"}], "}"}], "]"}], ",", 
         RowBox[{"StreamPlot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{"coefficientMatrix", ".", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Phase Portrait of X' = A X\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"entry11", ",", "3", ",", "\"\<a11\>\""}], "}"}], ",", 
     RowBox[{"-", "4"}], ",", "4", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"entry12", ",", "2", ",", "\"\<a12\>\""}], "}"}], ",", 
     RowBox[{"-", "4"}], ",", "4", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"entry21", ",", "1", ",", "\"\<a21\>\""}], "}"}], ",", 
     RowBox[{"-", "4"}], ",", "4", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"entry22", ",", "4", ",", "\"\<a22\>\""}], "}"}], ",", 
     RowBox[{"-", "4"}], ",", "4", ",", "1"}], "}"}]}], "]"}]}], "Input",
