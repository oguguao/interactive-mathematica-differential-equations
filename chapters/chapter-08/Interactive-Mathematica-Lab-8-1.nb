     0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`entry11$$ = 3, $CellContext`entry12$$ = 
        2, $CellContext`entry21$$ = 1, $CellContext`entry22$$ = 4}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`coefficientMatrix$, $CellContext`eigenvalues$, \
$CellContext`eigenvectors$, $CellContext`fundamentalMatrix$, \
$CellContext`matrixCheck$, $CellContext`tolerance$, \
$CellContext`classification$}, $CellContext`coefficientMatrix$ = \
{{$CellContext`entry11$$, $CellContext`entry12$$}, {$CellContext`entry21$$, \
$CellContext`entry22$$}}; {$CellContext`eigenvalues$, \
$CellContext`eigenvectors$} = 
         Eigensystem[$CellContext`coefficientMatrix$]; \
$CellContext`fundamentalMatrix$[
           Pattern[$CellContext`t$, 
            Blank[]]] := 
         MatrixExp[$CellContext`coefficientMatrix$ $CellContext`t$]; \
$CellContext`matrixCheck$ = FullSimplify[D[
             $CellContext`fundamentalMatrix$[$CellContext`t], $CellContext`t] == 
           Dot[$CellContext`coefficientMatrix$, 
             $CellContext`fundamentalMatrix$[$CellContext`t]]]; \
$CellContext`tolerance$ = 10^(-8); $CellContext`classification$ = Which[
           And[Max[
              Abs[
               Im[
                N[$CellContext`eigenvalues$]]]] < $CellContext`tolerance$, Min[
              Re[
               N[$CellContext`eigenvalues$]]] < 0, Max[
              Re[
               N[$CellContext`eigenvalues$]]] > 0], "Saddle point", 
           And[Max[
              Abs[
               Im[
                N[$CellContext`eigenvalues$]]]] < $CellContext`tolerance$, Max[
              Re[
               N[$CellContext`eigenvalues$]]] < 0], "Stable node", 
           And[Max[
              Abs[
               Im[
                N[$CellContext`eigenvalues$]]]] < $CellContext`tolerance$, Min[
              Re[
               N[$CellContext`eigenvalues$]]] > 0], "Unstable node", 
           And[Max[
              Abs[
               Im[
                N[$CellContext`eigenvalues$]]]] >= $CellContext`tolerance$, 
            Max[
              Re[
               N[$CellContext`eigenvalues$]]] < -$CellContext`tolerance$], 
           "Stable spiral", 
           And[Max[
              Abs[
               Im[
                N[$CellContext`eigenvalues$]]]] >= $CellContext`tolerance$, 
            Min[
              Re[
               N[$CellContext`eigenvalues$]]] > $CellContext`tolerance$], 
           "Unstable spiral", 
           And[Max[
              Abs[
               Im[
                N[$CellContext`eigenvalues$]]]] >= $CellContext`tolerance$, 
            Max[
              Abs[
               Re[
                N[$CellContext`eigenvalues$]]]] < $CellContext`tolerance$], 
           "Center", True, "Degenerate or boundary case"]; Column[{
           Style[
           "Interactive Mathematica Lab 8.1: Preliminary Theory \[LongDash] \
Linear Systems", 18, Bold], 
           Row[{"Coefficient matrix:   ", 
             MatrixForm[$CellContext`coefficientMatrix$]}], 
           Row[{"Eigenvalues:   ", $CellContext`eigenvalues$}], 
           Row[{"Eigenvectors:   ", $CellContext`eigenvectors$}], 
           
           Row[{"Equilibrium classification:   ", \
$CellContext`classification$}], 
           
           Row[{"Matrix exponential satisfies Phi'(t) = A Phi(t):   ", \
$CellContext`matrixCheck$}], 
           StreamPlot[
            Evaluate[
             
             Dot[$CellContext`coefficientMatrix$, {$CellContext`x, \
$CellContext`y}]], {$CellContext`x, -3, 3}, {$CellContext`y, -3, 3}, 
