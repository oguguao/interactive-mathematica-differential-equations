Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "coefficientMatrix", ",", "initialVector", ",", "eigenvalues", ",", 
       "eigenvectors", ",", "solution", ",", "verification", ",", 
       "qualitativeBehavior"}], "}"}], ",", 
     RowBox[{
      RowBox[{"coefficientMatrix", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"realPart", ",", "rotationRate"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "rotationRate"}], ",", "realPart"}], "}"}]}], "}"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"initialVector", "=", 
       RowBox[{"{", 
        RowBox[{"initialX1", ",", "initialX2"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eigenvalues", ",", "eigenvectors"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", "coefficientMatrix", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"solution", "[", "t_", "]"}], ":=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"MatrixExp", "[", 
          RowBox[{"coefficientMatrix", " ", "t"}], "]"}], ".", 
         "initialVector"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"verification", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"solution", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
           RowBox[{"coefficientMatrix", ".", 
            RowBox[{"solution", "[", "t", "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"solution", "[", "0", "]"}], "==", "initialVector"}]}], 
         "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qualitativeBehavior", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"realPart", "<", "0"}], 
         ",", "\"\<Stable spiral \[LongDash] trajectories move toward the \
origin\>\"", ",", 
         RowBox[{"realPart", ">", "0"}], 
         ",", "\"\<Unstable spiral \[LongDash] trajectories move away from \
the origin\>\"", ",", 
         RowBox[{"realPart", "==", "0"}], 
         ",", "\"\<Center \[LongDash] trajectories remain at constant \
distance from the origin\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 8.2: Homogeneous Linear \
Systems\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Coefficient matrix:   \>\"", ",", 
            RowBox[{"MatrixForm", "[", "coefficientMatrix", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Eigenvalues:   \>\"", ",", "eigenvalues"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Eigenvectors:   \>\"", ",", "eigenvectors"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Behavior:   \>\"", ",", "qualitativeBehavior"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Solution vector:   \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"solution", "[", "t", "]"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Verification:   \>\"", ",", "verification"}], "}"}], 
          "]"}], ",", 
         RowBox[{"ParametricPlot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{"solution", "[", "t", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "8"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x1\>\"", ",", "\"\<x2\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Trajectory in the Phase Plane\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"realPart", ",", "1", ",", "\"\<Real part of eigenvalues\>\""}],
       "}"}], ",", 
     RowBox[{"-", "1.5"}], ",", "1.5", ",", "0.25"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
