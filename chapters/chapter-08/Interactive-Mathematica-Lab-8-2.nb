   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialX1", ",", "1", ",", "\"\<x1(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialX2", ",", "0", ",", "\"\<x2(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}]}], "]"}]}], "Input",
