Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "targetFunction", ",", "taylorPolynomial", ",", "pointError", ",", 
       "exactValue", ",", "approximateValue"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"targetFunction", "[", "x_", "]"}], ":=", 
       RowBox[{
        RowBox[{"Exp", "[", "x", "]"}], " ", 
        RowBox[{"Cos", "[", "x", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"taylorPolynomial", "=", 
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"targetFunction", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "degree"}], "}"}]}], "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"exactValue", "=", 
       RowBox[{"N", "[", 
        RowBox[{"targetFunction", "[", "evaluationPoint", "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"approximateValue", "=", 
       RowBox[{"N", "[", 
        RowBox[{"taylorPolynomial", "/.", "\[IndentingNewLine]", 
         RowBox[{"x", "->", "evaluationPoint"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pointError", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{"exactValue", "-", "approximateValue"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 9.1: Power-Series Review\>\
\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Taylor polynomial degree: \>\"", ",", "degree"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Taylor polynomial: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "taylorPolynomial", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Exact value at x = \>\"", ",", "evaluationPoint", 
            ",", "\"\<: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"exactValue", ",", 
              RowBox[{"{", 
               RowBox[{"10", ",", "6"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Polynomial approximation: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"approximateValue", ",", 
              RowBox[{"{", 
               RowBox[{"10", ",", "6"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Absolute error: \>\"", ",", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{"pointError", ",", "5"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"targetFunction", "[", "x", "]"}], ",", 
             "taylorPolynomial"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Exp[x] Cos[x]\>\"", 
              ",", "\"\<Taylor polynomial\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<Value\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Taylor Approximation About x = 0\>\""}]}], 
          "]"}]}], "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"degree", ",", "4", ",", "\"\<Polynomial degree\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4", ",", "6", ",", "8", ",", "10", ",", "12"}], 
      "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "evaluationPoint", ",", "1", ",", "\"\<Error evaluation point\>\""}], 
      "}"}], ",", 
     RowBox[{"-", "1.5"}], ",", "1.5", ",", "0.25"}], "}"}]}], 
  "]"}]}], "Input",
