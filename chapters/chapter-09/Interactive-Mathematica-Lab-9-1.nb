           Plot[{
             $CellContext`targetFunction$[$CellContext`x], \
$CellContext`taylorPolynomial$}, {$CellContext`x, -2, 2}, PlotRange -> All, 
            PlotLegends -> {"Exp[x] Cos[x]", "Taylor polynomial"}, 
            AxesLabel -> {"x", "Value"}, GridLines -> Automatic, PlotLabel -> 
            "Taylor Approximation About x = 0"]}]], 
      "Specifications" :> {{{$CellContext`degree$$, 4, "Polynomial degree"}, {
