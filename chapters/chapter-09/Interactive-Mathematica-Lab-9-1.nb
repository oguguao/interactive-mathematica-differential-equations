         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`targetFunction$, $CellContext`taylorPolynomial$, \
$CellContext`pointError$, $CellContext`exactValue$, \
$CellContext`approximateValue$}, $CellContext`targetFunction$[
           Pattern[$CellContext`x, 
            Blank[]]] := 
         Exp[$CellContext`x] 
          Cos[$CellContext`x]; $CellContext`taylorPolynomial$ = Normal[
           Series[
            $CellContext`targetFunction$[$CellContext`x], {$CellContext`x, 
             0, $CellContext`degree$$}]]; $CellContext`exactValue$ = N[
           $CellContext`targetFunction$[$CellContext`evaluationPoint$$]]; \
$CellContext`approximateValue$ = N[
           
           ReplaceAll[$CellContext`taylorPolynomial$, $CellContext`x -> \
$CellContext`evaluationPoint$$]]; $CellContext`pointError$ = 
         Abs[$CellContext`exactValue$ - $CellContext`approximateValue$]; 
        Column[{
           Style[
           "Interactive Mathematica Lab 9.1: Power-Series Review", 18, Bold], 
           Row[{"Taylor polynomial degree: ", $CellContext`degree$$}], 
           Row[{"Taylor polynomial: ", 
             TraditionalForm[$CellContext`taylorPolynomial$]}], 
           Row[{"Exact value at x = ", $CellContext`evaluationPoint$$, ": ", 
             NumberForm[$CellContext`exactValue$, {10, 6}]}], 
           Row[{"Polynomial approximation: ", 
             NumberForm[$CellContext`approximateValue$, {10, 6}]}], 
           Row[{"Absolute error: ", 
