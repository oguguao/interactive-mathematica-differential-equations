Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`center$$ = 0, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`center$$], 0, "Expansion center"}, -2, 2, 0.25, 
      ControlType -> Manipulator}}, Typeset`size$$ = {
    475.03125, {57.09703369140625, 62.82896728515625}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`center$$ = 0}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`leadingCoefficient$, \
$CellContext`firstCoefficient$, $CellContext`zeroCoefficient$, \
$CellContext`normalizedP$, $CellContext`normalizedQ$, \
$CellContext`singularPoints$, $CellContext`ordinaryAtCenter$, \
$CellContext`distances$, $CellContext`nearestDistance$}, \
$CellContext`leadingCoefficient$[
           Pattern[$CellContext`x, 
            Blank[]]] := 1 + $CellContext`x^2; $CellContext`firstCoefficient$[
           Pattern[$CellContext`x, 
            Blank[]]] := $CellContext`x; $CellContext`zeroCoefficient$[
           Pattern[$CellContext`x, 
            Blank[]]] := -1; $CellContext`normalizedP$[
           Pattern[$CellContext`x$, 
            Blank[]]] := 
         FullSimplify[$CellContext`firstCoefficient$[$CellContext`x$]/$\
CellContext`leadingCoefficient$[$CellContext`x$]]; $CellContext`normalizedQ$[
           Pattern[$CellContext`x$, 
            Blank[]]] := 
         FullSimplify[$CellContext`zeroCoefficient$[$CellContext`x$]/$\
CellContext`leadingCoefficient$[$CellContext`x$]]; \
$CellContext`singularPoints$ = ReplaceAll[$CellContext`x, 
           
           Solve[$CellContext`leadingCoefficient$[$CellContext`x] == 
            0, $CellContext`x, Complexes]]; $CellContext`ordinaryAtCenter$ = 
         And[
           Not[
            PossibleZeroQ[
             $CellContext`leadingCoefficient$[$CellContext`center$$]]], 
           Not[
            PossibleZeroQ[
             ReplaceAll[
              Denominator[
               Together[
                $CellContext`normalizedP$[$CellContext`x]]], $CellContext`x -> \
$CellContext`center$$]]], 
           Not[
            PossibleZeroQ[
             ReplaceAll[
              Denominator[
               Together[
                $CellContext`normalizedQ$[$CellContext`x]]], $CellContext`x -> \
$CellContext`center$$]]]]; $CellContext`distances$ = N[
           Map[
           Abs[$CellContext`center$$ - #]& , $CellContext`singularPoints$]]; \
$CellContext`nearestDistance$ = Min[$CellContext`distances$]; Column[{
           Style[
           "Interactive Mathematica Lab 9.2: Ordinary Points", 18, Bold], 
           Row[{"Differential-equation leading coefficient: ", 
             TraditionalForm[
              $CellContext`leadingCoefficient$[$CellContext`x]]}], 
           Row[{"Singular points: ", $CellContext`singularPoints$}], 
           Row[{"Expansion center: ", $CellContext`center$$}], 
           
           Row[{"Ordinary at selected center: ", \
$CellContext`ordinaryAtCenter$}], 
           Row[{"Distances to singularities: ", $CellContext`distances$}], 
           Row[{"Guaranteed radius of convergence: ", 
             NumberForm[$CellContext`nearestDistance$, {8, 4}]}]}]], 
      "Specifications" :> {{{$CellContext`center$$, 0, 
