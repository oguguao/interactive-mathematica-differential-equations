Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "leadingCoefficient", ",", "firstCoefficient", ",", "zeroCoefficient", ",",
        "normalizedP", ",", "normalizedQ", ",", "singularPoints", ",", 
       "ordinaryAtCenter", ",", "distances", ",", "nearestDistance"}], "}"}], 
     ",", 
     RowBox[{
      RowBox[{
       RowBox[{"leadingCoefficient", "[", "x_", "]"}], ":=", 
       RowBox[{"1", "+", 
        RowBox[{"x", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"firstCoefficient", "[", "x_", "]"}], ":=", "x"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"zeroCoefficient", "[", "x_", "]"}], ":=", 
       RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"normalizedP", "[", "x_", "]"}], ":=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"firstCoefficient", "[", "x", "]"}], "/", 
         RowBox[{"leadingCoefficient", "[", "x", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"normalizedQ", "[", "x_", "]"}], ":=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"zeroCoefficient", "[", "x", "]"}], "/", 
         RowBox[{"leadingCoefficient", "[", "x", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"singularPoints", "=", 
       RowBox[{"x", "/.", "\[IndentingNewLine]", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"leadingCoefficient", "[", "x", "]"}], "==", "0"}], ",", 
          "x", ",", "Complexes"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ordinaryAtCenter", "=", 
       RowBox[{"And", "[", 
        RowBox[{
         RowBox[{"Not", "[", 
          RowBox[{"PossibleZeroQ", "[", 
           RowBox[{"leadingCoefficient", "[", "center", "]"}], "]"}], "]"}], ",", 
         RowBox[{"Not", "[", 
          RowBox[{"PossibleZeroQ", "[", 
           RowBox[{
            RowBox[{"Denominator", "[", 
             RowBox[{"Together", "[", 
              RowBox[{"normalizedP", "[", "x", "]"}], "]"}], "]"}], "/.", 
            "\[IndentingNewLine]", 
            RowBox[{"x", "->", "center"}]}], "]"}], "]"}], ",", 
         RowBox[{"Not", "[", 
          RowBox[{"PossibleZeroQ", "[", 
           RowBox[{
            RowBox[{"Denominator", "[", 
             RowBox[{"Together", "[", 
              RowBox[{"normalizedQ", "[", "x", "]"}], "]"}], "]"}], "/.", 
            "\[IndentingNewLine]", 
            RowBox[{"x", "->", "center"}]}], "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"distances", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"center", "-", "#"}], "]"}], "&"}], "/@", 
         "singularPoints"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nearestDistance", "=", 
       RowBox[{"Min", "[", "distances", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 9.2: Ordinary Points\>\"", 
           ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Differential-equation leading coefficient: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", 
             RowBox[{"leadingCoefficient", "[", "x", "]"}], "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Singular points: \>\"", ",", "singularPoints"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Expansion center: \>\"", ",", "center"}], "}"}], 
          "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Ordinary at selected center: \>\"", ",", 
            "ordinaryAtCenter"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Distances to singularities: \>\"", ",", "distances"}],
            "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Guaranteed radius of convergence: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"nearestDistance", ",", 
              RowBox[{"{", 
               RowBox[{"8", ",", "4"}], "}"}]}], "]"}]}], "}"}], "]"}]}], 
        "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"center", ",", "0", ",", "\"\<Expansion center\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.25"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.997480823476118*^9, 3.997480823476118*^9}},
 CellLabel->
