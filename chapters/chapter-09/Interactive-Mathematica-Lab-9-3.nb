Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "seriesSolution", ",", "seriesPolynomial", ",", "numericalSolution", ",",
        "errorAtPoint"}], "}"}], ",", 
     RowBox[{
      RowBox[{"seriesSolution", "=", 
       RowBox[{"AsymptoticDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"y", "''"}], "[", "x", "]"}], "+", 
             RowBox[{"x", " ", 
              RowBox[{"y", "[", "x", "]"}]}]}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"y", "[", "0", "]"}], "==", "initialValue"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "0", "]"}], "==", "initialSlope"}]}], 
          "}"}], ",", 
         RowBox[{"y", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "seriesOrder"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"seriesPolynomial", "=", 
       RowBox[{"Normal", "[", "seriesSolution", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"numericalSolution", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"y", "''"}], "[", "x", "]"}], "+", 
             RowBox[{"x", " ", 
              RowBox[{"y", "[", "x", "]"}]}]}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{"y", "[", "0", "]"}], "==", "initialValue"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "0", "]"}], "==", "initialSlope"}]}], 
          "}"}], ",", "y", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"errorAtPoint", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"seriesPolynomial", "/.", "\[IndentingNewLine]", 
           RowBox[{"x", "->", "comparisonPoint"}]}], ")"}], "-", 
         RowBox[{"numericalSolution", "[", "comparisonPoint", "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 9.3: Power-Series \
Solutions at Ordinary Points\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Requested series order: \>\"", ",", "seriesOrder"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Series polynomial: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "seriesPolynomial", "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Absolute difference at x = \>\"", ",", 
            "comparisonPoint", ",", "\"\<: \>\"", ",", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{
              RowBox[{"N", "[", "errorAtPoint", "]"}], ",", "5"}], "]"}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"seriesPolynomial", ",", 
             RowBox[{"numericalSolution", "[", "x", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Series polynomial\>\"", 
              ",", "\"\<Numerical solution\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Local Series and Numerical Solution\>\""}]}], "]"}]}], 
        "}"}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "seriesOrder", ",", "10", ",", "\"\<Requested series order\>\""}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6", ",", "8", ",", "10", ",", "12", ",", "14"}], 
      "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialValue", ",", "1", ",", "\"\<y(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initialSlope", ",", "0", ",", "\"\<y'(0)\>\""}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"comparisonPoint", ",", "1", ",", "\"\<Comparison point\>\""}], 
      "}"}], ",", "0", ",", "2.5", ",", "0.25"}], "}"}]}], "]"}]}], "Input",
