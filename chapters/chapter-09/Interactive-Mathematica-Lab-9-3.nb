           Row[{"Absolute difference at x = ", $CellContext`comparisonPoint$$,
              ": ", 
             ScientificForm[
              N[$CellContext`errorAtPoint$], 5]}], 
           Plot[{$CellContext`seriesPolynomial$, 
             $CellContext`numericalSolution$[$CellContext`x]}, \
{$CellContext`x, -3, 3}, PlotRange -> All, 
            PlotLegends -> {"Series polynomial", "Numerical solution"}, 
            AxesLabel -> {"x", "y"}, GridLines -> Automatic, PlotLabel -> 
            "Local Series and Numerical Solution"]}]], 
      "Specifications" :> {{{$CellContext`seriesOrder$$, 10, 
          "Requested series order"}, {4, 6, 8, 10, 12, 
         14}}, {{$CellContext`initialValue$$, 1, "y(0)"}, -2, 2, 
