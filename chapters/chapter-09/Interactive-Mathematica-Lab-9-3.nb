        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`seriesSolution$, $CellContext`seriesPolynomial$, \
$CellContext`numericalSolution$, $CellContext`errorAtPoint$}, \
$CellContext`seriesSolution$ = 
         AsymptoticDSolveValue[{
           Derivative[
              2][$CellContext`y][$CellContext`x] + $CellContext`x \
$CellContext`y[$CellContext`x] == 
            0, $CellContext`y[0] == $CellContext`initialValue$$, 
            Derivative[1][$CellContext`y][0] == $CellContext`initialSlope$$}, 
           $CellContext`y[$CellContext`x], {$CellContext`x, 
            0, $CellContext`seriesOrder$$}]; $CellContext`seriesPolynomial$ = 
         Normal[$CellContext`seriesSolution$]; \
$CellContext`numericalSolution$ = 
         NDSolveValue[{
           Derivative[
              2][$CellContext`y][$CellContext`x] + $CellContext`x \
$CellContext`y[$CellContext`x] == 
            0, $CellContext`y[0] == $CellContext`initialValue$$, 
            Derivative[1][$CellContext`y][
             0] == $CellContext`initialSlope$$}, $CellContext`y, \
{$CellContext`x, -3, 3}]; $CellContext`errorAtPoint$ = 
         Abs[ReplaceAll[$CellContext`seriesPolynomial$, $CellContext`x -> \
$CellContext`comparisonPoint$$] - \
$CellContext`numericalSolution$[$CellContext`comparisonPoint$$]]; Column[{
           Style[
           "Interactive Mathematica Lab 9.3: Power-Series Solutions at \
Ordinary Points", 18, Bold], 
           Row[{"Requested series order: ", $CellContext`seriesOrder$$}], 
           Row[{"Series polynomial: ", 
