 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`comparisonPoint$$ = 
    1, $CellContext`initialSlope$$ = 0, $CellContext`initialValue$$ = 
    1, $CellContext`seriesOrder$$ = 10, Typeset`show$$ = True, 
