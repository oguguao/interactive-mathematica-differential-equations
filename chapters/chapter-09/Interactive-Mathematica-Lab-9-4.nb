Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`numberOfTerms$$ = 
    10, $CellContext`scaleParameter$$ = 3, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`scaleParameter$$], 3, "Series scale"}, {
      2 -> "2", 3 -> "3", 4 -> "4", 5 -> "5"}, ControlType -> SetterBar}, {{
       Hold[$CellContext`numberOfTerms$$], 10, "Partial-sum terms"}, {5, 10, 
      20, 40}, ControlType -> SetterBar}}, Typeset`size$$ = {
    663.064453125, {119.10574030342879`, 124.83767389717879`}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = True, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`numberOfTerms$$ = 
        10, $CellContext`scaleParameter$$ = 3}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`coefficientFunction$, $CellContext`radius$, \
$CellContext`leftEndpoint$, $CellContext`rightEndpoint$, \
$CellContext`leftEndpointTest$, $CellContext`rightEndpointTest$, \
$CellContext`closedForm$, $CellContext`partialSum$}, \
$CellContext`coefficientFunction$[
           Pattern[$CellContext`n$, 
            Blank[]]] := 
         1/($CellContext`n$ $CellContext`scaleParameter$$^$CellContext`n$); \
$CellContext`radius$ = FullSimplify[
           Limit[
            
            Abs[$CellContext`coefficientFunction$[$CellContext`n]/$\
CellContext`coefficientFunction$[$CellContext`n + 1]], $CellContext`n -> 
            Infinity]]; $CellContext`leftEndpoint$ = 
         1 - $CellContext`radius$; $CellContext`rightEndpoint$ = 
         1 + $CellContext`radius$; $CellContext`leftEndpointTest$ = 
         SumConvergence[(-1)^$CellContext`n/$CellContext`n, $CellContext`n]; \
$CellContext`rightEndpointTest$ = 
         SumConvergence[
          1/$CellContext`n, $CellContext`n]; $CellContext`closedForm$ = 
         FullSimplify[
           
           Sum[($CellContext`x - 
              1)^$CellContext`n/($CellContext`n \
$CellContext`scaleParameter$$^$CellContext`n), {$CellContext`n, 1, Infinity}],
            Abs[$CellContext`x - 
             1] < $CellContext`scaleParameter$$]; $CellContext`partialSum$ = 
         Sum[($CellContext`x - 
             1)^$CellContext`n/($CellContext`n \
$CellContext`scaleParameter$$^$CellContext`n), {$CellContext`n, 
            1, $CellContext`numberOfTerms$$}]; Column[{
           Style[
           "Interactive Mathematica Lab 9.4: Radius and Interval of \
Convergence", 18, Bold], 
           Row[{"Scale parameter: ", $CellContext`scaleParameter$$}], 
           Row[{"Radius: ", $CellContext`radius$}], 
           
           Row[{"Candidate interval: (", $CellContext`leftEndpoint$, 
             ", ", $CellContext`rightEndpoint$, ")"}], 
           Row[{"Left endpoint converges: ", $CellContext`leftEndpointTest$}], 
           
           Row[{"Right endpoint converges: ", \
$CellContext`rightEndpointTest$}], 
           Row[{"Closed form inside the radius: ", 
             TraditionalForm[$CellContext`closedForm$]}], 
           
           Plot[{$CellContext`closedForm$, $CellContext`partialSum$}, \
{$CellContext`x, 1 - 0.95 $CellContext`scaleParameter$$, 1 + 
             0.95 $CellContext`scaleParameter$$}, PlotRange -> All, 
            PlotLegends -> {"Infinite series / closed form", "Partial sum"}, 
            AxesLabel -> {"x", "Value"}, GridLines -> Automatic]}]], 
      "Specifications" :> {{{$CellContext`scaleParameter$$, 3, 
          "Series scale"}, {
         2 -> "2", 3 -> "3", 4 -> "4", 5 -> 
          "5"}}, {{$CellContext`numberOfTerms$$, 10, "Partial-sum terms"}, {5,
          10, 20, 40}}}, "Options" :> {}, "DefaultOptions" :> {}],
