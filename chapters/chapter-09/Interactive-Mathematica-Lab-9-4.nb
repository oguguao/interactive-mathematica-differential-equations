Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "coefficientFunction", ",", "radius", ",", "leftEndpoint", ",", 
       "rightEndpoint", ",", "leftEndpointTest", ",", "rightEndpointTest", ",",
        "closedForm", ",", "partialSum"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"coefficientFunction", "[", "n_", "]"}], ":=", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"n", " ", 
          RowBox[{"scaleParameter", "^", "n"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"radius", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"Limit", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"coefficientFunction", "[", "n", "]"}], "/", 
            RowBox[{"coefficientFunction", "[", 
             RowBox[{"n", "+", "1"}], "]"}]}], "]"}], ",", 
          RowBox[{"n", "->", "Infinity"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"leftEndpoint", "=", 
       RowBox[{"1", "-", "radius"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rightEndpoint", "=", 
       RowBox[{"1", "+", "radius"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"leftEndpointTest", "=", 
       RowBox[{"SumConvergence", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", "n"}], "/", "n"}], ",", "n"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rightEndpointTest", "=", 
       RowBox[{"SumConvergence", "[", 
        RowBox[{
         RowBox[{"1", "/", "n"}], ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"closedForm", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "-", "1"}], ")"}], "^", "n"}], "/", 
            RowBox[{"(", 
             RowBox[{"n", " ", 
              RowBox[{"scaleParameter", "^", "n"}]}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "Infinity"}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"x", "-", "1"}], "]"}], "<", "scaleParameter"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"partialSum", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "1"}], ")"}], "^", "n"}], "/", 
          RowBox[{"(", 
           RowBox[{"n", " ", 
            RowBox[{"scaleParameter", "^", "n"}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", "numberOfTerms"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Interactive Mathematica Lab 9.4: Radius and Interval \
of Convergence\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Scale parameter: \>\"", ",", "scaleParameter"}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Radius: \>\"", ",", "radius"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Candidate interval: (\>\"", ",", "leftEndpoint", 
            ",", "\"\<, \>\"", ",", "rightEndpoint", ",", "\"\<)\>\""}], 
           "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Left endpoint converges: \>\"", ",", 
            "leftEndpointTest"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Right endpoint converges: \>\"", ",", 
            "rightEndpointTest"}], "}"}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Closed form inside the radius: \>\"", ",", 
            RowBox[{"TraditionalForm", "[", "closedForm", "]"}]}], "}"}], 
          "]"}], ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"closedForm", ",", "partialSum"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"1", "-", 
              RowBox[{"0.95", " ", "scaleParameter"}]}], ",", 
             RowBox[{"1", "+", 
              RowBox[{"0.95", " ", "scaleParameter"}]}]}], "}"}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Infinite series / closed form\>\"", 
              ",", "\"\<Partial sum\>\""}], "}"}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<x\>\"", ",", "\"\<Value\>\""}], "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}], "}"}], 
       "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scaleParameter", ",", "3", ",", "\"\<Series scale\>\""}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "->", "\"\<2\>\""}], ",", 
       RowBox[{"3", "->", "\"\<3\>\""}], ",", 
       RowBox[{"4", "->", "\"\<4\>\""}], ",", 
       RowBox[{"5", "->", "\"\<5\>\""}]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"numberOfTerms", ",", "10", ",", "\"\<Partial-sum terms\>\""}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "10", ",", "20", ",", "40"}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9974809424542503`*^9, 3.9974809424542503`*^9}},
